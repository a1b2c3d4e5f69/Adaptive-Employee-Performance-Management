<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerReportController"
        stylesheets="@../../css/app.css,@../../css/manager.css"
        styleClass="manager-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="manager-topbar">

            <VBox spacing="2">

                <Label
                        text="AEPM"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="manager-page-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="MANAGER"
                        styleClass="manager-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="manager-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="manager-sidebar">


                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="manager-brand-title"/>

                        <Label
                                text="Manager Portal"
                                styleClass="manager-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                            text="WORKSPACE"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="manager-nav-button"/>


                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="manager-nav-button"/>


                    <Button
                            text="★   Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handlePerformance"
                            styleClass="manager-nav-button"/>


                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="manager-nav-button-active"/>


                    <!-- TEAM MANAGEMENT -->

                    <Label
                            text="TEAM MANAGEMENT"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="◷   Deadline Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleDeadlineEscalation"
                            styleClass="manager-nav-button"/>

                    <!-- ACCOUNT -->

                    <Label
                            text="ACCOUNT"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="manager-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="manager-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        maxWidth="Infinity"
                        styleClass="manager-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Performance Reports"
                                    styleClass="manager-page-title"/>

                            <Label
                                    text="Search, filter, and review employee performance records."
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>


                        <Button
                                text="Refresh"
                                onAction="#handleRefresh"
                                styleClass="manager-button"/>

                    </HBox>


                    <!-- =================================================
                         SUMMARY CARDS
                         ================================================= -->

                    <GridPane
                            hgap="14"
                            vgap="14"
                            maxWidth="Infinity">

                        <columnConstraints>

                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>

                        </columnConstraints>


                        <!-- TOTAL RECORDS -->

                        <VBox
                                GridPane.columnIndex="0"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="TOTAL RECORDS"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="totalRecordsLabel"
                                    text="0"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Performance records"
                                    styleClass="manager-kpi-note"/>

                        </VBox>


                        <!-- AVERAGE KPI -->

                        <VBox
                                GridPane.columnIndex="1"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="AVERAGE KPI"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="averageKpiLabel"
                                    text="0.00%"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Filtered average"
                                    styleClass="manager-kpi-note"/>

                        </VBox>


                        <!-- AT RISK -->

                        <VBox
                                GridPane.columnIndex="2"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="AT RISK"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="atRiskCountLabel"
                                    text="0"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="At-risk records"
                                    styleClass="manager-kpi-note"/>

                        </VBox>


                        <!-- NORMAL / GOOD -->

                        <VBox
                                GridPane.columnIndex="3"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="NORMAL / GOOD"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="normalGoodCountLabel"
                                    text="0"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Healthy performance"
                                    styleClass="manager-kpi-note"/>

                        </VBox>

                    </GridPane>


                    <!-- =================================================
                         FILTERS CARD
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="Report Filters"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Filter records by employee, department, status, or evaluation period."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <!-- ROW 1 -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search Staff ID, name or department..."
                                    prefWidth="330"
                                    styleClass="manager-input"/>


                            <ComboBox
                                    fx:id="departmentFilterComboBox"
                                    prefWidth="180"
                                    styleClass="manager-combo-box"/>


                            <ComboBox
                                    fx:id="statusFilterComboBox"
                                    prefWidth="160"
                                    styleClass="manager-combo-box"/>

                        </HBox>


                        <!-- ROW 2 -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <DatePicker
                                    fx:id="startDatePicker"
                                    promptText="Start date"
                                    prefWidth="180"
                                    styleClass="manager-date-picker"/>

                            <Label
                                    text="to"
                                    styleClass="manager-section-subtitle"/>

                            <DatePicker
                                    fx:id="endDatePicker"
                                    promptText="End date"
                                    prefWidth="180"
                                    styleClass="manager-date-picker"/>


                            <Button
                                    text="Clear Filters"
                                    onAction="#handleClearFilters"
                                    styleClass="manager-button"/>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         MESSAGE
                         ================================================= -->

                    <Label
                            fx:id="messageLabel"
                            visible="false"
                            managed="false"
                            wrapText="true"
                            styleClass="manager-helper-text"/>


                    <!-- =================================================
                         REPORT TABLE
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="Performance Records"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Select a row to view the performance summary."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <TableView
                                fx:id="reportTable"
                                prefHeight="350"
                                minHeight="320"
                                maxWidth="Infinity"
                                styleClass="manager-table">

                            <columns>

                                <TableColumn
                                        fx:id="employeeColumn"
                                        text="Employee"
                                        prefWidth="185"/>

                                <TableColumn
                                        fx:id="departmentColumn"
                                        text="Department"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="periodColumn"
                                        text="Evaluation Period"
                                        prefWidth="190"/>

                                <TableColumn
                                        fx:id="productivityColumn"
                                        text="Productivity"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="timelinessColumn"
                                        text="Timeliness"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="completionColumn"
                                        text="Completion"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="attendanceColumn"
                                        text="Attendance"
                                        prefWidth="100"/>

                                <TableColumn
                                        fx:id="overallColumn"
                                        text="Overall KPI"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="100"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <Region prefHeight="10"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>