<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerReportController"
        styleClass="main-layout">

    <!-- TOP BAR -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="16"
                styleClass="modern-topbar">

            <padding>
                <Insets top="14" right="30" bottom="14" left="30"/>
            </padding>

            <Label
                    text="AEPM"
                    styleClass="modern-brand"/>

            <Region
                    prefWidth="1"
                    minWidth="1"
                    maxWidth="1"
                    prefHeight="28"
                    styleClass="topbar-divider"/>

            <Label
                    text="Adaptive Employee Performance Management System"
                    styleClass="modern-system-name"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    spacing="2"
                    alignment="CENTER_RIGHT">

                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="modern-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="MANAGER"
                        styleClass="modern-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- SIDEBAR -->

    <left>

    <VBox
            prefWidth="275"
            minWidth="275"
            maxWidth="275"
            spacing="10"
            styleClass="sidebar">

        <padding>
            <Insets
                    top="28"
                    right="12"
                    bottom="20"
                    left="12"/>
        </padding>

        <VBox spacing="3">

            <Label
                    text="AEPM"
                    styleClass="sidebar-logo"/>

            <Label
                    text="Manager Portal"
                    styleClass="sidebar-subtitle"/>

        </VBox>

        <Region prefHeight="42"/>

        <Label
                text="MENU"
                styleClass="sidebar-section-title"/>

        <Region prefHeight="18"/>


        <Button
                text="⌂   Home"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                onAction="#handleHome"
                styleClass="sidebar-button"/>


        <Button
                text="●   My Profile"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                onAction="#handleProfile"
                styleClass="sidebar-button"/>


        <Button
                text="✓   Task Management"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                onAction="#handleTasks"
                styleClass="sidebar-button"/>


        <Button
                text="★   Performance"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                onAction="#handlePerformance"
                styleClass="sidebar-button"/>


        <Button
                text="≡   Reports"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                onAction="#handleReports"
                styleClass="sidebar-button-active"/>


        <Button
                text="▣   Dashboard"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                onAction="#handleDashboard"
                styleClass="sidebar-button"/>


        <Region VBox.vgrow="ALWAYS"/>


        <Button
                text="↪   Logout"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                onAction="#handleLogout"
                styleClass="logout-button"/>

    </VBox>

</left>


    <!-- CONTENT -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="modern-content-scroll">

            <content>

                <VBox
                        spacing="24"
                        maxWidth="Infinity"
                        styleClass="modern-content">

                    <padding>
                        <Insets top="30" right="32" bottom="40" left="32"/>
                    </padding>


                    <!-- PAGE HEADER -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="20">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Performance Reports"
                                    styleClass="modern-page-title"/>

                            <Label
                                    text="Search, filter, and review employee performance records."
                                    styleClass="modern-page-subtitle"/>

                        </VBox>

                        <Button
                                text="↻  Refresh"
                                onAction="#handleRefresh"
                                styleClass="modern-primary-button"/>

                    </HBox>

                    <HBox
                        spacing="18"
                        maxWidth="Infinity">


                    <VBox
                            spacing="8"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            styleClass="report-stat-card">

                        <padding>
                            <Insets top="20" right="22" bottom="20" left="22"/>
                        </padding>

                        <Label
                                text="Total Records"
                                styleClass="modern-card-label"/>

                        <Label
                                fx:id="totalRecordsLabel"
                                text="0"
                                styleClass="report-stat-value"/>

                        <Label
                                text="Performance records"
                                styleClass="modern-page-subtitle"/>

                    </VBox>


                    <VBox
                            spacing="8"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            styleClass="report-stat-card">

                        <padding>
                            <Insets top="20" right="22" bottom="20" left="22"/>
                        </padding>

                        <Label
                                text="Average KPI"
                                styleClass="modern-card-label"/>

                        <Label
                                fx:id="averageKpiLabel"
                                text="0.00%"
                                styleClass="report-stat-value"/>

                        <Label
                                text="Filtered average"
                                styleClass="modern-page-subtitle"/>

                    </VBox>


                    <VBox
                            spacing="8"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            styleClass="report-stat-card">

                        <padding>
                            <Insets top="20" right="22" bottom="20" left="22"/>
                        </padding>

                        <Label
                                text="At Risk"
                                styleClass="modern-card-label"/>

                        <Label
                                fx:id="atRiskCountLabel"
                                text="0"
                                styleClass="report-stat-value"/>

                        <Label
                                text="At-risk records"
                                styleClass="modern-page-subtitle"/>

                    </VBox>


                    <VBox
                            spacing="8"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            styleClass="report-stat-card">

                        <padding>
                            <Insets top="20" right="22" bottom="20" left="22"/>
                        </padding>

                        <Label
                                text="Normal / Good"
                                styleClass="modern-card-label"/>

                        <Label
                                fx:id="normalGoodCountLabel"
                                text="0"
                                styleClass="report-stat-value"/>

                        <Label
                                text="Healthy performance"
                                styleClass="modern-page-subtitle"/>

                    </VBox>

                </HBox>


                    <!-- FILTERS -->

                    <VBox
                            spacing="16"
                            styleClass="modern-card">

                        <padding>
                            <Insets top="22" right="22" bottom="22" left="22"/>
                        </padding>

                        <Label
                                text="Report Filters"
                                styleClass="modern-section-title"/>


                        <HBox
                                spacing="14"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search Staff ID, name or department..."
                                    prefWidth="330"/>

                            <ComboBox
                                    fx:id="departmentFilterComboBox"
                                    prefWidth="180"/>

                            <ComboBox
                                    fx:id="statusFilterComboBox"
                                    prefWidth="160"/>

                        </HBox>


                        <HBox
                                spacing="14"
                                alignment="CENTER_LEFT">

                            <DatePicker
                                    fx:id="startDatePicker"
                                    promptText="Start date"
                                    prefWidth="180"/>

                            <Label
                                    text="to"
                                    styleClass="modern-page-subtitle"/>

                            <DatePicker
                                    fx:id="endDatePicker"
                                    promptText="End date"
                                    prefWidth="180"/>

                            <Button
                                    text="Clear Filters"
                                    onAction="#handleClearFilters"
                                    styleClass="app-button"/>

                        </HBox>

                    </VBox>


                    <Label
                            fx:id="messageLabel"
                            visible="false"
                            managed="false"
                            wrapText="true"
                            styleClass="modern-message"/>


                    <!-- REPORT TABLE -->

                    <VBox
                            spacing="16"
                            styleClass="modern-card">

                        <padding>
                            <Insets top="22" right="22" bottom="22" left="22"/>
                        </padding>

                        <VBox spacing="4">

                            <Label
                                    text="Performance Records"
                                    styleClass="modern-section-title"/>

                            <Label
                                    text="Select a row to view the performance summary."
                                    styleClass="modern-page-subtitle"/>

                        </VBox>


                        <TableView
                                fx:id="reportTable"
                                prefHeight="350"
                                minHeight="320"
                                maxWidth="Infinity"
                                styleClass="modern-table">

                            <columns>

                                <TableColumn
                                        fx:id="employeeColumn"
                                        text="Employee"
                                        prefWidth="185"/>

                                <TableColumn
                                        fx:id="departmentColumn"
                                        text="Department"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="periodColumn"
                                        text="Evaluation Period"
                                        prefWidth="190"/>

                                <TableColumn
                                        fx:id="productivityColumn"
                                        text="Productivity"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="timelinessColumn"
                                        text="Timeliness"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="completionColumn"
                                        text="Completion"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="attendanceColumn"
                                        text="Attendance"
                                        prefWidth="100"/>

                                <TableColumn
                                        fx:id="overallColumn"
                                        text="Overall KPI"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="100"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <Region prefHeight="10"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>