<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        fx:id="pageRoot"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerTaskController"
        stylesheets="@../../css/app.css,@../../css/manager.css"
        styleClass="manager-root">

    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="manager-topbar">

            <VBox spacing="2">
                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="manager-page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">
                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="MANAGER"
                        styleClass="manager-topbar-user-role"/>
            </VBox>
        </HBox>
    </top>


    <left>
        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="manager-sidebar-scroll">

            <content>
                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="manager-sidebar">

                    <VBox spacing="2">
                        <Label
                                text="AEPM"
                                styleClass="manager-brand-title"/>

                        <Label
                                text="Manager Portal"
                                styleClass="manager-brand-secondary"/>
                    </VBox>

                    <Label
                            text="WORKSPACE"
                            styleClass="manager-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleDashboard"
                            styleClass="manager-nav-button"/>

                    <Button
                            fx:id="currentNavButton"
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="manager-nav-button-active"/>

                    <Button
                            text="★   Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handlePerformance"
                            styleClass="manager-nav-button"/>

                     <Button
                            fx:id="chatNavButton"
                            text="✉   Chat Center"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleChat"
                            styleClass="manager-nav-button"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="manager-nav-button"/>

                    <Label
                            text="TEAM MANAGEMENT"
                            styleClass="manager-sidebar-section"/>

                    <Button
                            text="◷   Deadline Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleDeadlineEscalation"
                            styleClass="manager-nav-button"/>

                    <Label
                            text="ACCOUNT"
                            styleClass="manager-sidebar-section"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="manager-nav-button"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>
                </VBox>
            </content>
        </ScrollPane>
    </left>


    <center>
        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="manager-content-scroll">

            <content>
                <VBox
                        spacing="22"
                        maxWidth="Infinity"
                        styleClass="manager-content">

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Task Management"
                                    styleClass="manager-page-title"/>

                            <Label
                                    text="Create, assign and monitor employee tasks."
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"/>
                        </VBox>

                        <HBox spacing="10">
                            <Button
                                    text="Refresh"
                                    onAction="#handleRefresh"
                                    styleClass="manager-button"/>

                            <Button
                                    text="+ Create Task"
                                    onAction="#handleCreateTask"
                                    styleClass="manager-button-primary"/>
                        </HBox>
                    </HBox>


                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">

                        <VBox spacing="4">
                            <Label
                                    text="All Tasks"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Search and filter tasks assigned to employees."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>
                        </VBox>

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search task name..."
                                    prefWidth="330"
                                    styleClass="manager-input"/>

                            <DatePicker
                                    fx:id="dueDateFilterPicker"
                                    promptText="Due date"
                                    prefWidth="180"
                                    styleClass="manager-date-picker"/>

                            <Button
                                    text="Clear Filters"
                                    onAction="#handleClearFilters"
                                    styleClass="manager-button"/>
                        </HBox>

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <ComboBox
                                    fx:id="employeeFilterComboBox"
                                    promptText="All Employees"
                                    prefWidth="220"
                                    styleClass="manager-combo-box"/>

                            <ComboBox
                                    fx:id="categoryFilterComboBox"
                                    promptText="All Categories"
                                    prefWidth="190"
                                    styleClass="manager-combo-box"/>

                            <ComboBox
                                    fx:id="statusFilterComboBox"
                                    promptText="All Status"
                                    prefWidth="180"
                                    styleClass="manager-combo-box"/>
                        </HBox>

                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="manager-helper-text"/>

                        <TableView
                                fx:id="taskTable"
                                prefHeight="430"
                                minHeight="390"
                                maxWidth="Infinity"
                                styleClass="manager-table">

                            <columns>
                                <TableColumn
                                        fx:id="titleColumn"
                                        text="Task"
                                        prefWidth="190"/>

                                <TableColumn
                                        fx:id="categoryColumn"
                                        text="Category"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="employeeColumn"
                                        text="Employee"
                                        prefWidth="260"/>

                                <TableColumn
                                        fx:id="priorityColumn"
                                        text="Priority"
                                        prefWidth="90"/>

                                <TableColumn
                                        fx:id="difficultyColumn"
                                        text="Difficulty"
                                        prefWidth="100"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="110"/>

                                <TableColumn
                                        fx:id="progressColumn"
                                        text="Progress"
                                        prefWidth="90"/>

                                <TableColumn
                                        fx:id="dueDateColumn"
                                        text="Due Date"
                                        prefWidth="160"/>
                            </columns>
                        </TableView>

                        <Label
                                text="Double-click a task to view details, assigned employees, edit or cancel it."
                                wrapText="true"
                                styleClass="manager-section-subtitle"/>
                    </VBox>


                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">

                        <VBox spacing="4">
                            <Label
                                    text="Progress History"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Review progress updates for the selected task."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>
                        </VBox>

                        <Label
                                fx:id="historyMessageLabel"
                                text="Select a task to view progress history."
                                wrapText="true"
                                styleClass="manager-helper-text"/>

                        <TableView
                                fx:id="historyTable"
                                prefHeight="230"
                                minHeight="210"
                                maxWidth="Infinity"
                                styleClass="manager-table">

                            <columns>
                                <TableColumn
                                        fx:id="historyProgressColumn"
                                        text="Progress"
                                        prefWidth="110"/>

                                <TableColumn
                                        fx:id="historyNoteColumn"
                                        text="Progress Note"
                                        prefWidth="620"/>

                                <TableColumn
                                        fx:id="historyDateColumn"
                                        text="Updated At"
                                        prefWidth="190"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <Region prefHeight="10"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
