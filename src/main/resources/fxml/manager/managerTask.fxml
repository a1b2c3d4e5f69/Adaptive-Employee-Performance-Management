<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerTaskController"
        stylesheets="@../../css/app.css,@../../css/manager.css"
        styleClass="manager-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="manager-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="manager-page-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="MANAGER"
                        styleClass="manager-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="manager-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="manager-sidebar">


                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="manager-brand-title"/>

                        <Label
                                text="Manager Portal"
                                styleClass="manager-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                            text="WORKSPACE"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="manager-nav-button"/>


                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="manager-nav-button-active"/>


                    <Button
                            text="★   Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handlePerformance"
                            styleClass="manager-nav-button"/>


                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="manager-nav-button"/>


                    <!-- TEAM MANAGEMENT -->

                    <Label
                            text="TEAM MANAGEMENT"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="◷   Deadline Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleDeadlineEscalation"
                            styleClass="manager-nav-button"/>

                    <!-- ACCOUNT -->

                    <Label
                            text="ACCOUNT"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="manager-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="manager-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        maxWidth="Infinity"
                        styleClass="manager-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Task Management"
                                    styleClass="manager-page-title"/>

                            <Label
                                    text="Create, assign and monitor employee tasks."
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>


                        <HBox spacing="10">

                            <Button
                                    text="Refresh"
                                    onAction="#handleRefresh"
                                    styleClass="manager-button"/>

                            <Button
                                    text="+ Create Task"
                                    onAction="#handleCreateTask"
                                    styleClass="manager-button-primary"/>

                        </HBox>

                    </HBox>


                    <!-- =================================================
                         ALL TASKS
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="All Tasks"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Search and filter tasks assigned to employees."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <!-- SEARCH ROW -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search task name..."
                                    prefWidth="280"
                                    styleClass="manager-input"/>


                            <DatePicker
                                    fx:id="dueDateFilterPicker"
                                    promptText="Due date"
                                    prefWidth="175"
                                    styleClass="manager-date-picker"/>


                            <Button
                                    text="Clear Filters"
                                    onAction="#handleClearFilters"
                                    styleClass="manager-button"/>

                        </HBox>


                        <!-- FILTER ROW -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <ComboBox
                                    fx:id="employeeFilterComboBox"
                                    promptText="All Employees"
                                    prefWidth="220"
                                    styleClass="manager-combo-box"/>


                            <ComboBox
                                    fx:id="categoryFilterComboBox"
                                    promptText="All Categories"
                                    prefWidth="180"
                                    styleClass="manager-combo-box"/>


                            <ComboBox
                                    fx:id="statusFilterComboBox"
                                    promptText="All Status"
                                    prefWidth="170"
                                    styleClass="manager-combo-box"/>

                        </HBox>


                        <!-- MESSAGE -->

                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="manager-helper-text"/>


                        <!-- TASK TABLE -->

                        <TableView
                                fx:id="taskTable"
                                prefHeight="350"
                                minHeight="300"
                                maxWidth="Infinity"
                                styleClass="manager-table">

                            <columns>

                                <TableColumn
                                        fx:id="titleColumn"
                                        text="Task"
                                        prefWidth="150"/>

                                <TableColumn
                                        fx:id="categoryColumn"
                                        text="Category"
                                        prefWidth="115"/>

                                <TableColumn
                                        fx:id="employeeColumn"
                                        text="Employee"
                                        prefWidth="155"/>

                                <TableColumn
                                        fx:id="priorityColumn"
                                        text="Priority"
                                        prefWidth="80"/>

                                <TableColumn
                                        fx:id="difficultyColumn"
                                        text="Difficulty"
                                        prefWidth="90"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="105"/>

                                <TableColumn
                                        fx:id="progressColumn"
                                        text="Progress"
                                        prefWidth="80"/>

                                <TableColumn
                                        fx:id="dueDateColumn"
                                        text="Due Date"
                                        prefWidth="145"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- =================================================
                         SELECTED TASK
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="12">

                            <VBox spacing="4" HBox.hgrow="ALWAYS">

                                <Label
                                        text="Selected Task"
                                        styleClass="manager-section-title"/>

                                <Label
                                        text="Review the selected task details before editing or cancelling it."
                                        wrapText="true"
                                        styleClass="manager-section-subtitle"/>

                            </VBox>


                            <HBox spacing="10">

                                <Button
                                        text="Edit Task"
                                        onAction="#handleEditTask"
                                        styleClass="manager-button"/>

                                <Button
                                        text="Cancel Task"
                                        onAction="#handleCancelTask"
                                        styleClass="manager-button"/>

                            </HBox>

                        </HBox>


                        <Region
                                prefHeight="1"
                                maxHeight="1"
                                style="-fx-background-color: #DCE7E4;"/>


                        <!-- DETAILS GRID -->

                        <GridPane
                                hgap="32"
                                vgap="16"
                                maxWidth="Infinity">

                            <columnConstraints>

                                <ColumnConstraints minWidth="100"/>

                                <ColumnConstraints
                                        prefWidth="280"
                                        hgrow="ALWAYS"/>

                                <ColumnConstraints minWidth="100"/>

                                <ColumnConstraints
                                        prefWidth="280"
                                        hgrow="ALWAYS"/>

                            </columnConstraints>


                            <!-- TASK -->

                            <Label
                                    text="Task"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="selectedTaskLabel"
                                    text="No task selected"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <!-- CATEGORY -->

                            <Label
                                    text="Category"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="selectedCategoryLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <!-- EMPLOYEE -->

                            <Label
                                    text="Employee"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="selectedEmployeeLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <!-- STATUS -->

                            <Label
                                    text="Status"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="selectedStatusLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <!-- PROGRESS -->

                            <Label
                                    text="Progress"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="selectedProgressLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>

                        </GridPane>

                    </VBox>


                    <!-- =================================================
                         PROGRESS HISTORY
                         ================================================= -->

                    <VBox
                            spacing="14"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="Progress History"
                                    styleClass="manager-section-title"/>

                            <Label
                                    fx:id="historyMessageLabel"
                                    text="Select a task to view progress history."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <TableView
                                fx:id="historyTable"
                                prefHeight="220"
                                minHeight="180"
                                maxWidth="Infinity"
                                styleClass="manager-table">

                            <columns>

                                <TableColumn
                                        fx:id="historyProgressColumn"
                                        text="Progress"
                                        prefWidth="100"/>

                                <TableColumn
                                        fx:id="historyNoteColumn"
                                        text="Progress Note"
                                        prefWidth="500"/>

                                <TableColumn
                                        fx:id="historyDateColumn"
                                        text="Updated At"
                                        prefWidth="190"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <Region prefHeight="10"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>