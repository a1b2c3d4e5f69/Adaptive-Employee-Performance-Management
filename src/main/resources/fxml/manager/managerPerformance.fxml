<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerPerformanceController"
        stylesheets="@../../css/app.css,@../../css/manager.css"
        styleClass="manager-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="manager-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="manager-page-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="MANAGER"
                        styleClass="manager-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="manager-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="manager-sidebar">


                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="manager-brand-title"/>

                        <Label
                                text="Manager Portal"
                                styleClass="manager-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                            text="WORKSPACE"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="⌂   Dashboard"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            onAction="#handleHome"
                            styleClass="manager-nav-button"/>


                    <Button
                            text="✓   Task Management"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            onAction="#handleTaskManagement"
                            styleClass="manager-nav-button"/>


                    <Button
                            text="★   Performance"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            onAction="#handlePerformance"
                            styleClass="manager-nav-button-active"/>


                    <Button
                            text="≡   Reports"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            onAction="#handleReports"
                            styleClass="manager-nav-button"/>


                    <!-- TEAM MANAGEMENT -->

                    <Label
                            text="TEAM MANAGEMENT"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="◷   Deadline Escalation"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            onAction="#handleDeadlineEscalation"
                            styleClass="manager-nav-button"/>

                    <!-- ACCOUNT -->

                    <Label
                            text="ACCOUNT"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="○   My Profile"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            onAction="#handleProfile"
                            styleClass="manager-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="manager-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        maxWidth="Infinity"
                        styleClass="manager-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox
                            fx:id="notificationTopBar"
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Employee Performance"
                                    styleClass="manager-page-title"/>

                            <Label
                                    text="Monitor employee KPI results, history, and provide performance feedback."
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>


                        <Button
                                text="Refresh"
                                onAction="#handleRefresh"
                                styleClass="manager-button"/>


                        <Button
                                fx:id="generateAiButton"
                                text="Generate AI Recommendations"
                                onAction="#handleGenerateAi"
                                styleClass="manager-button-primary"/>

                    </HBox>


                    <!-- =================================================
                         EMPLOYEE SELECTION
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="Select Employee"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Select an employee under your supervision to review performance."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <!-- SEARCH -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="employeeSearchField"
                                    promptText="Search employee by name or ID"
                                    prefWidth="280"
                                    styleClass="manager-input"/>

                            <ComboBox
                                    fx:id="departmentFilterComboBox"
                                    promptText="All Departments"
                                    prefWidth="200"
                                    styleClass="manager-combo-box"/>

                            <Button
                                    text="Clear"
                                    onAction="#handleClearEmployeeFilters"
                                    styleClass="manager-button"/>

                        </HBox>


                        <!-- EMPLOYEE -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <ComboBox
                                    fx:id="employeeComboBox"
                                    promptText="Select employee"
                                    prefWidth="360"
                                    styleClass="manager-combo-box"/>

                            <Button
                                    fx:id="aiHistoryButton"
                                    text="View AI Recommendation History"
                                    onAction="#handleAiHistory"
                                    styleClass="manager-button"/>

                        </HBox>


                        <Label
                                fx:id="employeeInfoLabel"
                                text="Loading employees..."
                                wrapText="true"
                                styleClass="manager-section-subtitle"/>

                    </VBox>


                    <!-- MESSAGE -->

                    <Label
                            fx:id="messageLabel"
                            visible="false"
                            managed="false"
                            wrapText="true"
                            styleClass="manager-helper-text"/>


                    <!-- =================================================
                         PERFORMANCE SUMMARY
                         ================================================= -->

                    <HBox
                            spacing="24"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <!-- KPI -->

                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="OVERALL KPI"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="overallKpiLabel"
                                    text="-"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    fx:id="performanceStatusLabel"
                                    text="-"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <Region
                                prefWidth="1"
                                minWidth="1"
                                maxWidth="1"
                                prefHeight="80"
                                style="-fx-background-color: #DCE7E4;"/>


                        <!-- PERIOD -->

                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="EVALUATION PERIOD"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="evaluationPeriodLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>


                        <Region
                                prefWidth="1"
                                minWidth="1"
                                maxWidth="1"
                                prefHeight="80"
                                style="-fx-background-color: #DCE7E4;"/>


                        <!-- CALCULATED -->

                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="CALCULATED AT"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="calculatedAtLabel"
                                    text="-"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>

                    </HBox>


                    <!-- =================================================
                         KPI BREAKDOWN
                         ================================================= -->

                    <VBox
                            spacing="18"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="KPI Breakdown"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Performance indicators used to calculate the employee's overall KPI."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <HBox
                                spacing="14"
                                maxWidth="Infinity">


                            <!-- PRODUCTIVITY -->

                            <VBox
                                    spacing="8"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="manager-kpi-card">

                                <Label
                                        text="PRODUCTIVITY"
                                        styleClass="manager-kpi-title"/>

                                <Label
                                        fx:id="productivityLabel"
                                        text="-"
                                        styleClass="manager-kpi-value"/>

                                <ProgressBar
                                        fx:id="productivityProgressBar"
                                        progress="0"
                                        maxWidth="Infinity"
                                        styleClass="metric-progress"/>

                            </VBox>


                            <!-- TIMELINESS -->

                            <VBox
                                    spacing="8"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="manager-kpi-card">

                                <Label
                                        text="TIMELINESS"
                                        styleClass="manager-kpi-title"/>

                                <Label
                                        fx:id="timelinessLabel"
                                        text="-"
                                        styleClass="manager-kpi-value"/>

                                <ProgressBar
                                        fx:id="timelinessProgressBar"
                                        progress="0"
                                        maxWidth="Infinity"
                                        styleClass="metric-progress"/>

                            </VBox>


                            <!-- COMPLETION -->

                            <VBox
                                    spacing="8"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="manager-kpi-card">

                                <Label
                                        text="COMPLETION RATE"
                                        styleClass="manager-kpi-title"/>

                                <Label
                                        fx:id="completionLabel"
                                        text="-"
                                        styleClass="manager-kpi-value"/>

                                <ProgressBar
                                        fx:id="completionProgressBar"
                                        progress="0"
                                        maxWidth="Infinity"
                                        styleClass="metric-progress"/>

                            </VBox>


                            <!-- ATTENDANCE -->

                            <VBox
                                    spacing="8"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="manager-kpi-card">

                                <Label
                                        text="ATTENDANCE"
                                        styleClass="manager-kpi-title"/>

                                <Label
                                        fx:id="attendanceLabel"
                                        text="-"
                                        styleClass="manager-kpi-value"/>

                                <ProgressBar
                                        fx:id="attendanceProgressBar"
                                        progress="0"
                                        maxWidth="Infinity"
                                        styleClass="metric-progress"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         PERFORMANCE HISTORY
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="Performance History"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Select an evaluation record to view it and provide feedback."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <!-- FILTER -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <Label
                                    text="Filter by Status"
                                    styleClass="manager-field-label"/>

                            <ComboBox
                                    fx:id="statusFilterComboBox"
                                    promptText="All Status"
                                    prefWidth="180"
                                    styleClass="manager-combo-box"/>

                            <Button
                                    text="Clear Filter"
                                    onAction="#handleClearPerformanceFilter"
                                    styleClass="manager-button"/>

                        </HBox>


                        <!-- HISTORY TABLE -->

                        <TableView
                                fx:id="historyTable"
                                prefHeight="270"
                                minHeight="240"
                                maxWidth="Infinity"
                                styleClass="manager-table">

                            <columns>

                                <TableColumn
                                        fx:id="periodColumn"
                                        text="Evaluation Period"
                                        prefWidth="210"/>

                                <TableColumn
                                        fx:id="productivityColumn"
                                        text="Productivity"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="timelinessColumn"
                                        text="Timeliness"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="completionColumn"
                                        text="Completion"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="attendanceColumn"
                                        text="Attendance"
                                        prefWidth="115"/>

                                <TableColumn
                                        fx:id="overallColumn"
                                        text="Overall KPI"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="110"/>

                                <TableColumn
                                        fx:id="calculatedColumn"
                                        text="Calculated At"
                                        prefWidth="165"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- =================================================
                         PERFORMANCE FEEDBACK
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="Performance Feedback"
                                    styleClass="manager-section-title"/>

                            <Label
                                    fx:id="selectedResultLabel"
                                    text="Select a performance record to provide feedback."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <!-- EXISTING FEEDBACK -->

                        <VBox
                                spacing="6"
                                style="
                                    -fx-background-color: #F4F8F7;
                                    -fx-background-radius: 8;
                                    -fx-border-color: #DCE7E4;
                                    -fx-border-radius: 8;
                                    -fx-padding: 14;
                                ">

                            <Label
                                    text="Existing Feedback"
                                    styleClass="manager-field-label"/>

                            <Label
                                    fx:id="existingFeedbackLabel"
                                    text="No feedback selected."
                                    wrapText="true"
                                    maxWidth="Infinity"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>


                        <!-- NEW FEEDBACK -->

                        <VBox spacing="7">

                            <Label
                                    text="Manager Feedback"
                                    styleClass="manager-field-label"/>

                            <TextArea
                                    fx:id="feedbackTextArea"
                                    promptText="Write constructive performance feedback..."
                                    prefRowCount="5"
                                    wrapText="true"
                                    maxWidth="Infinity"
                                    styleClass="manager-text-area"/>

                        </VBox>


                        <HBox alignment="CENTER_RIGHT">

                            <Button
                                    fx:id="submitFeedbackButton"
                                    text="Submit Feedback"
                                    onAction="#handleSubmitFeedback"
                                    styleClass="manager-button-primary"/>

                        </HBox>

                    </VBox>


                    <Region prefHeight="10"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>