<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerReportDetailController"
        stylesheets="@../../css/app.css,@../../css/manager.css"
        prefWidth="720"
        spacing="0"
        style="
            -fx-background-color: #F4F8F7;
            -fx-font-family: 'Plus Jakarta Sans';
        ">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <HBox
            alignment="CENTER_LEFT"
            spacing="12"
            style="
                -fx-background-color: #FFFFFF;
                -fx-border-color: transparent transparent #DCE7E4 transparent;
                -fx-border-width: 0 0 1 0;
                -fx-padding: 18 22;
            ">


        <VBox
                spacing="4"
                HBox.hgrow="ALWAYS">

            <Label
                    text="Performance Summary"
                    styleClass="manager-section-title"/>

            <Label
                    fx:id="employeeHeaderLabel"
                    text="Employee"
                    wrapText="true"
                    styleClass="manager-section-subtitle"/>

        </VBox>


        <Button
                text="×"
                onAction="#handleClose"
                style="
                    -fx-background-color: #F4F8F7;
                    -fx-text-fill: #0F766E;
                    -fx-border-color: #DCE7E4;
                    -fx-border-width: 1;
                    -fx-background-radius: 8;
                    -fx-border-radius: 8;
                    -fx-min-width: 36;
                    -fx-min-height: 36;
                    -fx-max-width: 36;
                    -fx-max-height: 36;
                    -fx-font-size: 18px;
                    -fx-font-weight: 600;
                    -fx-cursor: hand;
                "/>

    </HBox>


    <!-- =====================================================
         CONTENT
         ===================================================== -->

    <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            prefHeight="610"
            styleClass="manager-content-scroll">

        <content>

            <VBox
                    spacing="18"
                    style="
                        -fx-background-color: #F4F8F7;
                        -fx-padding: 22 24 24 24;
                    ">


                <!-- =================================================
                     PERFORMANCE INFORMATION
                     ================================================= -->

                <VBox
                        spacing="18"
                        maxWidth="Infinity"
                        styleClass="manager-card">


                    <VBox spacing="4">

                        <Label
                                text="Performance Information"
                                styleClass="manager-section-title"/>

                        <Label
                                text="Employee performance result and evaluation details."
                                styleClass="manager-section-subtitle"/>

                    </VBox>


                    <!-- ROW 1 -->

                    <HBox
                            spacing="35"
                            maxWidth="Infinity">


                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Employee"
                                    styleClass="manager-field-label"/>

                            <Label
                                    fx:id="employeeLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>


                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Department"
                                    styleClass="manager-field-label"/>

                            <Label
                                    fx:id="departmentLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>

                    </HBox>


                    <!-- ROW 2 -->

                    <HBox
                            spacing="35"
                            maxWidth="Infinity">


                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Evaluation Period"
                                    styleClass="manager-field-label"/>

                            <Label
                                    fx:id="periodLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>


                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Overall KPI"
                                    styleClass="manager-field-label"/>

                            <Label
                                    fx:id="overallLabel"
                                    text="-"
                                    styleClass="manager-kpi-value"/>

                        </VBox>


                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Status"
                                    styleClass="manager-field-label"/>

                            <Label
                                    fx:id="statusLabel"
                                    text="-"
                                    style="
                                        -fx-background-color: #DFF4F1;
                                        -fx-text-fill: #0F766E;
                                        -fx-font-size: 11px;
                                        -fx-font-weight: 600;
                                        -fx-padding: 5 10;
                                        -fx-background-radius: 20;
                                    "/>

                        </VBox>

                    </HBox>

                </VBox>


                <!-- =================================================
                     KPI BREAKDOWN
                     ================================================= -->

                <VBox
                        spacing="17"
                        maxWidth="Infinity"
                        styleClass="manager-card">


                    <VBox spacing="4">

                        <Label
                                text="KPI Breakdown"
                                styleClass="manager-section-title"/>

                        <Label
                                text="Performance indicators used in the KPI evaluation."
                                styleClass="manager-section-subtitle"/>

                    </VBox>


                    <!-- PRODUCTIVITY -->

                    <VBox spacing="8">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                    text="Productivity"
                                    styleClass="manager-field-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="productivityLabel"
                                    text="-"
                                    styleClass="manager-page-subtitle"/>

                        </HBox>

                        <ProgressBar
                                fx:id="productivityProgressBar"
                                progress="0"
                                maxWidth="Infinity"
                                styleClass="metric-progress"/>

                    </VBox>


                    <!-- TIMELINESS -->

                    <VBox spacing="8">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                    text="Timeliness"
                                    styleClass="manager-field-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="timelinessLabel"
                                    text="-"
                                    styleClass="manager-page-subtitle"/>

                        </HBox>

                        <ProgressBar
                                fx:id="timelinessProgressBar"
                                progress="0"
                                maxWidth="Infinity"
                                styleClass="metric-progress"/>

                    </VBox>


                    <!-- COMPLETION -->

                    <VBox spacing="8">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                    text="Completion Rate"
                                    styleClass="manager-field-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="completionLabel"
                                    text="-"
                                    styleClass="manager-page-subtitle"/>

                        </HBox>

                        <ProgressBar
                                fx:id="completionProgressBar"
                                progress="0"
                                maxWidth="Infinity"
                                styleClass="metric-progress"/>

                    </VBox>


                    <!-- ATTENDANCE -->

                    <VBox spacing="8">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                    text="Attendance"
                                    styleClass="manager-field-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="attendanceLabel"
                                    text="-"
                                    styleClass="manager-page-subtitle"/>

                        </HBox>

                        <ProgressBar
                                fx:id="attendanceProgressBar"
                                progress="0"
                                maxWidth="Infinity"
                                styleClass="metric-progress"/>

                    </VBox>

                </VBox>


                <!-- =================================================
                     MANAGER FEEDBACK
                     ================================================= -->

                <VBox
                        spacing="14"
                        maxWidth="Infinity"
                        styleClass="manager-card">


                    <VBox spacing="4">

                        <Label
                                text="Manager Feedback"
                                styleClass="manager-section-title"/>

                        <Label
                                text="Feedback recorded for this performance evaluation."
                                styleClass="manager-section-subtitle"/>

                    </VBox>


                    <VBox
                            spacing="7"
                            style="
                                -fx-background-color: #F4F8F7;
                                -fx-border-color: #DCE7E4;
                                -fx-border-width: 1;
                                -fx-background-radius: 8;
                                -fx-border-radius: 8;
                                -fx-padding: 14;
                            ">

                        <Label
                                fx:id="feedbackLabel"
                                text="Loading feedback..."
                                wrapText="true"
                                maxWidth="Infinity"
                                styleClass="manager-page-subtitle"/>

                        <Label
                                fx:id="feedbackDateLabel"
                                text=""
                                wrapText="true"
                                styleClass="manager-helper-text"/>

                    </VBox>

                </VBox>


                <Region prefHeight="4"/>

            </VBox>

        </content>

    </ScrollPane>

</VBox>