<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.shape.Circle?>

<?import com.aepm.ui.components.NotificationBell?>
<?import com.aepm.ui.components.DashboardAttentionPanel?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerHomeController"
        stylesheets="@../../css/app.css,@../../css/manager.css"
        styleClass="manager-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="manager-topbar">


            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="manager-page-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <NotificationBell
                    fx:id="notificationBell"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="MANAGER"
                        styleClass="manager-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="manager-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="manager-sidebar">


                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="manager-brand-title"/>

                        <Label
                                text="Manager Portal"
                                styleClass="manager-brand-secondary"/>

                    </VBox>


                    <!-- =================================================
                         WORKSPACE
                         ================================================= -->

                    <Label
                            text="WORKSPACE"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="manager-nav-button-active"/>


                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="manager-nav-button"/>


                    <Button
                            text="★   Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handlePerformance"
                            styleClass="manager-nav-button"/>


                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="manager-nav-button"/>


                    <!-- =================================================
                         TEAM MANAGEMENT
                         ================================================= -->

                    <Label
                            text="TEAM MANAGEMENT"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="◷   Deadline Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleDeadlineEscalation"
                            styleClass="manager-nav-button"/>

                    <!-- =================================================
                         ACCOUNT
                         ================================================= -->

                    <Label
                            text="ACCOUNT"
                            styleClass="manager-sidebar-section"/>


                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="manager-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="manager-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        maxWidth="Infinity"
                        styleClass="manager-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Manager Dashboard"
                                    styleClass="manager-page-title"/>

                            <Label
                                    text="Monitor your team, task progress, KPI performance and active escalations."
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"/>

                        </VBox>


                        <Button
                                text="⟳  Refresh"
                                onAction="#handleRefreshDashboard"
                                styleClass="manager-button"/>

                    </HBox>


                    <!-- =================================================
                         DASHBOARD STATUS
                         ================================================= -->
                    <GridPane
                        hgap="14"
                        vgap="14"
                        maxWidth="Infinity">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>


                    <!-- DEPARTMENT -->

                    <VBox
                            GridPane.columnIndex="0"
                            spacing="6"
                            maxWidth="Infinity"
                            styleClass="manager-kpi-card">

                        <Label
                                text="DEPARTMENT"
                                styleClass="manager-kpi-title"/>

                        <Label
                                fx:id="departmentLabel"
                                text="-"
                                styleClass="manager-kpi-value"/>

                        <Label
                                text="Your assigned department"
                                styleClass="manager-kpi-note"/>

                    </VBox>


                    <!-- ROLE -->

                    <VBox
                            GridPane.columnIndex="1"
                            spacing="6"
                            maxWidth="Infinity"
                            styleClass="manager-kpi-card">

                        <Label
                                text="ROLE"
                                styleClass="manager-kpi-title"/>

                        <Label
                                fx:id="roleLabel"
                                text="Manager"
                                styleClass="manager-kpi-value"/>

                        <Label
                                text="Manager system access"
                                styleClass="manager-kpi-note"/>

                    </VBox>

                </GridPane>
                    <Label
                            fx:id="dashboardStatusLabel"
                            text="Loading team dashboard..."
                            wrapText="true"
                            styleClass="manager-helper-text"/>


                    <!-- =================================================
                         PRIMARY KPI ROW
                         ================================================= -->

                    <GridPane
                            hgap="14"
                            vgap="14"
                            maxWidth="Infinity">

                        <columnConstraints>

                            <ColumnConstraints
                                    percentWidth="25"/>

                            <ColumnConstraints
                                    percentWidth="25"/>

                            <ColumnConstraints
                                    percentWidth="25"/>

                            <ColumnConstraints
                                    percentWidth="25"/>

                        </columnConstraints>


                        <!-- TEAM MEMBERS -->

                        <VBox
                                GridPane.columnIndex="0"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="TEAM MEMBERS"
                                    wrapText="true"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="teamMembersLabel"
                                    text="—"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Employees in your team"
                                    wrapText="true"
                                    styleClass="manager-kpi-note"/>

                        </VBox>


                        <!-- IN PROGRESS -->

                        <VBox
                                GridPane.columnIndex="1"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="IN PROGRESS"
                                    wrapText="true"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="inProgressCountLabel"
                                    text="—"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Tasks currently being worked on"
                                    wrapText="true"
                                    styleClass="manager-kpi-note"/>

                        </VBox>


                        <!-- TOTAL TASK -->

                        <VBox
                                GridPane.columnIndex="2"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="TOTAL TEAM TASKS"
                                    wrapText="true"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="taskCountLabel"
                                    text="—"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Tasks assigned to your team"
                                    wrapText="true"
                                    styleClass="manager-kpi-note"/>

                        </VBox>


                        <!-- OVERDUE -->

                        <VBox
                                GridPane.columnIndex="3"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="OVERDUE TASKS"
                                    wrapText="true"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="overdueCountLabel"
                                    text="—"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Tasks past their deadline"
                                    wrapText="true"
                                    styleClass="manager-kpi-note"/>

                        </VBox>

                    </GridPane>


                    <!-- =================================================
                         SECOND KPI ROW
                         ================================================= -->

                    <GridPane
                            hgap="14"
                            vgap="14"
                            maxWidth="Infinity">

                        <columnConstraints>

                            <ColumnConstraints
                                    percentWidth="33.333"/>

                            <ColumnConstraints
                                    percentWidth="33.333"/>

                            <ColumnConstraints
                                    percentWidth="33.334"/>

                        </columnConstraints>


                        <!-- COMPLETED -->

                        <VBox
                                GridPane.columnIndex="0"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="COMPLETED TASKS"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="completedCountLabel"
                                    text="—"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Successfully finished tasks"
                                    wrapText="true"
                                    styleClass="manager-kpi-note"/>

                        </VBox>


                        <!-- ESCALATION -->

                        <VBox
                                GridPane.columnIndex="1"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="ACTIVE ESCALATIONS"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="escalationCountLabel"
                                    text="—"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Escalations requiring attention"
                                    wrapText="true"
                                    styleClass="manager-kpi-note"/>

                        </VBox>


                        <!-- COMPLETION -->

                        <VBox
                                GridPane.columnIndex="2"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="manager-kpi-card">

                            <Label
                                    text="TASK COMPLETION RATE"
                                    styleClass="manager-kpi-title"/>

                            <Label
                                    fx:id="completionRateLabel"
                                    text="—"
                                    styleClass="manager-kpi-value"/>

                            <Label
                                    text="Team task completion rate"
                                    wrapText="true"
                                    styleClass="manager-kpi-note"/>

                        </VBox>

                    </GridPane>


                    <!-- =================================================
                         TEAM PERFORMANCE SUMMARY
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="Team Performance Summary"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Overview of task workload and latest KPI performance."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <GridPane
                                hgap="14"
                                vgap="14">

                            <columnConstraints>

                                <ColumnConstraints
                                        percentWidth="25"/>

                                <ColumnConstraints
                                        percentWidth="25"/>

                                <ColumnConstraints
                                        percentWidth="25"/>

                                <ColumnConstraints
                                        percentWidth="25"/>

                            </columnConstraints>


                            <!-- PENDING -->

                            <VBox
                                    GridPane.columnIndex="0"
                                    spacing="6"
                                    maxWidth="Infinity"
                                    styleClass="manager-kpi-card">

                                <Label
                                        text="PENDING TASKS"
                                        styleClass="manager-kpi-title"/>

                                <Label
                                        fx:id="pendingCountLabel"
                                        text="—"
                                        styleClass="manager-kpi-value"/>

                                <Label
                                        text="Pending team tasks"
                                        wrapText="true"
                                        styleClass="manager-kpi-note"/>

                            </VBox>


                            <!-- KPI -->

                            <VBox
                                    GridPane.columnIndex="1"
                                    spacing="6"
                                    maxWidth="Infinity"
                                    styleClass="manager-kpi-card">

                                <Label
                                        text="TEAM AVERAGE KPI"
                                        styleClass="manager-kpi-title"/>

                                <Label
                                        fx:id="averageKpiLabel"
                                        text="—"
                                        styleClass="manager-kpi-value"/>

                                <Label
                                        text="Average latest KPI result"
                                        wrapText="true"
                                        styleClass="manager-kpi-note"/>

                            </VBox>


                            <!-- EVALUATED -->

                            <VBox
                                    GridPane.columnIndex="2"
                                    spacing="6"
                                    maxWidth="Infinity"
                                    styleClass="manager-kpi-card">

                                <Label
                                        text="EVALUATED EMPLOYEES"
                                        styleClass="manager-kpi-title"/>

                                <Label
                                        fx:id="evaluatedCountLabel"
                                        text="—"
                                        styleClass="manager-kpi-value"/>

                                <Label
                                        text="Employees with KPI results"
                                        wrapText="true"
                                        styleClass="manager-kpi-note"/>

                            </VBox>


                            <!-- HIGH RISK -->

                            <VBox
                                    GridPane.columnIndex="3"
                                    spacing="6"
                                    maxWidth="Infinity"
                                    styleClass="manager-kpi-card">

                                <Label
                                        text="HIGH-RISK EMPLOYEES"
                                        styleClass="manager-kpi-title"/>

                                <Label
                                        fx:id="atRiskCountLabel"
                                        text="—"
                                        styleClass="manager-kpi-value"/>

                                <Label
                                        text="Employees currently at risk"
                                        wrapText="true"
                                        styleClass="manager-kpi-note"/>

                            </VBox>

                        </GridPane>

                    </VBox>


                    <!-- =================================================
                         ACTIVE ESCALATION SUMMARY
                         ================================================= -->

                    <VBox
                            spacing="14"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <VBox spacing="4">

                            <Label
                                    text="Active Deadline Escalation Summary"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Review the latest escalation activity affecting your team."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <Label
                                fx:id="escalationDetailsLabel"
                                text="Loading escalation details..."
                                wrapText="true"
                                styleClass="manager-page-subtitle"/>


                        <HBox alignment="CENTER_RIGHT">

                            <Button
                                    text="View Deadline Escalations"
                                    onAction="#handleDeadlineEscalation"
                                    styleClass="manager-button-primary"/>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         CHARTS
                         ================================================= -->

                    <GridPane
                            hgap="16"
                            vgap="16">

                        <columnConstraints>

                            <ColumnConstraints
                                    percentWidth="55"/>

                            <ColumnConstraints
                                    percentWidth="45"/>

                        </columnConstraints>


                        <!-- TASK STATUS -->

                        <VBox
                                GridPane.columnIndex="0"
                                spacing="16"
                                minWidth="0"
                                maxWidth="Infinity"
                                styleClass="manager-card">

                            <Label
                                    text="Task Status Overview"
                                    styleClass="manager-section-title"/>


                            <BarChart
                                    fx:id="taskStatusChart"
                                    animated="false"
                                    legendVisible="false"
                                    prefHeight="300"
                                    minWidth="0"
                                    styleClass="modern-chart">

                                <xAxis>

                                    <CategoryAxis
                                            label="Status"/>

                                </xAxis>

                                <yAxis>

                                    <NumberAxis
                                            label="Tasks"
                                            forceZeroInRange="true"
                                            tickUnit="1"/>

                                </yAxis>

                            </BarChart>

                        </VBox>


                        <!-- ESCALATION LEVEL -->

                        <VBox
                                GridPane.columnIndex="1"
                                spacing="16"
                                minWidth="0"
                                maxWidth="Infinity"
                                styleClass="manager-card">

                            <Label
                                    text="Escalations by Level"
                                    styleClass="manager-section-title"/>


                            <StackPane
                                    alignment="CENTER"
                                    prefHeight="300"
                                    minWidth="0">

                                <PieChart
                                        fx:id="escalationChart"
                                        animated="false"
                                        labelsVisible="false"
                                        legendVisible="false"
                                        prefHeight="280"
                                        minWidth="0"/>


                                <Circle
                                        radius="51"
                                        fill="WHITE"
                                        mouseTransparent="true"/>


                                <VBox
                                        alignment="CENTER"
                                        spacing="2"
                                        mouseTransparent="true">

                                    <Label
                                            fx:id="donutTotalLabel"
                                            text="—"
                                            styleClass="manager-kpi-value"/>

                                    <Label
                                            text="Total Active"
                                            styleClass="manager-kpi-note"/>

                                </VBox>

                            </StackPane>


                            <HBox
                                alignment="CENTER"
                                spacing="18">

                                <HBox spacing="6" alignment="CENTER">
                                    <Label text="●"
                                            styleClass="level-legend-1"/>
                                    <Label text="Level 1"
                                            styleClass="chart-legend-text"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER">
                                    <Label text="●"
                                            styleClass="level-legend-2"/>
                                    <Label text="Level 2"
                                            styleClass="chart-legend-text"/>
                                </HBox>

                                <HBox spacing="6" alignment="CENTER">
                                    <Label text="●"
                                            styleClass="level-legend-3"/>
                                    <Label text="Level 3"
                                            styleClass="chart-legend-text"/>
                                </HBox>

                            </HBox>

                        </VBox>

                    </GridPane>


                    <!-- =================================================
                         MODULE OVERVIEW
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="manager-card">

                        <VBox spacing="4">

                            <Label
                                    text="Quick Access"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Access the main management areas of AEPM."
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <GridPane
                                hgap="12"
                                vgap="12">

                            <columnConstraints>

                                <ColumnConstraints
                                        percentWidth="33.333"/>

                                <ColumnConstraints
                                        percentWidth="33.333"/>

                                <ColumnConstraints
                                        percentWidth="33.334"/>

                            </columnConstraints>


                            <Button
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"
                                    text="✓  Task Management"
                                    onAction="#handleTaskManagement"
                                    maxWidth="Infinity"
                                    styleClass="manager-button"/>


                            <Button
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"
                                    text="◷  Deadline Escalation"
                                    onAction="#handleDeadlineEscalation"
                                    maxWidth="Infinity"
                                    styleClass="manager-button"/>


                            <Button
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"
                                    text="★  Performance"
                                    onAction="#handlePerformance"
                                    maxWidth="Infinity"
                                    styleClass="manager-button"/>


                            <Button
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"
                                    text="○  My Profile"
                                    onAction="#handleProfile"
                                    maxWidth="Infinity"
                                    styleClass="manager-button"/>


                            <Button
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"
                                    text="≡  Reports"
                                    onAction="#handleReports"
                                    maxWidth="Infinity"
                                    styleClass="manager-button"/>

                        </GridPane>

                    </VBox>


                    <!-- =================================================
                         ATTENTION PANEL
                         KEEP EXISTING COMPONENT
                         ================================================= -->

                    <DashboardAttentionPanel
                            fx:id="attentionPanel"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>