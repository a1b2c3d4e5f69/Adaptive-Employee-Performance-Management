<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.image.ImageView?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.shape.Circle?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerProfileController"
        stylesheets="@../../css/app.css,@../../css/manager.css"
        styleClass="manager-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="manager-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="manager-page-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="manager-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="MANAGER"
                        styleClass="manager-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="manager-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="manager-sidebar">


                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="manager-brand-title"/>

                        <Label
                                text="Manager Portal"
                                styleClass="manager-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                                text="WORKSPACE"
                                styleClass="manager-sidebar-section"/>

                        <Button
                                text="⌂   Dashboard"
                                maxWidth="Infinity"
                                alignment="CENTER_LEFT"
                                onAction="#handleHome"
                                styleClass="manager-nav-button"/>

                        <Button
                                text="✓   Task Management"
                                maxWidth="Infinity"
                                alignment="CENTER_LEFT"
                                onAction="#handleTaskManagement"
                                styleClass="manager-nav-button"/>

                        <Button
                                text="★   Performance"
                                maxWidth="Infinity"
                                alignment="CENTER_LEFT"
                                onAction="#handlePerformance"
                                styleClass="manager-nav-button"/>

                        <Button
                                text="≡   Reports"
                                maxWidth="Infinity"
                                alignment="CENTER_LEFT"
                                onAction="#handleReports"
                                styleClass="manager-nav-button"/>


                        <Label
                                text="TEAM MANAGEMENT"
                                styleClass="manager-sidebar-section"/>

                        <Button
                                text="◷   Deadline Escalation"
                                maxWidth="Infinity"
                                alignment="CENTER_LEFT"
                                onAction="#handleDeadlineEscalation"
                                styleClass="manager-nav-button"/>


                        <Label
                                text="ACCOUNT"
                                styleClass="manager-sidebar-section"/>

                        <Button
                                text="○   My Profile"
                                maxWidth="Infinity"
                                alignment="CENTER_LEFT"
                                onAction="#handleProfile"
                                styleClass="manager-nav-button-active"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         PROFILE CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="manager-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        maxWidth="Infinity"
                        styleClass="manager-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <VBox spacing="5">

                        <Label
                                text="My Profile"
                                styleClass="manager-page-title"/>

                        <Label
                                text="View and update your personal information."
                                wrapText="true"
                                styleClass="manager-page-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         PROFILE CARD
                         ================================================= -->

                    <VBox
                            spacing="22"
                            maxWidth="Infinity"
                            styleClass="manager-card">


                        <!-- PROFILE HEADER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="24">


                            <!-- AVATAR -->

                            <StackPane
                                    prefWidth="104"
                                    prefHeight="104"
                                    minWidth="104"
                                    minHeight="104"
                                    maxWidth="104"
                                    maxHeight="104">


                                <Circle
                                        radius="46"
                                        style="
                                            -fx-fill: #DFF4F1;
                                            -fx-stroke: #C9DAD6;
                                            -fx-stroke-width: 1;
                                        "/>


                                <Label
                                        fx:id="profileInitialLabel"
                                        text="M"
                                        style="
                                            -fx-font-size: 28px;
                                            -fx-font-weight: bold;
                                            -fx-text-fill: #0F766E;
                                        "/>


                                <ImageView
                                        fx:id="profileImageView"
                                        fitWidth="92"
                                        fitHeight="92"
                                        preserveRatio="false"
                                        smooth="true"
                                        visible="false">

                                    <clip>

                                        <Circle
                                                centerX="46"
                                                centerY="46"
                                                radius="46"/>

                                    </clip>

                                </ImageView>


                                <Button
                                        fx:id="editImageButton"
                                        text="✎"
                                        onAction="#handleChangeProfileImage"
                                        StackPane.alignment="BOTTOM_RIGHT"
                                        style="
                                            -fx-background-color: #0F766E;
                                            -fx-text-fill: white;
                                            -fx-background-radius: 20;
                                            -fx-min-width: 32;
                                            -fx-min-height: 32;
                                            -fx-max-width: 32;
                                            -fx-max-height: 32;
                                            -fx-font-size: 12px;
                                            -fx-cursor: hand;
                                        "/>

                            </StackPane>


                            <!-- PROFILE INFO -->

                            <VBox
                                    spacing="6"
                                    alignment="CENTER_LEFT"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        fx:id="fullNameLabel"
                                        text="Manager"
                                        styleClass="manager-section-title"/>

                                <Label
                                        text="Manager"
                                        style="
                                            -fx-background-color: #DFF4F1;
                                            -fx-text-fill: #0F766E;
                                            -fx-font-size: 11px;
                                            -fx-font-weight: 600;
                                            -fx-padding: 5 10;
                                            -fx-background-radius: 20;
                                        "/>

                                <Label
                                        text="Click the edit icon to change your profile image."
                                        wrapText="true"
                                        styleClass="manager-section-subtitle"/>

                            </VBox>

                        </HBox>


                        <!-- DIVIDER -->

                        <Region
                                prefHeight="1"
                                maxHeight="1"
                                style="-fx-background-color: #DCE7E4;"/>


                        <!-- =================================================
                             PERSONAL INFORMATION
                             ================================================= -->

                        <VBox spacing="4">

                            <Label
                                    text="Personal Information"
                                    styleClass="manager-section-title"/>

                            <Label
                                    text="Review your employment details and update your contact number when needed."
                                    wrapText="true"
                                    styleClass="manager-section-subtitle"/>

                        </VBox>


                        <!-- INFORMATION GRID -->

                        <GridPane
                                hgap="36"
                                vgap="20"
                                maxWidth="Infinity">

                            <columnConstraints>

                                <ColumnConstraints
                                        minWidth="130"/>

                                <ColumnConstraints
                                        prefWidth="280"
                                        hgrow="ALWAYS"/>

                                <ColumnConstraints
                                        minWidth="130"/>

                                <ColumnConstraints
                                        prefWidth="280"
                                        hgrow="ALWAYS"/>

                            </columnConstraints>


                            <!-- STAFF ID -->

                            <Label
                                    text="Staff ID"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="employeeIdLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <!-- USERNAME -->

                            <Label
                                    text="Username"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="usernameLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <!-- EMAIL -->

                            <Label
                                    text="Email"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="emailLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <!-- DEPARTMENT -->

                            <Label
                                    text="Department"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="departmentLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <!-- ROLE -->

                            <Label
                                    text="Role"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="roleLabel"
                                    text="Manager"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <!-- STATUS -->

                            <Label
                                    text="Account Status"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="accountStatusLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="manager-page-subtitle"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>


                            <!-- CONTACT -->

                            <Label
                                    text="Contact Number"
                                    styleClass="manager-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"/>

                            <TextField
                                    fx:id="contactNumberField"
                                    promptText="Enter contact number"
                                    prefWidth="260"
                                    maxWidth="320"
                                    styleClass="manager-input"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>

                        </GridPane>


                        <!-- =================================================
                             MESSAGE
                             ================================================= -->

                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="manager-helper-text"/>


                        <!-- =================================================
                             ACTIONS
                             ================================================= -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <Button
                                    fx:id="saveButton"
                                    text="Save Changes"
                                    onAction="#handleSave"
                                    styleClass="manager-button-primary"/>

                            <Button
                                    text="Change Password"
                                    onAction="#handleChangePassword"
                                    styleClass="manager-button"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>