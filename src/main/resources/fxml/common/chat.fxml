<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.common.chat.ChatController"
        stylesheets="@../../css/chat.css"
        styleClass="chat-root">
<center>
        <HBox
                spacing="0"
                maxWidth="Infinity"
                maxHeight="Infinity"
                styleClass="chat-shell">

            <!-- =====================================================
                 LEFT: CONVERSATIONS
                 ===================================================== -->
            <VBox
                    prefWidth="300"
                    minWidth="270"
                    maxWidth="330"
                    spacing="12"
                    styleClass="chat-left-panel">

                <HBox spacing="6">
                    <Button
                            fx:id="allFilterButton"
                            text="All"
                            onAction="#handleFilterAll"
                            styleClass="chat-filter-button-active"/>

                    <Button
                            fx:id="privateFilterButton"
                            text="Private"
                            onAction="#handleFilterPrivate"
                            styleClass="chat-filter-button"/>

                    <Button
                            fx:id="teamFilterButton"
                            text="Team"
                            onAction="#handleFilterTeam"
                            styleClass="chat-filter-button"/>
                </HBox>

                <TextField
                        fx:id="searchField"
                        promptText="Search conversations..."
                        styleClass="chat-search-field"/>

                <HBox spacing="8">
                    <Button
                            text="+ New Chat"
                            onAction="#handleNewPrivateChat"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="chat-secondary-button"/>

                    <Button
                            fx:id="newTeamButton"
                            text="+ Team"
                            onAction="#handleNewTeamChat"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="chat-primary-button"/>
                </HBox>

                <ListView
                        fx:id="conversationListView"
                        VBox.vgrow="ALWAYS"
                        styleClass="chat-conversation-list"/>

                <Label
                        fx:id="conversationStatusLabel"
                        text=""
                        visible="false"
                        managed="false"
                        wrapText="true"
                        styleClass="chat-helper-label"/>
            </VBox>

            <Separator orientation="VERTICAL"/>

            <!-- =====================================================
                 CENTER: ACTIVE CHAT
                 ===================================================== -->
            <VBox
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity"
                    spacing="0"
                    styleClass="chat-main-panel">

                <HBox
                        fx:id="chatHeader"
                        alignment="CENTER_LEFT"
                        spacing="12"
                        styleClass="chat-active-header">

                    <StackPane
                            minWidth="44"
                            minHeight="44"
                            prefWidth="44"
                            prefHeight="44"
                            maxWidth="44"
                            maxHeight="44"
                            styleClass="chat-avatar">
                        <Label
                                fx:id="activeChatInitialLabel"
                                text="C"
                                styleClass="chat-avatar-text"/>
                    </StackPane>

                    <VBox spacing="2">
                        <Label
                                fx:id="activeChatNameLabel"
                                text="Select a conversation"
                                styleClass="chat-active-title"/>

                        <Label
                                fx:id="activeChatMetaLabel"
                                text="Choose a private or team chat to begin."
                                styleClass="chat-active-meta"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button
                            fx:id="viewMembersButton"
                            text="View Members"
                            onAction="#handleViewMembers"
                            disable="true"
                            styleClass="chat-header-button"/>

                    <Button
                            fx:id="sharedFilesButton"
                            text="Shared Files"
                            onAction="#handleShowSharedFiles"
                            disable="true"
                            styleClass="chat-header-button"/>
                </HBox>

                <ScrollPane
                        fx:id="messageScrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        styleClass="chat-message-scroll">

                    <content>
                        <VBox
                                fx:id="messageContainer"
                                spacing="10"
                                maxWidth="Infinity"
                                styleClass="chat-message-container">

                            <VBox
                                    fx:id="emptyConversationBox"
                                    alignment="CENTER"
                                    spacing="10"
                                    VBox.vgrow="ALWAYS"
                                    styleClass="chat-empty-box">
                                <Label text="◯" styleClass="chat-empty-icon"/>
                                <Label
                                        text="Select a conversation"
                                        styleClass="chat-empty-title"/>
                                <Label
                                        text="Your messages and attachments will appear here."
                                        styleClass="chat-empty-subtitle"/>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>

                <VBox
                        fx:id="composerBox"
                        spacing="8"
                        styleClass="chat-composer"
                        disable="true">

                    <TextArea
                            fx:id="messageTextArea"
                            promptText="Type a message..."
                            wrapText="true"
                            prefRowCount="2"
                            styleClass="chat-message-input"/>

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="8">

                        <Button
                                fx:id="attachButton"
                                text="Attach File"
                                onAction="#handleAttachFile"
                                styleClass="chat-attach-button"/>

                        <Label
                                fx:id="selectedFileLabel"
                                text=""
                                visible="false"
                                managed="false"
                                maxWidth="360"
                                styleClass="chat-selected-file-label"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button
                                fx:id="sendButton"
                                text="Send"
                                onAction="#handleSend"
                                styleClass="chat-send-button"/>
                    </HBox>
                </VBox>
            </VBox>

            
        </HBox>
    </center>
</BorderPane>
