<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminUserManagementController"
        styleClass="profile-page">


    <!-- TOP -->

    <top>

        <VBox spacing="18">

            <padding>

                <Insets
                        top="30"
                        right="35"
                        bottom="10"
                        left="35"/>

            </padding>


            <HBox
                    alignment="CENTER_LEFT"
                    spacing="15">

                <VBox spacing="4">

                    <Label
                            text="User Management"
                            styleClass="content-title"/>

                    <Label
                            text="View and manage system user accounts."
                            styleClass="content-description"/>

                </VBox>


                <Region HBox.hgrow="ALWAYS"/>


                <Button
                        text="Back"
                        onAction="#handleBack"
                        styleClass="secondary-button"/>

            </HBox>


            <HBox
                    alignment="CENTER_LEFT"
                    spacing="12">

                <TextField
                        fx:id="searchField"
                        promptText="Search users..."
                        prefWidth="300"/>


                <ComboBox
                        fx:id="filterRoleComboBox"
                        prefWidth="160"/>


                <Button
                        text="Refresh"
                        onAction="#loadUsers"
                        styleClass="secondary-button"/>


                <Region HBox.hgrow="ALWAYS"/>


                <Button
                        text="+ Create User"
                        onAction="#handleCreateUser"
                        styleClass="button-primary"/>

            </HBox>

        </VBox>

    </top>


    <!-- CENTER -->

    <center>

        <VBox spacing="20">

            <padding>

                <Insets
                        top="15"
                        right="35"
                        bottom="35"
                        left="35"/>

            </padding>


            <!-- USER LIST -->

            <VBox
                    spacing="10"
                    styleClass="profile-card">

                <Label
                        text="User List"
                        styleClass="section-title"/>


                <!--
                    IMPORTANT:
                    NO columnResizePolicy here.
                    We configure it in Java.
                -->

                <TableView
                        fx:id="userTable"
                        prefHeight="300">

                    <columns>

                        <TableColumn
                                fx:id="employeeIdColumn"
                                text="Staff ID"
                                prefWidth="100"/>

                        <TableColumn
                                fx:id="nameColumn"
                                text="Full Name"
                                prefWidth="150"/>

                        <TableColumn
                                fx:id="usernameColumn"
                                text="Username"
                                prefWidth="120"/>

                        <TableColumn
                                fx:id="emailColumn"
                                text="Email"
                                prefWidth="200"/>

                        <TableColumn
                                fx:id="departmentColumn"
                                text="Department"
                                prefWidth="130"/>

                        <TableColumn
                                fx:id="roleColumn"
                                text="Role"
                                prefWidth="120"/>

                        <TableColumn
                                fx:id="statusColumn"
                                text="Status"
                                prefWidth="100"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- SELECTED USER -->

            <VBox
                    spacing="18"
                    styleClass="profile-card">

                <Label
                        text="Selected User Details"
                        styleClass="section-title"/>


                <GridPane
                        hgap="20"
                        vgap="15">


                    <Label
                            text="Staff ID"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <TextField
                            fx:id="employeeIdField"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>


                    <Label
                            text="Full Name"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0"/>

                    <TextField
                            fx:id="fullNameField"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0"/>


                    <Label
                            text="Username"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <TextField
                            fx:id="usernameField"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>


                    <Label
                            text="Email"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="1"/>

                    <TextField
                            fx:id="emailField"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"/>


                    <Label
                            text="Contact Number"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                    <TextField
                            fx:id="contactNumberField"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>


                    <Label
                            text="Department"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="2"/>

                    <TextField
                            fx:id="departmentField"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="2"/>


                    <Label
                            text="Role"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                    <ComboBox
                            fx:id="roleComboBox"
                            prefWidth="200"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                </GridPane>


                <Label
                        fx:id="messageLabel"
                        visible="false"
                        managed="false"
                        wrapText="true"/>


                <HBox spacing="12">

                    <Button
                            fx:id="saveButton"
                            text="Save Changes"
                            onAction="#handleSave"
                            styleClass="button-primary"/>


                    <Button
                            fx:id="statusButton"
                            text="Deactivate Account"
                            onAction="#handleToggleStatus"
                            styleClass="secondary-button"/>


                    <Button
                            fx:id="deleteButton"
                            text="Delete User"
                            onAction="#handleDeleteUser"
                            styleClass="secondary-button"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>