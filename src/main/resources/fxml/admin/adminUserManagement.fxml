<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminUserManagementController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">


                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                            text="WORKSPACE"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button-active"/>

                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button"/>


                    <!-- OPERATIONS -->

                    <Label
                            text="OPERATIONS"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button"/>


                    <!-- SYSTEM -->

                    <Label
                            text="SYSTEM"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✦   AI Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAIConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        styleClass="admin-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <VBox spacing="5">

                        <Label
                                text="User Management"
                                styleClass="admin-page-title"/>

                        <Label
                                text="View, create and manage system user accounts."
                                styleClass="admin-page-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         USER LIST
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="12">

                            <VBox
                                    spacing="4"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="User List"
                                        styleClass="admin-section-title"/>

                                <Label
                                        text="Search and manage registered Employee and Manager accounts."
                                        styleClass="admin-section-subtitle"/>

                            </VBox>


                            <Button
                                    text="+ Create User"
                                    onAction="#handleCreateUser"
                                    styleClass="admin-button-primary"/>

                        </HBox>


                        <!-- SEARCH / FILTER -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search users..."
                                    prefWidth="320"
                                    styleClass="admin-input"/>

                            <ComboBox
                                    fx:id="roleFilterComboBox"
                                    prefWidth="180"
                                    promptText="All"
                                    styleClass="admin-combo-box"/>

                            <Button
                                    text="Refresh"
                                    onAction="#loadUsers"
                                    styleClass="admin-button"/>

                        </HBox>


                        <!-- MESSAGE -->

                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="admin-helper-text"/>


                        <!-- USER TABLE -->

                        <TableView
                                fx:id="userTable"
                                prefHeight="300"
                                minHeight="260"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="employeeIdColumn"
                                        text="Staff ID"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="nameColumn"
                                        text="Full Name"
                                        prefWidth="160"/>

                                <TableColumn
                                        fx:id="usernameColumn"
                                        text="Username"
                                        prefWidth="130"/>

                                <TableColumn
                                        fx:id="emailColumn"
                                        text="Email"
                                        prefWidth="220"/>

                                <TableColumn
                                        fx:id="departmentColumn"
                                        text="Department"
                                        prefWidth="145"/>

                                <TableColumn
                                        fx:id="roleColumn"
                                        text="Role"
                                        prefWidth="130"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="110"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- =================================================
                         SELECTED USER DETAILS
                         ================================================= -->

                    <VBox
                            spacing="18"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <VBox spacing="4">

                            <Label
                                    text="Selected User Details"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Select a user from the table to review or update their account information."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <!-- FORM -->

                        <GridPane
                                hgap="28"
                                vgap="16">


                            <!-- ROW 1 -->

                            <Label
                                    text="Staff ID"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="employeeIdField"
                                    editable="false"
                                    prefWidth="250"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Full Name"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="fullNameField"
                                    prefWidth="250"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <!-- ROW 2 -->

                            <Label
                                    text="Username"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <TextField
                                    fx:id="usernameField"
                                    prefWidth="250"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Email"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <TextField
                                    fx:id="emailField"
                                    editable="false"
                                    prefWidth="250"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <!-- ROW 3 -->

                            <Label
                                    text="Contact Number"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <TextField
                                    fx:id="contactNumberField"
                                    prefWidth="250"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Department"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <TextField
                                    fx:id="departmentField"
                                    prefWidth="250"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>


                            <!-- ROW 4 -->

                            <Label
                                    text="Role"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"/>

                            <ComboBox
                                    fx:id="roleComboBox"
                                    prefWidth="250"
                                    styleClass="admin-combo-box"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>

                        </GridPane>


                        <!-- ACTIONS -->

                        <HBox spacing="10">

                            <Button
                                    fx:id="saveButton"
                                    text="Save Changes"
                                    onAction="#handleSave"
                                    styleClass="admin-button-primary"/>

                            <Button
                                    fx:id="statusButton"
                                    text="Deactivate Account"
                                    onAction="#handleToggleStatus"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="deleteButton"
                                    text="Delete User"
                                    onAction="#handleDeleteUser"
                                    styleClass="admin-button-danger"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>