<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminUserManagementController"
        styleClass="main-layout">


    <!-- TOP BAR -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>


            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- SIDEBAR -->

    <left>
        
        <ScrollPane
        prefWidth="294"
        minWidth="294"
        maxWidth="294"
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        style="-fx-background-color: white; -fx-background: white;">

                <VBox
                        prefWidth="240"
                        spacing="10"
                        styleClass="sidebar">

                <padding>
                        <Insets
                                top="30"
                                right="18"
                                bottom="20"
                                left="18"/>
                </padding>


                <VBox spacing="3">

                        <Label
                                text="AEPM"
                                styleClass="sidebar-logo"/>

                        <Label
                                text="Administrator Portal"
                                styleClass="sidebar-subtitle"/>

                </VBox>


                <Region prefHeight="18"/>


                <Label
                        text="MENU"
                        styleClass="sidebar-section-title"/>


                <Button
                        text="⌂   Home"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleHome"
                        styleClass="sidebar-button"/>

                <Button
                        text="●   My Profile"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleProfile"
                        styleClass="sidebar-button"/>

                <Button
                        text="♟   User Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleUserManagement"
                        styleClass="sidebar-button-active"/>

                <Button
                        text="✓   Task Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleTaskManagement"
                        styleClass="sidebar-button"/>
                <Button
                        text="◷   Escalation Rules"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleEscalationRules"
                        styleClass="sidebar-button"/>

                <Button
                        text="★   KPI Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleKpiManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="⚙   System Configuration"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleSystemConfiguration"
                        styleClass="sidebar-button"/>
                <Button
                    text="✉   Notification/Announcements"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleAnnouncements"
                    styleClass="sidebar-button"/>                        
                <Button
                        text="✦   AI Recommendation"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAIConfiguration"
                        styleClass="sidebar-button"/>

                <Button
                        text="▦   Attendance Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAttendanceManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="≡   Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleReports"
                        styleClass="sidebar-button"/>

                <Button
                        text="!   Anonymous Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAnonymousReports"
                        styleClass="sidebar-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button
                        text="↪   Logout"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleLogout"
                        styleClass="logout-button"/>

                </VBox>
        </ScrollPane>
    </left>


    <!-- CONTENT -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="content-scroll-pane">

            <content>

                <VBox
                        spacing="22"
                        styleClass="home-content">

                    <padding>
                        <Insets
                                top="32"
                                right="35"
                                bottom="40"
                                left="35"/>
                    </padding>


                    <!-- TITLE -->

                    <VBox spacing="4">

                        <Label
                                text="User Management"
                                styleClass="content-title"/>

                        <Label
                                text="View and manage system user accounts."
                                styleClass="content-description"/>

                    </VBox>


                    <!-- USER LIST -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">

                        <Label
                                text="User List"
                                styleClass="section-title"/>


                        <!-- SEARCH INSIDE USER LIST -->

                        <HBox
                                spacing="12"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search users..."
                                    prefWidth="320"/>


                            <ComboBox
                                    fx:id="roleFilterComboBox"
                                    prefWidth="180"
                                    promptText="All"/>


                            <Button
                                    text="Refresh"
                                    onAction="#loadUsers"
                                    styleClass="app-button"/>


                            <Region HBox.hgrow="ALWAYS"/>


                            <Button
                                    text="+ Create User"
                                    onAction="#handleCreateUser"
                                    styleClass="app-button"/>

                        </HBox>


                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"/>


                        <TableView
                                fx:id="userTable"
                                prefHeight="260"
                                minHeight="240">

                            <columns>

                                <TableColumn
                                        fx:id="employeeIdColumn"
                                        text="Staff ID"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="nameColumn"
                                        text="Full Name"
                                        prefWidth="160"/>

                                <TableColumn
                                        fx:id="usernameColumn"
                                        text="Username"
                                        prefWidth="130"/>

                                <TableColumn
                                        fx:id="emailColumn"
                                        text="Email"
                                        prefWidth="220"/>

                                <TableColumn
                                        fx:id="departmentColumn"
                                        text="Department"
                                        prefWidth="145"/>

                                <TableColumn
                                        fx:id="roleColumn"
                                        text="Role"
                                        prefWidth="130"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="110"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- SELECTED USER -->

                    <VBox
                            spacing="18"
                            styleClass="section-card">

                        <Label
                                text="Selected User Details"
                                styleClass="section-title"/>


                        <GridPane
                                hgap="28"
                                vgap="16">


                            <!-- ROW 1 -->

                            <Label
                                    text="Staff ID"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="employeeIdField"
                                    editable="false"
                                    prefWidth="250"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Full Name"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="fullNameField"
                                    prefWidth="250"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <!-- ROW 2 -->

                            <Label
                                    text="Username"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <TextField
                                    fx:id="usernameField"
                                    prefWidth="250"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Email"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <TextField
                                    fx:id="emailField"
                                    editable="false"
                                    prefWidth="250"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <!-- ROW 3 -->

                            <Label
                                    text="Contact Number"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <TextField
                                    fx:id="contactNumberField"
                                    prefWidth="250"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Department"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <TextField
                                    fx:id="departmentField"
                                    prefWidth="250"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>


                            <!-- ROW 4 -->

                            <Label
                                    text="Role"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"/>

                            <ComboBox
                                    fx:id="roleComboBox"
                                    prefWidth="250"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>

                        </GridPane>


                        <!-- ACTION BUTTONS -->

                        <HBox spacing="12">

                            <Button
                                    fx:id="saveButton"
                                    text="Save Changes"
                                    onAction="#handleSave"
                                    styleClass="app-button"/>


                            <Button
                                    fx:id="statusButton"
                                    text="Deactivate Account"
                                    onAction="#handleToggleStatus"
                                    styleClass="app-button"/>


                            <Button
                                    fx:id="deleteButton"
                                    text="Delete User"
                                    onAction="#handleDeleteUser"
                                    styleClass="app-button"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>