<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminTaskCategoryController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">


                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                            text="WORKSPACE"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button-active"/>

                    <Button
                            text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button"/>


                    <!-- OPERATIONS -->

                    <Label
                            text="OPERATIONS"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button"/>


                    <!-- SYSTEM -->

                    <Label
                            text="SYSTEM"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        styleClass="admin-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Task Category Management"
                                    styleClass="admin-page-title"/>

                            <Label
                                    text="Create and manage task categories used by managers."
                                    styleClass="admin-page-subtitle"/>

                        </VBox>

                        <Button
                                text="Back"
                                onAction="#handleBack"
                                styleClass="admin-button"/>

                    </HBox>


                    <!-- =================================================
                         CATEGORY LIST
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="12">

                            <VBox
                                    spacing="4"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="Category List"
                                        styleClass="admin-section-title"/>

                                <Label
                                        text="View and manage task categories available in the system."
                                        styleClass="admin-section-subtitle"/>

                            </VBox>

                            <Button
                                    text="+ New Category"
                                    onAction="#handleNewCategory"
                                    styleClass="admin-button-primary"/>

                        </HBox>


                        <!-- SEARCH -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search categories..."
                                    prefWidth="320"
                                    styleClass="admin-input"/>

                            <Button
                                    text="Refresh"
                                    onAction="#loadCategories"
                                    styleClass="admin-button"/>

                        </HBox>


                        <!-- TABLE -->

                        <TableView
                                fx:id="categoryTable"
                                prefHeight="300"
                                minHeight="260"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="idColumn"
                                        text="ID"
                                        prefWidth="70"/>

                                <TableColumn
                                        fx:id="nameColumn"
                                        text="Category Name"
                                        prefWidth="200"/>

                                <TableColumn
                                        fx:id="descriptionColumn"
                                        text="Description"
                                        prefWidth="450"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="130"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- =================================================
                         CATEGORY DETAILS
                         ================================================= -->

                    <VBox
                            spacing="18"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <VBox spacing="4">

                            <Label
                                    text="Category Details"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Create a new category or update the selected category."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <!-- FORM -->

                        <GridPane
                                hgap="28"
                                vgap="18">


                            <!-- CATEGORY NAME -->

                            <Label
                                    text="Category Name"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="categoryNameField"
                                    promptText="Enter category name"
                                    prefWidth="320"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <!-- STATUS -->

                            <Label
                                    text="Status"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <ComboBox
                                    fx:id="statusComboBox"
                                    prefWidth="200"
                                    styleClass="admin-combo-box"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>

                        </GridPane>


                        <!-- DESCRIPTION -->

                        <VBox spacing="6">

                            <Label
                                    text="Description"
                                    styleClass="admin-field-label"/>

                            <TextArea
                                    fx:id="descriptionArea"
                                    promptText="Enter category description..."
                                    prefRowCount="4"
                                    wrapText="true"
                                    styleClass="admin-text-area"/>

                        </VBox>


                        <!-- MESSAGE -->

                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="admin-helper-text"/>


                        <!-- ACTION BUTTONS -->

                        <HBox spacing="10">

                            <Button
                                    fx:id="createButton"
                                    text="Create Category"
                                    onAction="#handleCreateCategory"
                                    styleClass="admin-button-primary"/>

                            <Button
                                    fx:id="saveButton"
                                    text="Save Changes"
                                    onAction="#handleSaveChanges"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="statusButton"
                                    text="Deactivate"
                                    onAction="#handleToggleStatus"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="deleteButton"
                                    text="Delete Category"
                                    onAction="#handleDeleteCategory"
                                    styleClass="admin-button-danger"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>