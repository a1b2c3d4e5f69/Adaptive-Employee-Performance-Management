<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminCreateUserController"
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        stylesheets="@../../css/app.css"
        styleClass="admin-content-scroll">

    <content>

        <VBox
                spacing="22"
                maxWidth="Infinity"
                styleClass="admin-content">


            <!-- =====================================================
                 PAGE HEADER
                 ===================================================== -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="16">

                <VBox
                        spacing="5"
                        HBox.hgrow="ALWAYS">

                    <Label
                            text="Create User"
                            styleClass="admin-page-title"/>

                    <Label
                            text="Create a new Employee or Manager account and assign their organisational information."
                            wrapText="true"
                            styleClass="admin-page-subtitle"/>

                </VBox>


                <Button
                        text="Back"
                        onAction="#handleBack"
                        styleClass="admin-button"/>

            </HBox>


            <!-- =====================================================
                 CENTERED ACCOUNT CARD
                 ===================================================== -->

            <HBox
                    alignment="TOP_CENTER"
                    maxWidth="Infinity">

                <VBox
                        prefWidth="900"
                        maxWidth="900"
                        spacing="20"
                        styleClass="admin-card">


                    <!-- =================================================
                         CARD HEADER
                         ================================================= -->

                    <VBox spacing="4">

                        <Label
                                text="Account Information"
                                styleClass="admin-section-title"/>

                        <Label
                                text="Enter the user's identity, department, role and login credentials."
                                wrapText="true"
                                styleClass="admin-section-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         FORM
                         ================================================= -->

                    <GridPane
                            hgap="30"
                            vgap="18">

                        <columnConstraints>

                            <ColumnConstraints
                                    minWidth="150"/>

                            <ColumnConstraints
                                    prefWidth="600"
                                    hgrow="ALWAYS"/>

                        </columnConstraints>


                        <!-- FULL NAME -->

                        <Label
                                text="Full Name"
                                styleClass="admin-field-label"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0"/>

                        <TextField
                                fx:id="fullNameField"
                                promptText="Enter full name"
                                maxWidth="Infinity"
                                styleClass="admin-input"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0"/>


                        <!-- STAFF ID -->

                        <Label
                                text="Staff ID"
                                styleClass="admin-field-label"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1"/>

                        <TextField
                                fx:id="employeeIdField"
                                promptText="EMP001 / MGR001"
                                maxWidth="Infinity"
                                styleClass="admin-input"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1"/>


                        <!-- DEPARTMENT -->

                        <Label
                                text="Department"
                                styleClass="admin-field-label"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="2"/>

                        <TextField
                                fx:id="departmentField"
                                promptText="Enter department"
                                maxWidth="Infinity"
                                styleClass="admin-input"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="2"/>


                        <!-- USERNAME -->

                        <Label
                                text="Username"
                                styleClass="admin-field-label"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="3"/>

                        <TextField
                                fx:id="usernameField"
                                promptText="Enter username"
                                maxWidth="Infinity"
                                styleClass="admin-input"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="3"/>


                        <!-- EMAIL -->

                        <Label
                                text="Email"
                                styleClass="admin-field-label"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="4"/>

                        <TextField
                                fx:id="emailField"
                                promptText="Enter email address"
                                maxWidth="Infinity"
                                styleClass="admin-input"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="4"/>


                        <!-- ROLE -->

                        <Label
                                text="Role"
                                styleClass="admin-field-label"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="5"/>

                        <ComboBox
                                fx:id="roleComboBox"
                                maxWidth="Infinity"
                                styleClass="admin-combo-box"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="5"/>


                        <!-- PASSWORD -->

                        <Label
                                text="Password"
                                styleClass="admin-field-label"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="6"/>

                        <PasswordField
                                fx:id="passwordField"
                                promptText="Enter password"
                                maxWidth="Infinity"
                                styleClass="admin-input"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="6"/>


                        <!-- CONFIRM PASSWORD -->

                        <Label
                                text="Confirm Password"
                                styleClass="admin-field-label"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="7"/>

                        <PasswordField
                                fx:id="confirmPasswordField"
                                promptText="Enter password again"
                                maxWidth="Infinity"
                                styleClass="admin-input"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="7"/>

                    </GridPane>


                    <!-- =================================================
                         MESSAGE
                         ================================================= -->

                    <Label
                            fx:id="messageLabel"
                            visible="false"
                            managed="false"
                            wrapText="true"
                            styleClass="admin-helper-text"/>


                    <!-- =================================================
                         ACTION BUTTONS
                         ================================================= -->

                    <HBox
                            spacing="10"
                            alignment="CENTER_LEFT">

                        <Button
                                fx:id="createButton"
                                text="Create User"
                                onAction="#handleCreateUser"
                                styleClass="admin-button-primary"/>

                        <Button
                                text="Cancel"
                                onAction="#handleBack"
                                styleClass="admin-button"/>

                    </HBox>

                </VBox>

            </HBox>

        </VBox>

    </content>

</ScrollPane>