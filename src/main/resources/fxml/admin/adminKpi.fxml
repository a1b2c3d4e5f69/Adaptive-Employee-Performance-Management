<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminKpiController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- TOP BAR -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- SIDEBAR -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <Label
                            text="WORKSPACE"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button-active"/>


                    <Label
                            text="OPERATIONS"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button"/>


                    <Label
                            text="SYSTEM"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✦   AI Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAIConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>

                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- CONTENT -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        styleClass="admin-content">


                    <!-- HEADER -->

                    <VBox spacing="5">

                        <Label
                                text="KPI Management"
                                styleClass="admin-page-title"/>

                        <Label
                                text="Configure KPI scoring rules, component weightings and calculate employee performance."
                                styleClass="admin-page-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         CONFIGURATION LIST
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">

                        <HBox
                                alignment="CENTER_LEFT">

                            <VBox
                                    spacing="4"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="KPI Configurations"
                                        styleClass="admin-section-title"/>

                                <Label
                                        text="Create and manage organisational KPI scoring configurations."
                                        styleClass="admin-section-subtitle"/>

                            </VBox>

                            <Button
                                    text="+ New Configuration"
                                    onAction="#handleNewConfig"
                                    styleClass="admin-button-primary"/>

                        </HBox>


                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="configSearchField"
                                    promptText="Search KPI configuration..."
                                    prefWidth="320"
                                    styleClass="admin-input"/>

                            <Button
                                    text="Refresh"
                                    onAction="#loadConfigs"
                                    styleClass="admin-button"/>

                        </HBox>


                        <TableView
                                fx:id="configTable"
                                prefHeight="280"
                                minHeight="240"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="configIdColumn"
                                        text="ID"
                                        prefWidth="60"/>

                                <TableColumn
                                        fx:id="configNameColumn"
                                        text="Configuration"
                                        prefWidth="280"/>

                                <TableColumn
                                        fx:id="riskThresholdColumn"
                                        text="Risk Threshold"
                                        prefWidth="150"/>

                                <TableColumn
                                        fx:id="effectiveDateColumn"
                                        text="Effective Date"
                                        prefWidth="160"/>

                                <TableColumn
                                        fx:id="configStatusColumn"
                                        text="Status"
                                        prefWidth="130"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- =================================================
                         CONFIG DETAILS
                         ================================================= -->

                    <VBox
                            spacing="18"
                            styleClass="admin-card">

                        <VBox spacing="4">

                            <Label
                                    text="Configuration Details"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Configure the selected KPI scheme and risk threshold."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <GridPane
                                hgap="25"
                                vgap="18">

                            <columnConstraints>
                                <ColumnConstraints minWidth="150"/>
                                <ColumnConstraints prefWidth="340"/>
                                <ColumnConstraints minWidth="150"/>
                                <ColumnConstraints prefWidth="200"/>
                            </columnConstraints>


                            <Label
                                    text="Configuration Name"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="configNameField"
                                    promptText="e.g. Standard Employee KPI 2026"
                                    maxWidth="Infinity"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Risk Threshold (%)"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="riskThresholdField"
                                    promptText="e.g. 60"
                                    maxWidth="Infinity"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Effective Date"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <DatePicker
                                    fx:id="effectiveDatePicker"
                                    prefWidth="220"
                                    styleClass="admin-date-picker"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>

                        </GridPane>


                        <Label
                                fx:id="configMessageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="admin-helper-text"/>


                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <Button
                                    fx:id="createConfigButton"
                                    text="Create Configuration"
                                    onAction="#handleCreateConfig"
                                    styleClass="admin-button-primary"/>

                            <Button
                                    fx:id="saveConfigButton"
                                    text="Save Changes"
                                    onAction="#handleSaveConfig"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="configStatusButton"
                                    text="Activate"
                                    onAction="#handleToggleConfigStatus"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="deleteConfigButton"
                                    text="Delete Configuration"
                                    onAction="#handleDeleteConfig"
                                    styleClass="admin-button-danger"/>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         COMPONENTS
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">

                        <HBox alignment="CENTER_LEFT">

                            <VBox
                                    spacing="4"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="KPI Components"
                                        styleClass="admin-section-title"/>

                                <Label
                                        text="Select a configuration before managing its KPI components."
                                        styleClass="admin-section-subtitle"/>

                            </VBox>

                            <Button
                                    text="+ New Component"
                                    onAction="#handleNewComponent"
                                    styleClass="admin-button-primary"/>

                        </HBox>


                        <TableView
                                fx:id="componentTable"
                                prefHeight="260"
                                minHeight="220"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="componentIdColumn"
                                        text="ID"
                                        prefWidth="70"/>

                                <TableColumn
                                        fx:id="componentNameColumn"
                                        text="Component"
                                        prefWidth="360"/>

                                <TableColumn
                                        fx:id="weightingColumn"
                                        text="Weighting (%)"
                                        prefWidth="180"/>

                                <TableColumn
                                        fx:id="componentStatusColumn"
                                        text="Status"
                                        prefWidth="150"/>

                            </columns>

                        </TableView>


                        <Label
                                fx:id="totalWeightingLabel"
                                text="Total Active Weighting: 0.00% / 100%"
                                styleClass="admin-section-title"/>

                    </VBox>


                    <!-- =================================================
                         COMPONENT DETAILS
                         ================================================= -->

                    <VBox
                            spacing="18"
                            styleClass="admin-card">

                        <VBox spacing="4">

                            <Label
                                    text="Component Details"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Configure the selected KPI component and its contribution to the overall score."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <GridPane
                                hgap="25"
                                vgap="18">

                            <columnConstraints>
                                <ColumnConstraints minWidth="150"/>
                                <ColumnConstraints prefWidth="340"/>
                                <ColumnConstraints minWidth="150"/>
                                <ColumnConstraints prefWidth="200"/>
                            </columnConstraints>


                            <Label
                                    text="Component Name"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="componentNameField"
                                    promptText="e.g. Productivity"
                                    maxWidth="Infinity"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Weighting (%)"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <TextField
                                    fx:id="weightingField"
                                    promptText="e.g. 30"
                                    maxWidth="Infinity"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>

                        </GridPane>


                        <Label
                                fx:id="componentMessageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="admin-helper-text"/>


                        <HBox
                                spacing="10">

                            <Button
                                    fx:id="createComponentButton"
                                    text="Create Component"
                                    onAction="#handleCreateComponent"
                                    styleClass="admin-button-primary"/>

                            <Button
                                    fx:id="saveComponentButton"
                                    text="Save Component"
                                    onAction="#handleSaveComponent"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="componentStatusButton"
                                    text="Deactivate"
                                    onAction="#handleToggleComponentStatus"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="deleteComponentButton"
                                    text="Delete Component"
                                    onAction="#handleDeleteComponent"
                                    styleClass="admin-button-danger"/>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         KPI CALCULATION
                         ================================================= -->

                    <VBox
                            spacing="18"
                            styleClass="admin-card">

                        <VBox spacing="4">

                            <Label
                                    text="KPI Calculation"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Calculate employee performance for a selected evaluation period."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <GridPane
                                hgap="25"
                                vgap="18">

                            <columnConstraints>
                                <ColumnConstraints minWidth="150"/>
                                <ColumnConstraints prefWidth="300"/>
                                <ColumnConstraints minWidth="150"/>
                                <ColumnConstraints prefWidth="220"/>
                            </columnConstraints>


                            <Label
                                    text="Employee"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <ComboBox
                                    fx:id="employeeComboBox"
                                    promptText="Select employee"
                                    prefWidth="300"
                                    styleClass="admin-combo-box"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Evaluation Start"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <DatePicker
                                    fx:id="evaluationStartDatePicker"
                                    prefWidth="220"
                                    styleClass="admin-date-picker"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Evaluation End"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <DatePicker
                                    fx:id="evaluationEndDatePicker"
                                    prefWidth="220"
                                    styleClass="admin-date-picker"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>

                        </GridPane>


                        <Button
                                fx:id="calculateKpiButton"
                                text="Calculate KPI"
                                onAction="#handleCalculateKpi"
                                styleClass="admin-button-primary"/>


                        <Label
                                fx:id="calculationMessageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="admin-helper-text"/>


                        <!-- RESULT -->

                        <VBox
                                spacing="16"
                                style="-fx-background-color:#F7F9FD;
                                       -fx-border-color:#DCE4F3;
                                       -fx-border-radius:9;
                                       -fx-background-radius:9;
                                       -fx-padding:18;">

                            <Label
                                    text="Calculated Result"
                                    styleClass="admin-section-title"/>


                            <GridPane
                                    hgap="35"
                                    vgap="16">

                                <Label
                                        text="Productivity"
                                        styleClass="admin-field-label"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="0"/>

                                <Label
                                        fx:id="productivityResultLabel"
                                        text="-"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="0"/>


                                <Label
                                        text="Timeliness"
                                        styleClass="admin-field-label"
                                        GridPane.columnIndex="2"
                                        GridPane.rowIndex="0"/>

                                <Label
                                        fx:id="timelinessResultLabel"
                                        text="-"
                                        GridPane.columnIndex="3"
                                        GridPane.rowIndex="0"/>


                                <Label
                                        text="Completion Rate"
                                        styleClass="admin-field-label"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="1"/>

                                <Label
                                        fx:id="completionResultLabel"
                                        text="-"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="1"/>


                                <Label
                                        text="Attendance"
                                        styleClass="admin-field-label"
                                        GridPane.columnIndex="2"
                                        GridPane.rowIndex="1"/>

                                <Label
                                        fx:id="attendanceResultLabel"
                                        text="-"
                                        GridPane.columnIndex="3"
                                        GridPane.rowIndex="1"/>


                                <Label
                                        text="Overall KPI"
                                        styleClass="admin-field-label"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="2"/>

                                <Label
                                        fx:id="overallKpiResultLabel"
                                        text="-"
                                        styleClass="admin-section-title"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="2"/>


                                <Label
                                        text="Performance Status"
                                        styleClass="admin-field-label"
                                        GridPane.columnIndex="2"
                                        GridPane.rowIndex="2"/>

                                <Label
                                        fx:id="performanceStatusLabel"
                                        text="-"
                                        styleClass="admin-section-title"
                                        GridPane.columnIndex="3"
                                        GridPane.rowIndex="2"/>

                            </GridPane>

                        </VBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>