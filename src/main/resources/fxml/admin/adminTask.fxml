<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminTaskController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">


                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                            text="WORKSPACE"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button-active"/>

                    <Button
                            text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button"/>


                    <!-- OPERATIONS -->

                    <Label
                            text="OPERATIONS"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button"/>


                    <!-- SYSTEM -->

                    <Label
                            text="SYSTEM"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✦   AI Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAIConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        styleClass="admin-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Task Management"
                                    styleClass="admin-page-title"/>

                            <Label
                                    text="Monitor tasks, assignments, progress and deadlines across the organisation."
                                    styleClass="admin-page-subtitle"/>

                        </VBox>


                        <HBox spacing="10">

                            <Button
                                    text="Manage Categories"
                                    onAction="#handleManageCategories"
                                    styleClass="admin-button"/>

                            <Button
                                    text="Progressive Rules"
                                    onAction="#handleProgressiveRules"
                                    styleClass="admin-button"/>

                            <Button
                                    text="Refresh"
                                    onAction="#handleRefresh"
                                    styleClass="admin-button"/>

                        </HBox>

                    </HBox>


                    <!-- =================================================
                         ALL TASKS
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">

                        <VBox spacing="4">

                            <Label
                                    text="All Tasks"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Search and filter organisation-wide task assignments."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <!-- SEARCH ROW -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search task name..."
                                    prefWidth="280"
                                    styleClass="admin-input"/>

                            <DatePicker
                                    fx:id="dueDateFilterPicker"
                                    promptText="Due date"
                                    prefWidth="175"
                                    styleClass="admin-date-picker"/>

                            <Button
                                    text="Clear Filters"
                                    onAction="#handleClearFilters"
                                    styleClass="admin-button"/>

                        </HBox>


                        <!-- FILTER ROW -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <ComboBox
                                    fx:id="employeeFilterComboBox"
                                    promptText="All Employees"
                                    prefWidth="205"
                                    styleClass="admin-combo-box"/>

                            <ComboBox
                                    fx:id="managerFilterComboBox"
                                    promptText="All Managers"
                                    prefWidth="205"
                                    styleClass="admin-combo-box"/>

                            <ComboBox
                                    fx:id="categoryFilterComboBox"
                                    promptText="All Categories"
                                    prefWidth="170"
                                    styleClass="admin-combo-box"/>

                            <ComboBox
                                    fx:id="statusFilterComboBox"
                                    promptText="All Status"
                                    prefWidth="160"
                                    styleClass="admin-combo-box"/>

                        </HBox>


                        <!-- MESSAGE -->

                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="admin-helper-text"/>


                        <!-- TASK TABLE -->

                        <TableView
                                fx:id="taskTable"
                                prefHeight="360"
                                minHeight="320"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="titleColumn"
                                        text="Task"
                                        prefWidth="140"/>

                                <TableColumn
                                        fx:id="categoryColumn"
                                        text="Category"
                                        prefWidth="100"/>

                                <TableColumn
                                        fx:id="employeeColumn"
                                        text="Employee"
                                        prefWidth="145"/>

                                <TableColumn
                                        fx:id="managerColumn"
                                        text="Manager"
                                        prefWidth="145"/>

                                <TableColumn
                                        fx:id="priorityColumn"
                                        text="Priority"
                                        prefWidth="75"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="100"/>

                                <TableColumn
                                        fx:id="progressColumn"
                                        text="Progress"
                                        prefWidth="80"/>

                                <TableColumn
                                        fx:id="dueDateColumn"
                                        text="Due Date"
                                        prefWidth="145"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- =================================================
                         SELECTED TASK DETAILS
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">

                        <VBox spacing="4">

                            <Label
                                    text="Task Details"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Select a task above to review its assignment, status and progress information."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <GridPane
                                hgap="30"
                                vgap="14">


                            <!-- ROW 1 -->

                            <Label
                                    text="Task"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="selectedTaskLabel"
                                    text="No task selected"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Category"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="selectedCategoryLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <!-- ROW 2 -->

                            <Label
                                    text="Employee"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="selectedEmployeeLabel"
                                    text="-"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Manager"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="selectedManagerLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <!-- ROW 3 -->

                            <Label
                                    text="Priority"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="selectedPriorityLabel"
                                    text="-"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Difficulty"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="selectedDifficultyLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>


                            <!-- ROW 4 -->

                            <Label
                                    text="Status"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"/>

                            <Label
                                    fx:id="selectedStatusLabel"
                                    text="-"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>


                            <Label
                                    text="Progress"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="3"/>

                            <Label
                                    fx:id="selectedProgressLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="3"/>


                            <!-- ROW 5 -->

                            <Label
                                    text="Assigned Date"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="4"/>

                            <Label
                                    fx:id="selectedAssignedDateLabel"
                                    text="-"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="4"/>


                            <Label
                                    text="Due Date"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="4"/>

                            <Label
                                    fx:id="selectedDueDateLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="4"/>

                        </GridPane>


                        <!-- DESCRIPTION -->

                        <VBox spacing="6">

                            <Label
                                    text="Description"
                                    styleClass="admin-field-label"/>

                            <Label
                                    fx:id="selectedDescriptionLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <!-- COMPLETION CRITERIA -->

                        <VBox spacing="6">

                            <Label
                                    text="Completion Criteria"
                                    styleClass="admin-field-label"/>

                            <Label
                                    fx:id="selectedCriteriaLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="admin-section-subtitle"/>

                        </VBox>

                    </VBox>


                    <!-- =================================================
                         PROGRESS HISTORY
                         ================================================= -->

                    <VBox
                            spacing="14"
                            styleClass="admin-card">

                        <VBox spacing="4">

                            <Label
                                    text="Progress History"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Review the employee's previous task progress updates."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <Label
                                fx:id="historyMessageLabel"
                                text="Select a task to view progress history."
                                styleClass="admin-helper-text"/>


                        <TableView
                                fx:id="historyTable"
                                prefHeight="220"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="historyProgressColumn"
                                        text="Progress"
                                        prefWidth="100"/>

                                <TableColumn
                                        fx:id="historyNoteColumn"
                                        text="Progress Note"
                                        prefWidth="520"/>

                                <TableColumn
                                        fx:id="historyDateColumn"
                                        text="Updated At"
                                        prefWidth="190"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>