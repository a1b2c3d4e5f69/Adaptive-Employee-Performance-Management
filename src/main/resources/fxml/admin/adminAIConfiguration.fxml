<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminAIConfigurationController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                fx:id="notificationTopBar"
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text=""
                        styleClass="admin-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">

                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                            text="WORKSPACE"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button"/>


                    <!-- OPERATIONS -->

                    <Label
                            text="OPERATIONS"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button"/>


                    <!-- SYSTEM -->

                    <Label
                            text="SYSTEM"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✦   AI Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAIConfiguration"
                            styleClass="admin-nav-button-active"/>

                    <Button
                            text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        styleClass="admin-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <VBox spacing="5">

                        <Label
                                text="AI Performance Recommendation"
                                wrapText="true"
                                styleClass="admin-page-title"/>

                        <Label
                                text="Configure AI recommendation settings, performance indicators and analysis parameters."
                                wrapText="true"
                                styleClass="admin-page-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         GENERAL SETTINGS
                         ================================================= -->

                    <VBox
                            spacing="18"
                            maxWidth="Infinity"
                            styleClass="admin-card">


                        <!-- SECTION HEADER -->

                        <VBox spacing="4">

                            <Label
                                    text="General Settings"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Control AI availability and configure the Gemini model used for employee performance recommendations."
                                    wrapText="true"
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <Separator/>


                        <!-- ENABLE AI -->

                        <VBox spacing="7">

                            <CheckBox
                                    fx:id="enabledCheck"
                                    text="Enable AI Performance Recommendation"
                                    selected="true"
                                    styleClass="admin-ai-checkbox"/>

                            <Label
                                    text="When disabled, new AI recommendations cannot be generated. Existing recommendations remain available."
                                    wrapText="true"
                                    styleClass="admin-helper-text"/>

                        </VBox>


                        <!-- MODEL -->

                        <VBox spacing="6">

                            <Label
                                    text="Gemini Model"
                                    styleClass="admin-field-label"/>

                            <TextField
                                    fx:id="modelField"
                                    text="gemini-2.5-flash"
                                    promptText="Enter Gemini model name"
                                    maxWidth="Infinity"
                                    styleClass="admin-input"/>

                            <Label
                                    text="Specify the Gemini model used when generating employee performance recommendations."
                                    wrapText="true"
                                    styleClass="admin-helper-text"/>

                        </VBox>

                    </VBox>


                    <!-- =================================================
                         PERFORMANCE INDICATORS
                         ================================================= -->

                    <VBox
                            spacing="18"
                            maxWidth="Infinity"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <VBox spacing="4">

                            <Label
                                    text="Performance Indicators"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Choose which employee performance data should be included when the AI analyses performance."
                                    wrapText="true"
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <Separator/>


                        <!-- INDICATOR GRID -->

                        <GridPane
                                hgap="30"
                                vgap="18">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="50"/>

                                <ColumnConstraints percentWidth="50"/>

                            </columnConstraints>


                            <!-- KPI -->

                            <VBox
                                    spacing="5"
                                    GridPane.rowIndex="0"
                                    GridPane.columnIndex="0">

                                <CheckBox
                                        fx:id="kpiCheck"
                                        text="KPI Performance"
                                        selected="true"
                                        styleClass="admin-ai-checkbox"/>

                                <Label
                                        text="Required indicator"
                                        styleClass="admin-helper-text"/>

                            </VBox>


                            <!-- TASK -->

                            <VBox
                                    spacing="5"
                                    GridPane.rowIndex="0"
                                    GridPane.columnIndex="1">

                                <CheckBox
                                        fx:id="taskCheck"
                                        text="Task Completion Rate"
                                        selected="true"
                                        styleClass="admin-ai-checkbox"/>

                                <Label
                                        text="Analyse employee task completion."
                                        styleClass="admin-helper-text"/>

                            </VBox>


                            <!-- ATTENDANCE -->

                            <VBox
                                    spacing="5"
                                    GridPane.rowIndex="1"
                                    GridPane.columnIndex="0">

                                <CheckBox
                                        fx:id="attendanceCheck"
                                        text="Attendance Records"
                                        selected="true"
                                        styleClass="admin-ai-checkbox"/>

                                <Label
                                        text="Include attendance behaviour."
                                        styleClass="admin-helper-text"/>

                            </VBox>


                            <!-- DEADLINE -->

                            <VBox
                                    spacing="5"
                                    GridPane.rowIndex="1"
                                    GridPane.columnIndex="1">

                                <CheckBox
                                        fx:id="deadlineCheck"
                                        text="Missed Deadlines"
                                        selected="true"
                                        styleClass="admin-ai-checkbox"/>

                                <Label
                                        text="Include overdue and deadline history."
                                        styleClass="admin-helper-text"/>

                            </VBox>


                            <!-- HISTORY -->

                            <VBox
                                    spacing="5"
                                    GridPane.rowIndex="2"
                                    GridPane.columnIndex="0">

                                <CheckBox
                                        fx:id="historyCheck"
                                        text="Historical Performance"
                                        selected="true"
                                        styleClass="admin-ai-checkbox"/>

                                <Label
                                        text="Compare current and previous KPI results."
                                        styleClass="admin-helper-text"/>

                            </VBox>

                        </GridPane>


                        <!-- INFORMATION -->

                        <VBox
                                spacing="5"
                                styleClass="admin-ai-info-box">

                            <Label
                                    text="Indicator Requirement"
                                    styleClass="admin-field-label"/>

                            <Label
                                    text="KPI Performance is required when AI recommendations are enabled. Task completion, attendance, missed deadlines and historical performance are optional supporting indicators."
                                    wrapText="true"
                                    styleClass="admin-helper-text"/>

                        </VBox>

                    </VBox>


                    <!-- =================================================
                         ANALYSIS PARAMETERS
                         ================================================= -->

                    <VBox
                            spacing="18"
                            maxWidth="Infinity"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <VBox spacing="4">

                            <Label
                                    text="Analysis Parameters"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Control the analysis window, minimum available data and the number of recommended actions."
                                    wrapText="true"
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <Separator/>


                        <!-- PARAMETER GRID -->

                        <GridPane
                                hgap="18"
                                vgap="8">

                            <columnConstraints>

                                <ColumnConstraints percentWidth="33.333"/>

                                <ColumnConstraints percentWidth="33.333"/>

                                <ColumnConstraints percentWidth="33.334"/>

                            </columnConstraints>


                            <!-- PERIOD -->

                            <VBox
                                    spacing="6"
                                    GridPane.rowIndex="0"
                                    GridPane.columnIndex="0">

                                <Label
                                        text="Analysis Period Days"
                                        wrapText="true"
                                        styleClass="admin-field-label"/>

                                <TextField
                                        fx:id="periodField"
                                        text="90"
                                        promptText="7 - 365"
                                        maxWidth="Infinity"
                                        styleClass="admin-input"/>

                                <Label
                                        text="Allowed range: 7–365 days"
                                        styleClass="admin-helper-text"/>

                            </VBox>


                            <!-- MINIMUM -->

                            <VBox
                                    spacing="6"
                                    GridPane.rowIndex="0"
                                    GridPane.columnIndex="1">

                                <Label
                                        text="Minimum Data Points"
                                        wrapText="true"
                                        styleClass="admin-field-label"/>

                                <TextField
                                        fx:id="minimumField"
                                        text="1"
                                        promptText="1 - 13"
                                        maxWidth="Infinity"
                                        styleClass="admin-input"/>

                                <Label
                                        text="Allowed range: 1–13"
                                        styleClass="admin-helper-text"/>

                            </VBox>


                            <!-- MAXIMUM -->

                            <VBox
                                    spacing="6"
                                    GridPane.rowIndex="0"
                                    GridPane.columnIndex="2">

                                <Label
                                        text="Maximum Recommendations"
                                        wrapText="true"
                                        styleClass="admin-field-label"/>

                                <TextField
                                        fx:id="maximumField"
                                        text="5"
                                        promptText="1 - 10"
                                        maxWidth="Infinity"
                                        styleClass="admin-input"/>

                                <Label
                                        text="Allowed range: 1–10"
                                        styleClass="admin-helper-text"/>

                            </VBox>

                        </GridPane>


                        <!-- EXPLANATION BOX -->

                        <VBox
                                spacing="5"
                                styleClass="admin-ai-info-box">

                            <Label
                                    text="How these parameters work"
                                    styleClass="admin-field-label"/>

                            <Label
                                    text="Analysis Period Days limits the selected evaluation period. Minimum Data Points counts the current KPI together with eligible historical KPI periods when Historical Performance is enabled. Maximum Recommendations controls how many recommended actions the AI may return."
                                    wrapText="true"
                                    maxWidth="Infinity"
                                    styleClass="admin-helper-text"/>

                        </VBox>


                        <!-- PROMPT -->

                        <VBox spacing="6">

                            <Label
                                    text="Additional AI Instructions"
                                    styleClass="admin-field-label"/>

                            <TextArea
                                    fx:id="promptArea"
                                    prefRowCount="4"
                                    wrapText="true"
                                    maxWidth="Infinity"
                                    promptText="Optional instructions for generating employee performance improvement recommendations..."
                                    styleClass="admin-text-area"/>

                            <Label
                                    text="Example: Focus on practical improvements, employee coaching, training needs and workload adjustments."
                                    wrapText="true"
                                    styleClass="admin-helper-text"/>

                        </VBox>

                    </VBox>


                    <!-- =================================================
                         ACTION AREA
                         ================================================= -->

                    <VBox
                            spacing="12"
                            maxWidth="Infinity"
                            styleClass="admin-card">

                        <HBox
                                alignment="CENTER_RIGHT"
                                spacing="10">

                            <Button
                                    fx:id="refreshButton"
                                    text="Refresh"
                                    onAction="#handleRefresh"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="saveButton"
                                    text="Save Configuration"
                                    onAction="#handleSave"
                                    styleClass="admin-button-primary"/>

                        </HBox>


                        <Label
                                fx:id="statusLabel"
                                text="Loading AI configuration..."
                                wrapText="true"
                                styleClass="admin-helper-text"/>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>