<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.image.ImageView?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminAttendanceController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                fx:id="notificationTopBar"
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text=""
                        styleClass="admin-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">

                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                            text="WORKSPACE"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button"/>


                    <!-- OPERATIONS -->

                    <Label
                            text="OPERATIONS"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button-active"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button"/>


                    <!-- SYSTEM -->

                    <Label
                            text="SYSTEM"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✦   AI Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAIConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        styleClass="admin-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <VBox spacing="5">

                        <Label
                                text="Attendance Management"
                                styleClass="admin-page-title"/>

                        <Label
                                text="Generate daily attendance QR codes and monitor employee attendance records."
                                styleClass="admin-page-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         SUMMARY CARDS
                         ================================================= -->

                    <GridPane
                            hgap="14"
                            vgap="14">

                        <columnConstraints>
                            <javafx.scene.layout.ColumnConstraints percentWidth="25"/>
                            <javafx.scene.layout.ColumnConstraints percentWidth="25"/>
                            <javafx.scene.layout.ColumnConstraints percentWidth="25"/>
                            <javafx.scene.layout.ColumnConstraints percentWidth="25"/>
                        </columnConstraints>


                        <!-- TOTAL EMPLOYEES -->

                        <VBox
                                GridPane.columnIndex="0"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="TOTAL EMPLOYEES"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="totalEmployeesLabel"
                                    text="--"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="Registered employees"
                                    styleClass="admin-kpi-note"/>

                        </VBox>


                        <!-- PRESENT -->

                        <VBox
                                GridPane.columnIndex="1"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="PRESENT TODAY"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="presentTodayLabel"
                                    text="0"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="Checked in today"
                                    styleClass="admin-kpi-note"/>

                        </VBox>


                        <!-- LATE -->

                        <VBox
                                GridPane.columnIndex="2"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="LATE TODAY"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="lateTodayLabel"
                                    text="0"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="Late attendance records"
                                    styleClass="admin-kpi-note"/>

                        </VBox>


                        <!-- ABSENT -->

                        <VBox
                                GridPane.columnIndex="3"
                                spacing="6"
                                maxWidth="Infinity"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="ABSENT TODAY"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="absentTodayLabel"
                                    text="--"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="No attendance record"
                                    styleClass="admin-kpi-note"/>

                        </VBox>

                    </GridPane>


                    <!-- =================================================
                         DAILY QR
                         ================================================= -->

                    <VBox
                            spacing="18"
                            styleClass="admin-card">

                        <VBox spacing="4">

                            <Label
                                    text="Daily Attendance QR Code"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Generate today's QR code for employees to check in and check out."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <HBox
                                spacing="28"
                                alignment="CENTER_LEFT">


                            <!-- QR PREVIEW -->

                            <StackPane
                                    prefWidth="300"
                                    prefHeight="300"
                                    minWidth="300"
                                    minHeight="300"
                                    maxWidth="300"
                                    maxHeight="300"
                                    style="
                                        -fx-background-color: #F7F9FD;
                                        -fx-background-radius: 10;
                                        -fx-border-color: #E3E7EF;
                                        -fx-border-radius: 10;
                                    ">

                                <ImageView
                                        fx:id="qrImage"
                                        fitWidth="270"
                                        fitHeight="270"
                                        preserveRatio="true"/>

                            </StackPane>


                            <!-- QR INFO -->

                            <VBox
                                    spacing="14"
                                    alignment="CENTER_LEFT"
                                    HBox.hgrow="ALWAYS">

                                <VBox spacing="5">

                                    <Label
                                            text="Today's Attendance QR"
                                            styleClass="admin-section-title"/>

                                    <Label
                                            text="Employees can scan this code during the configured attendance period."
                                            wrapText="true"
                                            styleClass="admin-section-subtitle"/>

                                </VBox>


                                <VBox spacing="5">

                                    <Label
                                            text="QR Status"
                                            styleClass="admin-field-label"/>

                                    <Label
                                            fx:id="expiryLabel"
                                            text="No QR Code generated yet."
                                            wrapText="true"
                                            styleClass="admin-section-subtitle"/>

                                </VBox>


                                <Button
                                        fx:id="generateButton"
                                        text="Generate Today's QR Code"
                                        onAction="#handleGenerateQr"
                                        styleClass="admin-button-primary"/>


                                <Label
                                        fx:id="statusLabel"
                                        text="Ready."
                                        wrapText="true"
                                        styleClass="admin-helper-text"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         ATTENDANCE RECORDS
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="14">

                            <VBox
                                    spacing="4"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="Attendance Records"
                                        styleClass="admin-section-title"/>

                                <Label
                                        text="Search and review employee attendance history."
                                        styleClass="admin-section-subtitle"/>

                            </VBox>


                            <Button
                                    fx:id="refreshButton"
                                    text="Refresh"
                                    onAction="#handleRefreshRecords"
                                    styleClass="admin-button"/>

                        </HBox>


                        <!-- SEARCH / FILTER -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="employeeSearchField"
                                    promptText="Search Employee ID"
                                    prefWidth="260"
                                    styleClass="admin-input"/>

                            <DatePicker
                                    fx:id="attendanceDatePicker"
                                    promptText="Select Date"
                                    prefWidth="180"
                                    styleClass="admin-date-picker"/>

                            <Button
                                    text="Search"
                                    onAction="#handleSearchAttendance"
                                    styleClass="admin-button-primary"/>

                            <Button
                                    text="Clear"
                                    onAction="#handleClearAttendanceFilter"
                                    styleClass="admin-button"/>

                        </HBox>


                        <!-- TABLE -->

                        <TableView
                                fx:id="recordsTable"
                                maxWidth="Infinity"
                                prefHeight="360"
                                minHeight="280"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="employeeColumn"
                                        text="Employee ID"
                                        prefWidth="240"/>

                                <TableColumn
                                        fx:id="dateColumn"
                                        text="Date"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="checkInColumn"
                                        text="Check In"
                                        prefWidth="170"/>

                                <TableColumn
                                        fx:id="checkOutColumn"
                                        text="Check Out"
                                        prefWidth="170"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="overtimeColumn"
                                        text="OT"
                                        prefWidth="100"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>