<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:id="root"
        fx:controller="com.aepm.ui.admin.AdminAnonymousReportsController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">


                    <!-- BRAND -->
                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->
                    <Label
                            text="WORKSPACE"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button"/>


                    <!-- OPERATIONS -->
                    <Label
                            text="OPERATIONS"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button-active"/>


                    <!-- SYSTEM -->
                    <Label
                            text="SYSTEM"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✦   AI Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAIConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        fx:id="pageContent"
                        spacing="22"
                        styleClass="admin-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox
                            spacing="16"
                            alignment="CENTER_LEFT">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Anonymous Reports"
                                    styleClass="admin-page-title"/>

                            <Label
                                    text="Review confidential workplace reports, monitor investigation status and manage cases securely."
                                    wrapText="true"
                                    styleClass="admin-page-subtitle"/>

                        </VBox>

                        <Button
                                fx:id="refreshButton"
                                text="Refresh"
                                onAction="#handleRefresh"
                                styleClass="admin-button"/>

                    </HBox>


                    <!-- =================================================
                         STATUS MESSAGE
                         ================================================= -->

                    <HBox
                            spacing="10"
                            alignment="CENTER_LEFT">

                        <ProgressIndicator
                                fx:id="busyIndicator"
                                prefWidth="22"
                                prefHeight="22"
                                visible="false"/>

                        <Label
                                fx:id="messageLabel"
                                wrapText="true"
                                minHeight="22"
                                styleClass="admin-helper-text"/>

                    </HBox>


                    <!-- =================================================
                         FILTER CARD
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <VBox spacing="4">

                            <Label
                                    text="Filters"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Filter reports by status, category and submission date."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <!-- FILTER FIELDS -->

                        <FlowPane
                                hgap="14"
                                vgap="12">


                            <!-- STATUS -->

                            <VBox spacing="6">

                                <Label
                                        text="Status"
                                        styleClass="admin-field-label"/>

                                <ComboBox
                                        fx:id="statusFilter"
                                        prefWidth="180"
                                        styleClass="admin-combo-box"/>

                            </VBox>


                            <!-- CATEGORY -->

                            <VBox spacing="6">

                                <Label
                                        text="Category"
                                        styleClass="admin-field-label"/>

                                <ComboBox
                                        fx:id="categoryFilter"
                                        editable="true"
                                        prefWidth="210"
                                        styleClass="admin-combo-box"/>

                            </VBox>


                            <!-- START DATE -->

                            <VBox spacing="6">

                                <Label
                                        text="Submitted From"
                                        styleClass="admin-field-label"/>

                                <DatePicker
                                        fx:id="startDate"
                                        prefWidth="180"
                                        styleClass="admin-date-picker"/>

                            </VBox>


                            <!-- END DATE -->

                            <VBox spacing="6">

                                <Label
                                        text="Submitted Through"
                                        styleClass="admin-field-label"/>

                                <DatePicker
                                        fx:id="endDate"
                                        prefWidth="180"
                                        styleClass="admin-date-picker"/>

                            </VBox>

                        </FlowPane>


                        <!-- FILTER ACTIONS -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <Button
                                    fx:id="applyFiltersButton"
                                    text="Apply Filters"
                                    onAction="#handleApplyFilters"
                                    styleClass="admin-button-primary"/>

                            <Button
                                    fx:id="clearFiltersButton"
                                    text="Clear Filters"
                                    onAction="#handleClearFilters"
                                    styleClass="admin-button"/>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         REPORT LIST CARD
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="12">

                            <VBox
                                    spacing="4"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="Report List"
                                        styleClass="admin-section-title"/>

                                <Label
                                        text="Select a report to review its details, conversation and investigation history."
                                        wrapText="true"
                                        styleClass="admin-section-subtitle"/>

                            </VBox>

                        </HBox>


                        <!-- TABLE -->

                        <TableView
                                fx:id="reportsTable"
                                prefHeight="430"
                                minHeight="300"
                                maxWidth="Infinity"
                                styleClass="admin-table"/>


                        <!-- PAGINATION / ACTION -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <Button
                                    fx:id="previousButton"
                                    text="Previous"
                                    onAction="#handlePrevious"
                                    styleClass="admin-button"/>

                            <Label
                                    fx:id="pageLabel"
                                    text="Loading reports..."
                                    maxWidth="Infinity"
                                    styleClass="admin-helper-text"/>

                            <Button
                                    fx:id="nextButton"
                                    text="Next"
                                    onAction="#handleNext"
                                    styleClass="admin-button"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button
                                    fx:id="detailButton"
                                    text="View Detail"
                                    onAction="#handleViewDetail"
                                    styleClass="admin-button-primary"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>