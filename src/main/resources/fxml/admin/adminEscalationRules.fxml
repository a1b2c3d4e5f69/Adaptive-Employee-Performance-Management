<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminEscalationRulesController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                fx:id="notificationTopBar"
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text=""
                        styleClass="admin-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <Label
                            text="WORKSPACE"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button"/>


                    <Label
                            text="OPERATIONS"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button"/>


                    <Label
                            text="SYSTEM"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✦   AI Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAIConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button-active"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        fillWidth="true"
                        styleClass="admin-content">


                    <!-- PAGE HEADER -->

                    <VBox spacing="5">

                        <Label
                                text="Deadline &amp; Escalation"
                                styleClass="admin-page-title"/>

                        <Label
                                text="Configure automatic escalation rules and review organisation-wide performance risk history."
                                wrapText="true"
                                styleClass="admin-page-subtitle"/>

                    </VBox>


                    <!-- TABS -->

                    <HBox
                            spacing="8"
                            alignment="CENTER_LEFT">

                        <Button
                                fx:id="rulesTabButton"
                                text="Escalation Rules"
                                onAction="#handleRulesTab"
                                styleClass="admin-button-primary"/>

                        <Button
                                fx:id="riskTabButton"
                                text="Performance Risk History"
                                onAction="#handleRiskTab"
                                styleClass="admin-button"/>

                    </HBox>


                    <!-- SUMMARY -->

                    <HBox
                            fx:id="rulesSummary"
                            spacing="14"
                            maxWidth="Infinity">

                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="TOTAL RULES"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="totalRulesLabel"
                                    text="—"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="Configured escalation rules"
                                    styleClass="admin-kpi-note"/>

                        </VBox>


                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="ACTIVE RULES"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="activeRulesLabel"
                                    text="—"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="Currently enabled"
                                    styleClass="admin-kpi-note"/>

                        </VBox>


                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="INACTIVE RULES"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="inactiveRulesLabel"
                                    text="—"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="Currently disabled"
                                    styleClass="admin-kpi-note"/>

                        </VBox>

                    </HBox>


                    <!-- =================================================
                         RULES CARD
                         ================================================= -->

                    <VBox
                            fx:id="rulesCard"
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="admin-card">


                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="12">

                            <VBox
                                    spacing="4"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="Escalation Rules"
                                        styleClass="admin-section-title"/>

                                <Label
                                        text="Configure the system response when tasks repeatedly miss deadlines."
                                        styleClass="admin-section-subtitle"/>

                            </VBox>

                            <Button
                                    fx:id="addButton"
                                    text="+ Add Rule"
                                    onAction="#handleAdd"
                                    styleClass="admin-button-primary"/>

                        </HBox>


                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="10">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search escalation rules..."
                                    prefWidth="340"
                                    styleClass="admin-input"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button
                                    fx:id="refreshButton"
                                    text="Refresh"
                                    onAction="#handleRefresh"
                                    styleClass="admin-button"/>

                        </HBox>


                        <TableView
                                fx:id="rulesTable"
                                prefHeight="300"
                                minHeight="250"
                                maxWidth="Infinity"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="nameColumn"
                                        text="Rule Name"
                                        prefWidth="185"/>

                                <TableColumn
                                        fx:id="levelColumn"
                                        text="Level"
                                        prefWidth="70"/>

                                <TableColumn
                                        fx:id="missedColumn"
                                        text="Missed Count"
                                        prefWidth="115"/>

                                <TableColumn
                                        fx:id="actionColumn"
                                        text="Action Type"
                                        prefWidth="145"/>

                                <TableColumn
                                        fx:id="extensionColumn"
                                        text="Extension Days"
                                        prefWidth="125"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="110"/>

                            </columns>

                            <placeholder>
                                <Label text="No escalation rules configured yet."/>
                            </placeholder>

                        </TableView>


                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="10">

                            <Button
                                    fx:id="editButton"
                                    text="Edit Selected"
                                    onAction="#handleEdit"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="deleteButton"
                                    text="Delete Selected"
                                    onAction="#handleDelete"
                                    styleClass="admin-button-danger"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="statusLabel"
                                    text="Loading escalation rules..."
                                    styleClass="admin-helper-text"/>

                        </HBox>


                        <Separator/>


                        <!-- TESTING -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="12">

                            <VBox
                                    spacing="4"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="Deadline Escalation Testing"
                                        styleClass="admin-section-title"/>

                                <Label
                                        text="Preview overdue tasks or manually execute escalation rules."
                                        styleClass="admin-section-subtitle"/>

                            </VBox>

                            <Button
                                    fx:id="previewEscalationButton"
                                    text="Preview Escalations"
                                    onAction="#handlePreviewEscalations"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="runEscalationButton"
                                    text="Run Escalation"
                                    onAction="#handleRunEscalation"
                                    styleClass="admin-button-primary"/>

                        </HBox>


                        <Label
                                fx:id="escalationResultLabel"
                                text="No escalation test has been run."
                                wrapText="true"
                                styleClass="admin-helper-text"/>

                    </VBox>


                    <!-- HELP -->

                    <VBox
                            fx:id="rulesHelpCard"
                            spacing="6"
                            maxWidth="Infinity"
                            styleClass="admin-card">

                        <Label
                                text="How Escalation Works"
                                styleClass="admin-section-title"/>

                        <Label
                                wrapText="true"
                                maxWidth="Infinity"
                                text="Rules define what happens when tasks repeatedly miss deadlines. Automatic execution depends on the deadline monitoring service."
                                styleClass="admin-section-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         RISK HISTORY
                         ================================================= -->

                    <VBox
                            fx:id="riskHistoryCard"
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="admin-card"
                            visible="false"
                            managed="false">

                        <VBox spacing="4">

                            <Label
                                    text="Performance Risk History"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Company-wide Level 3 performance risk records. No automatic score deduction."
                                    wrapText="true"
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="riskSearchField"
                                    promptText="Search task, employee or department..."
                                    prefWidth="340"
                                    styleClass="admin-input"/>

                            <ComboBox
                                    fx:id="riskStatusFilter"
                                    prefWidth="170"
                                    styleClass="admin-combo-box"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button
                                    fx:id="riskRefreshButton"
                                    text="Refresh"
                                    onAction="#handleRiskRefresh"
                                    styleClass="admin-button"/>

                        </HBox>


                        <TableView
                                fx:id="riskTable"
                                prefHeight="390"
                                maxWidth="Infinity"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="riskIdColumn"
                                        text="Risk ID"
                                        prefWidth="80"/>

                                <TableColumn
                                        fx:id="riskTaskColumn"
                                        text="Task"
                                        prefWidth="195"/>

                                <TableColumn
                                        fx:id="riskEmployeeColumn"
                                        text="Employee"
                                        prefWidth="165"/>

                                <TableColumn
                                        fx:id="riskDepartmentColumn"
                                        text="Department"
                                        prefWidth="130"/>

                                <TableColumn
                                        fx:id="riskDecisionColumn"
                                        text="Manager Decision"
                                        prefWidth="160"/>

                                <TableColumn
                                        fx:id="riskStatusColumn"
                                        text="Status"
                                        prefWidth="110"/>

                            </columns>

                            <placeholder>
                                <Label text="No Level 3 performance risk records found."/>
                            </placeholder>

                        </TableView>


                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="10">

                            <Label
                                    fx:id="riskCountLabel"
                                    text="0 record(s)"
                                    styleClass="admin-helper-text"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button
                                    text="View Details"
                                    onAction="#handleRiskDetails"
                                    styleClass="admin-button-primary"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>