<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminTaskDependencyController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">


                    <!-- BRAND -->

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->

                    <Label
                            text="WORKSPACE"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button-active"/>

                    <Button
                            text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button"/>


                    <!-- OPERATIONS -->

                    <Label
                            text="OPERATIONS"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button"/>


                    <!-- SYSTEM -->

                    <Label
                            text="SYSTEM"
                            styleClass="admin-sidebar-section"/>

                    <Button
                            text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="✦   AI Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAIConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        styleClass="admin-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Progressive Task Rules"
                                    styleClass="admin-page-title"/>

                            <Label
                                    text="Configure task dependencies and progressive task unlocking."
                                    styleClass="admin-page-subtitle"/>

                        </VBox>

                        <Button
                                text="Back"
                                onAction="#handleBack"
                                styleClass="admin-button"/>

                    </HBox>


                    <!-- =================================================
                         DEPENDENCY RULE LIST
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="12">

                            <VBox
                                    spacing="4"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        text="Dependency Rules"
                                        styleClass="admin-section-title"/>

                                <Label
                                        text="Define which task must be completed before another task becomes available."
                                        styleClass="admin-section-subtitle"/>

                            </VBox>

                            <Button
                                    text="+ New Rule"
                                    onAction="#handleNewRule"
                                    styleClass="admin-button-primary"/>

                        </HBox>


                        <!-- SEARCH -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search task rules..."
                                    prefWidth="340"
                                    styleClass="admin-input"/>

                            <Button
                                    text="Refresh"
                                    onAction="#handleRefresh"
                                    styleClass="admin-button"/>

                        </HBox>


                        <!-- TABLE -->

                        <TableView
                                fx:id="dependencyTable"
                                prefHeight="320"
                                minHeight="280"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="prerequisiteColumn"
                                        text="Prerequisite Task"
                                        prefWidth="320"/>

                                <TableColumn
                                        fx:id="nextTaskColumn"
                                        text="Next Task"
                                        prefWidth="320"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="130"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- =================================================
                         RULE DETAILS
                         ================================================= -->

                    <VBox
                            spacing="18"
                            styleClass="admin-card">


                        <!-- HEADER -->

                        <VBox spacing="4">

                            <Label
                                    text="Rule Details"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Select the prerequisite task and the next task in the progressive workflow."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <!-- FORM -->

                        <GridPane
                                hgap="30"
                                vgap="18">


                            <!-- PREREQUISITE TASK -->

                            <Label
                                    text="Prerequisite Task"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <ComboBox
                                    fx:id="prerequisiteComboBox"
                                    prefWidth="350"
                                    promptText="Select prerequisite task"
                                    styleClass="admin-combo-box"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <!-- NEXT TASK -->

                            <Label
                                    text="Next Task"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <ComboBox
                                    fx:id="nextTaskComboBox"
                                    prefWidth="350"
                                    promptText="Select next task"
                                    styleClass="admin-combo-box"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>

                        </GridPane>


                        <!-- MESSAGE -->

                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="admin-helper-text"/>


                        <!-- ACTIONS -->

                        <HBox spacing="10">

                            <Button
                                    fx:id="createButton"
                                    text="Create Rule"
                                    onAction="#handleCreateRule"
                                    styleClass="admin-button-primary"/>

                            <Button
                                    fx:id="statusButton"
                                    text="Deactivate"
                                    onAction="#handleToggleStatus"
                                    styleClass="admin-button"/>

                            <Button
                                    fx:id="deleteButton"
                                    text="Delete Rule"
                                    onAction="#handleDeleteRule"
                                    styleClass="admin-button-danger"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>