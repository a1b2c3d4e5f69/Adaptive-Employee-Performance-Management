<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminReportController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        text="AEPM Reports"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
     SIDEBAR
     ===================================================== -->

<left>

    <ScrollPane
            prefWidth="240"
            minWidth="240"
            maxWidth="240"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="admin-sidebar-scroll">

        <content>

            <VBox
                    prefWidth="240"
                    spacing="5"
                    styleClass="admin-sidebar">


                <!-- BRAND -->

                <VBox spacing="2">

                    <Label
                            text="AEPM"
                            styleClass="admin-brand-title"/>

                    <Label
                            text="Adaptive Performance"
                            styleClass="admin-brand-secondary"/>

                </VBox>


                <!-- WORKSPACE -->

                <Label
                        text="WORKSPACE"
                        styleClass="admin-sidebar-section"/>


                <Button
                        text="⌂   Dashboard"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleHome"
                        styleClass="admin-nav-button"/>


                <Button
                        text="♟   User Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleUserManagement"
                        styleClass="admin-nav-button"/>


                <Button
                        text="✓   Task Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleTaskManagement"
                        styleClass="admin-nav-button"/>


                <Button
                        text="★   KPI Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleKpiManagement"
                        styleClass="admin-nav-button"/>



                <!-- OPERATIONS -->

                <Label
                        text="OPERATIONS"
                        styleClass="admin-sidebar-section"/>


                <Button
                        text="▦   Attendance"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAttendanceManagement"
                        styleClass="admin-nav-button"/>


                <Button
                        text="≡   Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleReports"
                        styleClass="admin-nav-button-active"/>


                <Button
                        text="✉   Notifications"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAnnouncements"
                        styleClass="admin-nav-button"/>


                <Button
                        text="!   Anonymous Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAnonymousReports"
                        styleClass="admin-nav-button"/>



                <!-- SYSTEM -->

                <Label
                        text="SYSTEM"
                        styleClass="admin-sidebar-section"/>


                <Button
                        text="⚙   System Configuration"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleSystemConfiguration"
                        styleClass="admin-nav-button"/>


                <Button
                        text="✦   AI Configuration"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAIConfiguration"
                        styleClass="admin-nav-button"/>


                <Button
                        text="◷   Deadline &amp; Escalation"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleEscalationRules"
                        styleClass="admin-nav-button"/>


                <Button
                        text="○   My Profile"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleProfile"
                        styleClass="admin-nav-button"/>


                <Region VBox.vgrow="ALWAYS"/>


                <Button
                        text="↪   Logout"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleLogout"
                        styleClass="logout-button"/>

            </VBox>

        </content>

    </ScrollPane>

</left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        maxWidth="Infinity"
                        styleClass="admin-content">


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Performance Reports"
                                    styleClass="admin-page-title"/>

                            <Label
                                    text="Review performance records across all employees."
                                    styleClass="admin-page-subtitle"/>

                        </VBox>


                        <Button
                                text="Refresh"
                                onAction="#handleRefresh"
                                styleClass="admin-button"/>

                    </HBox>


                    <!-- =================================================
                         REPORT STATISTICS
                         ================================================= -->

                    <HBox
                            spacing="14"
                            maxWidth="Infinity">


                        <!-- TOTAL RECORDS -->

                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="TOTAL RECORDS"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="totalRecordsLabel"
                                    text="0"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="Performance records"
                                    styleClass="admin-kpi-note"/>

                        </VBox>


                        <!-- AVERAGE KPI -->

                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="AVERAGE KPI"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="averageKpiLabel"
                                    text="0.00%"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="Filtered average"
                                    styleClass="admin-kpi-note"/>

                        </VBox>


                        <!-- AT RISK -->

                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="AT RISK"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="atRiskCountLabel"
                                    text="0"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="At-risk records"
                                    styleClass="admin-kpi-note"/>

                        </VBox>


                        <!-- NORMAL / GOOD -->

                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"
                                styleClass="admin-kpi-card">

                            <Label
                                    text="NORMAL / GOOD"
                                    styleClass="admin-kpi-title"/>

                            <Label
                                    fx:id="normalGoodCountLabel"
                                    text="0"
                                    styleClass="admin-kpi-value"/>

                            <Label
                                    text="Healthy performance"
                                    styleClass="admin-kpi-note"/>

                        </VBox>

                    </HBox>


                    <!-- =================================================
                         FILTER CARD
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">


                        <VBox spacing="4">

                            <Label
                                    text="Report Filters"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Filter performance records by employee, department, status and evaluation period."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <!-- FILTER ROW 1 -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search Staff ID, name or department..."
                                    prefWidth="330"
                                    styleClass="admin-input"/>


                            <ComboBox
                                    fx:id="departmentFilterComboBox"
                                    prefWidth="190"
                                    styleClass="admin-combo-box"/>


                            <ComboBox
                                    fx:id="statusFilterComboBox"
                                    prefWidth="170"
                                    styleClass="admin-combo-box"/>

                        </HBox>


                        <!-- FILTER ROW 2 -->

                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <DatePicker
                                    fx:id="startDatePicker"
                                    promptText="Start date"
                                    prefWidth="180"
                                    styleClass="admin-date-picker"/>


                            <Label
                                    text="to"
                                    styleClass="admin-helper-text"/>


                            <DatePicker
                                    fx:id="endDatePicker"
                                    promptText="End date"
                                    prefWidth="180"
                                    styleClass="admin-date-picker"/>


                            <Button
                                    text="Clear Filters"
                                    onAction="#handleClearFilters"
                                    styleClass="admin-button"/>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         MESSAGE
                         ================================================= -->

                    <Label
                            fx:id="messageLabel"
                            visible="false"
                            managed="false"
                            wrapText="true"
                            maxWidth="Infinity"
                            styleClass="admin-helper-text"/>


                    <!-- =================================================
                         PERFORMANCE TABLE
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="admin-card">

                        <VBox spacing="4">

                            <Label
                                    text="Employee Performance Records"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Click a performance record to view its full summary."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <TableView
                                fx:id="reportTable"
                                prefHeight="500"
                                minHeight="420"
                                maxWidth="Infinity"
                                styleClass="admin-table">

                            <columns>

                                <TableColumn
                                        fx:id="employeeColumn"
                                        text="Employee"
                                        prefWidth="190"/>


                                <TableColumn
                                        fx:id="departmentColumn"
                                        text="Department"
                                        prefWidth="125"/>


                                <TableColumn
                                        fx:id="periodColumn"
                                        text="Evaluation Period"
                                        prefWidth="190"/>


                                <TableColumn
                                        fx:id="productivityColumn"
                                        text="Productivity"
                                        prefWidth="110"/>


                                <TableColumn
                                        fx:id="timelinessColumn"
                                        text="Timeliness"
                                        prefWidth="110"/>


                                <TableColumn
                                        fx:id="completionColumn"
                                        text="Completion"
                                        prefWidth="110"/>


                                <TableColumn
                                        fx:id="attendanceColumn"
                                        text="Attendance"
                                        prefWidth="105"/>


                                <TableColumn
                                        fx:id="overallColumn"
                                        text="Overall KPI"
                                        prefWidth="110"/>


                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="100"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>