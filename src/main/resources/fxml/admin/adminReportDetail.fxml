<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminReportDetailController"
        prefWidth="720"
        spacing="0"
        stylesheets="@../../css/app.css"
        style="
            -fx-font-family: 'Plus Jakarta Sans';
            -fx-background-color: #F3F6FD;
        ">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <HBox
            alignment="CENTER_LEFT"
            spacing="12"
            style="
                -fx-background-color: #FFFFFF;
                -fx-padding: 18 22 18 22;
                -fx-border-color: transparent transparent #E3E7EF transparent;
                -fx-border-width: 0 0 1 0;
            ">

        <VBox
                spacing="3"
                HBox.hgrow="ALWAYS">

            <Label
                    text="Performance Summary"
                    styleClass="admin-section-title"/>

            <Label
                    fx:id="employeeHeaderLabel"
                    text="Employee"
                    styleClass="admin-page-subtitle"/>

        </VBox>


        <Button
                text="×"
                onAction="#handleClose"
                styleClass="admin-button"/>

    </HBox>


    <!-- =====================================================
         CONTENT
         ===================================================== -->

    <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            prefHeight="610"
            styleClass="admin-content-scroll">

        <content>

            <VBox
                    spacing="18"
                    style="
                        -fx-background-color: #F3F6FD;
                        -fx-padding: 22 24 24 24;
                    ">


                <!-- =================================================
                     PERFORMANCE INFORMATION
                     ================================================= -->

                <VBox
                        spacing="16"
                        styleClass="admin-card">

                    <VBox spacing="4">

                        <Label
                                text="Performance Information"
                                styleClass="admin-section-title"/>

                        <Label
                                text="Review the employee's evaluation period, department and overall performance result."
                                wrapText="true"
                                styleClass="admin-section-subtitle"/>

                    </VBox>


                    <!-- ROW 1 -->

                    <HBox spacing="35">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Employee"
                                    styleClass="admin-field-label"/>

                            <Label
                                    fx:id="employeeLabel"
                                    text="-"
                                    wrapText="true"/>

                        </VBox>


                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Department"
                                    styleClass="admin-field-label"/>

                            <Label
                                    fx:id="departmentLabel"
                                    text="-"/>

                        </VBox>

                    </HBox>


                    <!-- ROW 2 -->

                    <HBox spacing="35">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Evaluation Period"
                                    styleClass="admin-field-label"/>

                            <Label
                                    fx:id="periodLabel"
                                    text="-"
                                    wrapText="true"/>

                        </VBox>


                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Overall KPI"
                                    styleClass="admin-field-label"/>

                            <Label
                                    fx:id="overallLabel"
                                    text="-"
                                    styleClass="admin-kpi-value"/>

                        </VBox>


                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity">

                            <Label
                                    text="Status"
                                    styleClass="admin-field-label"/>

                            <Label
                                    fx:id="statusLabel"
                                    text="-"/>

                        </VBox>

                    </HBox>

                </VBox>


                <!-- =================================================
                     KPI BREAKDOWN
                     ================================================= -->

                <VBox
                        spacing="17"
                        styleClass="admin-card">

                    <VBox spacing="4">

                        <Label
                                text="KPI Breakdown"
                                styleClass="admin-section-title"/>

                        <Label
                                text="Detailed contribution of each performance indicator."
                                styleClass="admin-section-subtitle"/>

                    </VBox>


                    <!-- PRODUCTIVITY -->

                    <VBox spacing="8">

                        <HBox>

                            <Label
                                    text="Productivity"
                                    styleClass="admin-field-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="productivityLabel"
                                    text="-"/>

                        </HBox>


                        <ProgressBar
                                fx:id="productivityProgressBar"
                                progress="0"
                                maxWidth="Infinity"
                                styleClass="admin-progress-bar"/>

                    </VBox>


                    <!-- TIMELINESS -->

                    <VBox spacing="8">

                        <HBox>

                            <Label
                                    text="Timeliness"
                                    styleClass="admin-field-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="timelinessLabel"
                                    text="-"/>

                        </HBox>


                        <ProgressBar
                                fx:id="timelinessProgressBar"
                                progress="0"
                                maxWidth="Infinity"
                                styleClass="admin-progress-bar"/>

                    </VBox>


                    <!-- COMPLETION -->

                    <VBox spacing="8">

                        <HBox>

                            <Label
                                    text="Completion Rate"
                                    styleClass="admin-field-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="completionLabel"
                                    text="-"/>

                        </HBox>


                        <ProgressBar
                                fx:id="completionProgressBar"
                                progress="0"
                                maxWidth="Infinity"
                                styleClass="admin-progress-bar"/>

                    </VBox>


                    <!-- ATTENDANCE -->

                    <VBox spacing="8">

                        <HBox>

                            <Label
                                    text="Attendance"
                                    styleClass="admin-field-label"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    fx:id="attendanceLabel"
                                    text="-"/>

                        </HBox>


                        <ProgressBar
                                fx:id="attendanceProgressBar"
                                progress="0"
                                maxWidth="Infinity"
                                styleClass="admin-progress-bar"/>

                    </VBox>

                </VBox>


                <!-- =================================================
                     MANAGER FEEDBACK
                     ================================================= -->

                <VBox
                        spacing="12"
                        styleClass="admin-card">

                    <VBox spacing="4">

                        <Label
                                text="Manager Feedback"
                                styleClass="admin-section-title"/>

                        <Label
                                text="Feedback recorded for this employee's evaluation period."
                                styleClass="admin-section-subtitle"/>

                    </VBox>


                    <VBox
                            spacing="7"
                            style="
                                -fx-background-color: #F7F9FD;
                                -fx-border-color: #DCE4F3;
                                -fx-border-width: 1;
                                -fx-border-radius: 8;
                                -fx-background-radius: 8;
                                -fx-padding: 14;
                            ">

                        <Label
                                fx:id="feedbackLabel"
                                text="Loading feedback..."
                                wrapText="true"
                                maxWidth="Infinity"/>


                        <Label
                                fx:id="feedbackDateLabel"
                                text=""
                                styleClass="admin-helper-text"/>

                    </VBox>

                </VBox>

            </VBox>

        </content>

    </ScrollPane>

</VBox>