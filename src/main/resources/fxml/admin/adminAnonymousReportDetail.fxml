<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.aepm.ui.components.EmployeeWelcomeLabel?>
<?import com.aepm.ui.components.EmployeeRoleLabel?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:id="root" fx:controller="com.aepm.ui.admin.AdminAnonymousReportDetailController" styleClass="main-layout" stylesheets="@../../css/app.css">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="topbar">
            <padding>
                <Insets top="16" right="28" bottom="16" left="28" />
            </padding>
            <VBox spacing="2">
                <Label fx:id="welcomeLabel" text="Welcome, Administrator" styleClass="topbar-title" />
                <Label text="Adaptive Employee Performance Management System" styleClass="topbar-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="topNameLabel" text="Administrator" styleClass="topbar-user-name" />
                <Label text="ADMINISTRATOR" styleClass="topbar-user-role" />
            </VBox>
        </HBox>
    </top>
    <left>
        <ScrollPane prefWidth="294" minWidth="294" maxWidth="294" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: white; -fx-background: white;">
            <VBox prefWidth="240" spacing="10" styleClass="sidebar">
                <padding>
                    <Insets top="30" right="18" bottom="20" left="18" />
                </padding>
                <VBox spacing="3">
                    <Label text="AEPM" styleClass="sidebar-logo" />
                    <Label text="Administrator Portal" styleClass="sidebar-subtitle" />
                </VBox>
                <Region prefHeight="18" />
                <Label text="MENU" styleClass="sidebar-section-title" />
                <Button text="⌂   Home" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleHome" styleClass="sidebar-button" />
                <Button text="●   My Profile" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleProfile" styleClass="sidebar-button" />
                <Button text="♟   User Management" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleUserManagement" styleClass="sidebar-button" />
                <Button text="✓   Task Management" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleTaskManagement" styleClass="sidebar-button" />
                <Button text="◷   Escalation Rules" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleEscalationRules" styleClass="sidebar-button" />
                <Button text="★   KPI Management" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleKpiManagement" styleClass="sidebar-button" />
                <Button text="⚙   System Configuration" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleSystemConfiguration" styleClass="sidebar-button" />
                <Button text="✉   Notification/Announcements" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleAnnouncements" styleClass="sidebar-button" />
                <Button text="✦   AI Recommendation" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleAIConfiguration" styleClass="sidebar-button" />
                <Button text="▦   Attendance Management" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleAttendanceManagement" styleClass="sidebar-button" />
                <Button text="≡   Reports" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleReports" styleClass="sidebar-button" />
                <Button text="!   Anonymous Reports" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleAnonymousReports" styleClass="sidebar-button-active" />
                <Region VBox.vgrow="ALWAYS" />
                <Button text="↪   Logout" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleLogout" styleClass="logout-button" />
            </VBox>
        </ScrollPane>
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="modern-content-scroll">
            <content>
                <VBox fx:id="pageContent" spacing="20" styleClass="modern-content">
                    <padding>
                        <Insets top="26" right="28" bottom="32" left="28" />
                    </padding>
                    <Label text="Anonymous Report Detail" styleClass="modern-page-title" />
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ProgressIndicator fx:id="busyIndicator" prefWidth="24" prefHeight="24" visible="false" />
                        <Label fx:id="messageLabel" wrapText="true" minHeight="22" />
                    </HBox>
                    <VBox spacing="12" styleClass="section-card">
                        <Label text="Report" styleClass="section-title" />
                        <HBox spacing="10">
                            <Button fx:id="backButton" text="Back to Anonymous Reports" onAction="#handleBack" styleClass="secondary-button" />
                            <Button fx:id="refreshReportButton" text="Refresh Report" onAction="#handleRefreshReport" styleClass="secondary-button" />
                        </HBox>
                        <Label fx:id="subjectLabel" text="-" wrapText="true" styleClass="section-title" />
                        <HBox spacing="14">
                            <Label text="Category" minWidth="160" styleClass="card-label" />
                            <Label fx:id="categoryLabel" text="-" wrapText="true" styleClass="modern-card-value" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <HBox spacing="14">
                            <Label text="Current Status" minWidth="160" styleClass="card-label" />
                            <Label fx:id="statusLabel" text="-" wrapText="true" styleClass="modern-card-value" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <HBox spacing="14">
                            <Label text="Submitted (UTC+08)" minWidth="160" styleClass="card-label" />
                            <Label fx:id="submittedLabel" text="-" wrapText="true" styleClass="modern-card-value" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <HBox spacing="14">
                            <Label text="Last Updated (UTC+08)" minWidth="160" styleClass="card-label" />
                            <Label fx:id="updatedLabel" text="-" wrapText="true" styleClass="modern-card-value" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <VBox spacing="5">
                            <Label text="Description" styleClass="card-label" />
                            <TextArea fx:id="descriptionArea" editable="false" wrapText="true" prefRowCount="5" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Evidence URL / path" styleClass="card-label" />
                            <TextField fx:id="evidenceField" editable="false" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Published Resolution" styleClass="card-label" />
                            <Label fx:id="publishedResolutionLabel" text="-" wrapText="true" styleClass="modern-card-value" maxWidth="Infinity" />
                        </VBox>
                    </VBox>
                    <VBox spacing="12" styleClass="section-card">
                        <Label text="Anonymous Conversation" styleClass="section-title" />
                        <TableView fx:id="conversationTable" prefHeight="230" minHeight="160" />
                        <VBox spacing="5">
                            <Label text="Reply" styleClass="card-label" />
                            <TextArea fx:id="replyArea" wrapText="true" prefRowCount="3" />
                        </VBox>
                        <HBox spacing="10">
                            <Button fx:id="replyButton" text="Send Reply" onAction="#handleSendReply" styleClass="modern-primary-button" />
                            <Button fx:id="refreshMessagesButton" text="Refresh Messages" onAction="#handleRefreshMessages" styleClass="secondary-button" />
                        </HBox>
                    </VBox>
                    <VBox spacing="12" styleClass="section-card">
                        <Label text="Private Investigation" styleClass="section-title" />
                        <VBox spacing="5">
                            <Label text="Private Investigation Note (Administrator only)" styleClass="card-label" />
                            <TextArea fx:id="investigationNoteArea" wrapText="true" prefRowCount="4" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="New Status" styleClass="card-label" />
                            <ComboBox fx:id="newStatusCombo" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Resolution / outcome (required when resolving or closing)" styleClass="card-label" />
                            <TextArea fx:id="resolutionArea" wrapText="true" prefRowCount="3" />
                        </VBox>
                        <Button fx:id="saveInvestigationButton" text="Save Investigation" onAction="#handleSaveInvestigation" styleClass="modern-primary-button" />
                    </VBox>
                    <VBox spacing="12" styleClass="section-card">
                        <Label text="Investigation History" styleClass="section-title" />
                        <TableView fx:id="historyTable" prefHeight="250" minHeight="160" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
