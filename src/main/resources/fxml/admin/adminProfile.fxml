<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.image.ImageView?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.shape.Circle?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminProfileController"
        styleClass="main-layout">


    <!-- TOP BAR -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>


            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- SIDEBAR -->

    <left>

        <VBox
                prefWidth="240"
                spacing="10"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="30"
                        right="18"
                        bottom="20"
                        left="18"/>
            </padding>


            <VBox spacing="3">

                <Label
                        text="AEPM"
                        styleClass="sidebar-logo"/>

                <Label
                        text="Administrator Portal"
                        styleClass="sidebar-subtitle"/>

            </VBox>


            <Region prefHeight="18"/>


            <Label
                    text="MENU"
                    styleClass="sidebar-section-title"/>


            <Button
                    text="⌂   Home"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleHome"
                    styleClass="sidebar-button"/>


            <Button
                    text="●   My Profile"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleProfile"
                    styleClass="sidebar-button-active"/>


            <Button
                    text="♟   User Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleUserManagement"
                    styleClass="sidebar-button"/>


            <Button
                    text="✓   Task Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleTaskManagement"
                    styleClass="sidebar-button"/>


            <Button
                    text="★   KPI Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleKpiManagement"
                    styleClass="sidebar-button"/>
            <Button
                    text="⚙   System Configuration"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleSystemConfiguration"
                    styleClass="sidebar-button"/>

            <Button
                    text="▦   Attendance Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleAttendanceManagement"
                    styleClass="sidebar-button"/>
                    
            <Button
                    text="≡   Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleReports"
                    styleClass="sidebar-button"/>


            <Button
                    text="!   Anonymous Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleAnonymousReports"
                    styleClass="sidebar-button"/>


            <Region VBox.vgrow="ALWAYS"/>


            <Button
                    text="↪   Logout"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <!-- CONTENT -->

    <center>

        <VBox
                spacing="22"
                styleClass="home-content">

            <padding>
                <Insets
                        top="32"
                        right="35"
                        bottom="35"
                        left="35"/>
            </padding>


            <VBox spacing="4">

                <Label
                        text="My Profile"
                        styleClass="content-title"/>

                <Label
                        text="View and update your personal information."
                        styleClass="content-description"/>

            </VBox>


            <VBox
                    spacing="24"
                    styleClass="profile-card">


                <!-- PROFILE HEADER -->

                <HBox
                        spacing="28"
                        alignment="CENTER_LEFT">


                    <!-- AVATAR -->

                    <StackPane
                            prefWidth="145"
                            prefHeight="145">

                        <Circle
                                radius="60"
                                styleClass="profile-avatar-background"/>


                        <Label
                                fx:id="profileInitialLabel"
                                text="A"
                                styleClass="profile-avatar-initial"/>


                        <ImageView
                                fx:id="profileImageView"
                                fitWidth="120"
                                fitHeight="120"
                                preserveRatio="false"/>


                        <Button
                                text="✎"
                                onAction="#handleChangeProfileImage"
                                translateX="48"
                                translateY="48"
                                styleClass="profile-avatar-edit-button"/>

                    </StackPane>


                    <VBox spacing="7">

                        <Label
                                fx:id="profileNameLabel"
                                text="Administrator"
                                styleClass="section-title"/>

                        <Label
                                fx:id="profileRoleLabel"
                                text="Administrator"
                                styleClass="content-description"/>

                        <Label
                                text="Click the edit icon to change your profile image."
                                styleClass="content-description"/>

                    </VBox>

                </HBox>


                <Region
                        minHeight="1"
                        prefHeight="1"
                        maxHeight="1"
                        styleClass="profile-divider"/>


                <Label
                        text="Personal Information"
                        styleClass="section-title"/>


                <!-- INFORMATION -->

                <GridPane
                        hgap="70"
                        vgap="22">


                    <!-- LEFT -->

                    <Label
                            text="Staff ID"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <Label
                            fx:id="employeeIdLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>


                    <Label
                            text="Email"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <Label
                            fx:id="emailLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>


                    <Label
                            text="Role"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                    <Label
                            fx:id="roleLabel"
                            text="Administrator"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>


                    <!-- RIGHT -->

                    <Label
                            text="Username"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0"/>

                    <Label
                            fx:id="usernameLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0"/>


                    <Label
                            text="Department"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="1"/>

                    <Label
                            fx:id="departmentLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"/>


                    <Label
                            text="Account Status"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="2"/>

                    <Label
                            fx:id="accountStatusLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="2"/>


                    <!-- CONTACT -->

                    <Label
                            text="Contact Number"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                    <TextField
                            fx:id="contactNumberField"
                            promptText="Enter contact number"
                            prefWidth="325"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                </GridPane>


                <Label
                        fx:id="messageLabel"
                        visible="false"
                        managed="false"
                        wrapText="true"/>


                <!-- CONSISTENT BUTTONS -->

                <HBox spacing="12">

                    <Button
                            fx:id="saveButton"
                            text="Save Changes"
                            onAction="#handleSave"
                            styleClass="app-button"/>


                    <Button
                            text="Change Password"
                            onAction="#handleChangePassword"
                            styleClass="app-button"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>