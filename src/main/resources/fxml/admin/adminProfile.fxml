<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.image.ImageView?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.shape.Circle?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminProfileController"
        styleClass="main-layout">

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>


            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         SAME MASTER UI
         ===================================================== -->

    <left>

        <VBox
                prefWidth="240"
                spacing="10"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="30"
                        right="18"
                        bottom="20"
                        left="18"/>
            </padding>


            <VBox spacing="3">

                <Label
                        text="AEPM"
                        styleClass="sidebar-logo"/>

                <Label
                        text="Administrator Portal"
                        styleClass="sidebar-subtitle"/>

            </VBox>


            <Region prefHeight="18"/>


            <Label
                    text="MENU"
                    styleClass="sidebar-section-title"/>


            <!-- HOME -->

            <Button
                    text="⌂   Home"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleHome"
                    styleClass="sidebar-button"/>


            <!-- PROFILE ACTIVE -->

            <Button
                    text="●   My Profile"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleProfile"
                    styleClass="sidebar-button-active"/>


            <!-- USER MANAGEMENT -->

            <Button
                    text="●   User Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleUserManagement"
                    styleClass="sidebar-button"/>


            <!-- TASK -->

            <Button
                    text="✓   Task Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleTaskManagement"
                    styleClass="sidebar-button"/>


            <!-- KPI -->

            <Button
                    text="★   KPI Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleKpiManagement"
                    styleClass="sidebar-button"/>


            <!-- REPORTS -->

            <Button
                    text="≡   Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleReports"
                    styleClass="sidebar-button"/>


            <!-- ANONYMOUS REPORT -->

            <Button
                    text="!   Anonymous Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleAnonymousReports"
                    styleClass="sidebar-button"/>


            <Region VBox.vgrow="ALWAYS"/>


            <Button
                    text="↪   Logout"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <!-- =====================================================
         PROFILE CONTENT
         ===================================================== -->

    <center>

        <VBox
                spacing="24"
                styleClass="home-content">

            <padding>
                <Insets
                        top="32"
                        right="35"
                        bottom="35"
                        left="35"/>
            </padding>


            <!-- PAGE TITLE -->

            <VBox spacing="4">

                <Label
                        text="My Profile"
                        styleClass="content-title"/>

                <Label
                        text="View and update your personal information."
                        styleClass="content-description"/>

            </VBox>


            <!-- PROFILE CARD -->

            <VBox
                    spacing="28"
                    styleClass="profile-card">


                <!-- PROFILE IMAGE -->

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="25">


                    <StackPane
                            prefWidth="130"
                            prefHeight="130"
                            maxWidth="130"
                            maxHeight="130">

                        <Circle
                                radius="60"
                                styleClass="profile-avatar-background"/>

                        <Label
                                fx:id="profileInitialLabel"
                                text="A"
                                styleClass="profile-avatar-initial"/>

                        <ImageView
                                fx:id="profileImageView"
                                fitWidth="120"
                                fitHeight="120"
                                preserveRatio="false"
                                visible="false"/>

                        <Button
                                fx:id="editImageButton"
                                text="✎"
                                onAction="#handleChangeProfileImage"
                                styleClass="profile-avatar-edit-button"
                                StackPane.alignment="BOTTOM_RIGHT"/>

                    </StackPane>


                    <VBox spacing="5">

                        <Label
                                fx:id="fullNameLabel"
                                text="Administrator"
                                styleClass="section-title"/>

                        <Label
                                text="Administrator"
                                styleClass="content-description"/>

                        <Label
                                text="Click the edit icon to change your profile image."
                                styleClass="content-description"/>

                    </VBox>

                </HBox>


                <Region
                        prefHeight="1"
                        styleClass="profile-divider"/>


                <!-- PERSONAL INFORMATION -->

                <Label
                        text="Personal Information"
                        styleClass="section-title"/>


                <GridPane
                        hgap="35"
                        vgap="20">


                    <!-- STAFF ID -->

                    <Label
                            text="Staff ID"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <Label
                            fx:id="employeeIdLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>


                    <!-- USERNAME -->

                    <Label
                            text="Username"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0"/>

                    <Label
                            fx:id="usernameLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0"/>


                    <!-- EMAIL -->

                    <Label
                            text="Email"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <Label
                            fx:id="emailLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>


                    <!-- DEPARTMENT -->

                    <Label
                            text="Department"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="1"/>

                    <Label
                            fx:id="departmentLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"/>


                    <!-- ROLE -->

                    <Label
                            text="Role"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                    <Label
                            fx:id="roleLabel"
                            text="Administrator"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>


                    <!-- STATUS -->

                    <Label
                            text="Account Status"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="2"/>

                    <Label
                            fx:id="accountStatusLabel"
                            text="-"
                            styleClass="profile-field-value"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="2"/>


                    <!-- CONTACT -->

                    <Label
                            text="Contact Number"
                            styleClass="profile-field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                    <TextField
                            fx:id="contactNumberField"
                            promptText="Enter contact number"
                            prefWidth="260"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                </GridPane>


                <!-- MESSAGE -->

                <Label
                        fx:id="messageLabel"
                        visible="false"
                        managed="false"
                        wrapText="true"/>


                <!-- ACTION -->

                <HBox spacing="12">

                    <Button
                            fx:id="saveButton"
                            text="Save Changes"
                            onAction="#handleSave"
                            styleClass="button-primary task-action-button"/>


                    <Button
                            text="Change Password"
                            onAction="#handleChangePassword"
                            styleClass="secondary-button task-action-button"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>