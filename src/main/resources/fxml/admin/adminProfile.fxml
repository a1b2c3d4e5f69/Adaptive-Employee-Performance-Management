<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.image.ImageView?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.shape.Circle?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminProfileController"
        stylesheets="@../../css/app.css"
        styleClass="admin-root">


    <!-- TOP BAR -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="admin-topbar">

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="admin-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="admin-topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="admin-topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- SIDEBAR -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="admin-sidebar">

                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="admin-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="admin-brand-secondary"/>

                    </VBox>


                    <Label text="WORKSPACE"
                           styleClass="admin-sidebar-section"/>

                    <Button text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="admin-nav-button"/>

                    <Button text="♟   User Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleUserManagement"
                            styleClass="admin-nav-button"/>

                    <Button text="✓   Task Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTaskManagement"
                            styleClass="admin-nav-button"/>

                    <Button text="★   KPI Management"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpiManagement"
                            styleClass="admin-nav-button"/>


                    <Label text="OPERATIONS"
                           styleClass="admin-sidebar-section"/>

                    <Button text="▦   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendanceManagement"
                            styleClass="admin-nav-button"/>

                    <Button text="≡   Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleReports"
                            styleClass="admin-nav-button"/>

                    <Button text="✉   Notifications"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnnouncements"
                            styleClass="admin-nav-button"/>

                    <Button text="!   Anonymous Reports"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReports"
                            styleClass="admin-nav-button"/>


                    <Label text="SYSTEM"
                           styleClass="admin-sidebar-section"/>

                    <Button text="⚙   System Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleSystemConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button text="✦   AI Configuration"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAIConfiguration"
                            styleClass="admin-nav-button"/>

                    <Button text="◷   Deadline &amp; Escalation"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleEscalationRules"
                            styleClass="admin-nav-button"/>

                    <Button text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="admin-nav-button-active"/>


                    <Region VBox.vgrow="ALWAYS"/>


                    <Button text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- CONTENT -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="admin-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        styleClass="admin-content">


                    <!-- PAGE HEADER -->

                    <VBox spacing="5">

                        <Label
                                text="My Profile"
                                styleClass="admin-page-title"/>

                        <Label
                                text="View and update your administrator account information."
                                styleClass="admin-page-subtitle"/>

                    </VBox>


                    <!-- PROFILE HEADER -->

                    <HBox
                            spacing="24"
                            alignment="CENTER_LEFT"
                            styleClass="admin-profile-header-card">


                        <!-- AVATAR -->

                        <StackPane
                                prefWidth="104"
                                prefHeight="104"
                                minWidth="104"
                                minHeight="104"
                                maxWidth="104"
                                maxHeight="104">

                            <Circle
                                    radius="46"
                                    styleClass="admin-profile-avatar-bg"/>

                            <Label
                                    fx:id="profileInitialLabel"
                                    text="A"
                                    styleClass="admin-profile-avatar-initial"/>

                            <ImageView
                                    fx:id="profileImageView"
                                    fitWidth="92"
                                    fitHeight="92"
                                    preserveRatio="false"
                                    smooth="true">

                                <clip>
                                    <Circle
                                            centerX="46"
                                            centerY="46"
                                            radius="46"/>
                                </clip>

                            </ImageView>


                            <Button
                                    text="✎"
                                    onAction="#handleChangeProfileImage"
                                    StackPane.alignment="BOTTOM_RIGHT"
                                    styleClass="admin-profile-edit-button"/>

                        </StackPane>


                        <!-- MAIN INFO -->

                        <VBox
                                spacing="6"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    fx:id="profileNameLabel"
                                    text="Administrator"
                                    styleClass="admin-profile-name"/>

                            <Label
                                    fx:id="profileRoleLabel"
                                    text="Administrator"
                                    styleClass="admin-profile-role"/>

                            <Label
                                    text="Manage your administrator profile and account information."
                                    styleClass="admin-profile-description"/>

                        </VBox>

                    </HBox>


                    <!-- PERSONAL INFORMATION -->

                    <VBox
                            spacing="18"
                            styleClass="admin-card">

                        <VBox spacing="4">

                            <Label
                                    text="Personal Information"
                                    styleClass="admin-section-title"/>

                            <Label
                                    text="Review your account details and update your contact information."
                                    styleClass="admin-section-subtitle"/>

                        </VBox>


                        <GridPane
                                hgap="36"
                                vgap="20">

                            <columnConstraints>

                                <ColumnConstraints minWidth="130"/>

                                <ColumnConstraints
                                        prefWidth="280"
                                        hgrow="ALWAYS"/>

                                <ColumnConstraints minWidth="130"/>

                                <ColumnConstraints
                                        prefWidth="280"
                                        hgrow="ALWAYS"/>

                            </columnConstraints>


                            <Label
                                    text="Staff ID"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="employeeIdLabel"
                                    text="-"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Username"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="usernameLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Email"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="emailLabel"
                                    text="-"
                                    wrapText="true"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Department"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="departmentLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Role"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="roleLabel"
                                    text="Administrator"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Account Status"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="accountStatusLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Contact Number"
                                    styleClass="admin-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"/>

                            <TextField
                                    fx:id="contactNumberField"
                                    promptText="Enter contact number"
                                    prefWidth="280"
                                    maxWidth="320"
                                    styleClass="admin-input"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>

                        </GridPane>


                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="admin-helper-text"/>


                        <HBox spacing="10">

                            <Button
                                    fx:id="saveButton"
                                    text="Save Changes"
                                    onAction="#handleSave"
                                    styleClass="admin-button-primary"/>

                            <Button
                                    text="Change Password"
                                    onAction="#handleChangePassword"
                                    styleClass="admin-button"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>