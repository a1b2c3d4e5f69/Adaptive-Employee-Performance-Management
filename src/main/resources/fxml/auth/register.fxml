<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.auth.RegisterController"
        styleClass="login-background">

    <VBox
            maxWidth="480"
            spacing="16"
            styleClass="login-card">

        <VBox spacing="5">

            <Label
                    text="AEPM"
                    styleClass="login-logo"/>

            <Label
                    text="Create your employee account"
                    styleClass="login-title"/>

            <Label
                    text="Enter your information to register."
                    styleClass="secondary-text"/>

        </VBox>


        <VBox spacing="7">
            <Label text="Full Name"
                   styleClass="input-label"/>

            <TextField
                    fx:id="fullNameField"
                    promptText="Enter your full name"/>
        </VBox>


        <VBox spacing="7">
            <Label text="Employee ID"
                   styleClass="input-label"/>

            <TextField
                    fx:id="employeeIdField"
                    promptText="Example: EMP001"/>
        </VBox>


        <VBox spacing="7">
            <Label text="Department"
                   styleClass="input-label"/>

            <TextField
                    fx:id="departmentField"
                    promptText="Enter your department"/>
        </VBox>


        <VBox spacing="7">
            <Label text="Username"
                   styleClass="input-label"/>

            <TextField
                    fx:id="usernameField"
                    promptText="Enter your username"/>
        </VBox>


        <VBox spacing="7">
            <Label text="Email"
                   styleClass="input-label"/>

            <TextField
                    fx:id="emailField"
                    promptText="Enter your email"/>
        </VBox>


        <VBox spacing="7">
            <Label text="Password"
                   styleClass="input-label"/>

            <PasswordField
                    fx:id="passwordField"
                    promptText="Enter your password"/>
        </VBox>


        <VBox spacing="7">
            <Label text="Confirm Password"
                   styleClass="input-label"/>

            <PasswordField
                    fx:id="confirmPasswordField"
                    promptText="Enter your password again"/>
        </VBox>


        <Label
                fx:id="messageLabel"
                visible="false"
                managed="false"
                wrapText="true"/>


        <Button
                fx:id="registerButton"
                text="Create Account"
                maxWidth="Infinity"
                prefHeight="45"
                onAction="#handleRegister"
                styleClass="button-primary"/>


        <ProgressIndicator
                fx:id="loadingIndicator"
                visible="false"
                managed="false"
                prefWidth="24"
                prefHeight="24"/>


        <HBox
                alignment="CENTER"
                spacing="5">

            <Label
                    text="Already have an account?"
                    styleClass="secondary-text"/>

            <Hyperlink
                    text="Sign In"
                    onAction="#goToLogin"/>

        </HBox>


        <padding>
            <Insets
                    top="30"
                    right="36"
                    bottom="30"
                    left="36"/>
        </padding>

    </VBox>

</StackPane>