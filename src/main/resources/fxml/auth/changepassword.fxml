<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.auth.ChangePasswordController"
        spacing="24"
        styleClass="profile-page">

    <padding>
        <Insets
                top="30"
                right="40"
                bottom="40"
                left="40"/>
    </padding>


    <!-- HEADER -->

    <HBox
            alignment="CENTER_LEFT"
            spacing="15">

        <VBox spacing="5">

            <Label
                    text="Change Password"
                    styleClass="content-title"/>

            <Label
                    text="Update your account password."
                    styleClass="content-description"/>

        </VBox>


        <Region HBox.hgrow="ALWAYS"/>


        <Button
                text="Back"
                onAction="#handleBack"
                styleClass="secondary-button"/>

    </HBox>


    <!-- CHANGE PASSWORD CARD -->

    <VBox
            maxWidth="520"
            spacing="18"
            styleClass="profile-card">


        <!-- CURRENT PASSWORD -->

        <VBox spacing="7">

            <Label
                    text="Current Password"
                    styleClass="input-label"/>

            <StackPane>

                <PasswordField
                        fx:id="currentPasswordField"
                        promptText="Enter current password"
                        prefHeight="44"/>

                <TextField
                        fx:id="currentPasswordVisibleField"
                        promptText="Enter current password"
                        prefHeight="44"
                        visible="false"
                        managed="false"/>

                <Button
                        fx:id="currentPasswordEyeButton"
                        text="👁"
                        onAction="#toggleCurrentPassword"
                        StackPane.alignment="CENTER_RIGHT"
                        styleClass="eye-button"/>

            </StackPane>

        </VBox>


        <!-- NEW PASSWORD -->

        <VBox spacing="7">

            <Label
                    text="New Password"
                    styleClass="input-label"/>

            <StackPane>

                <PasswordField
                        fx:id="newPasswordField"
                        promptText="Enter new password"
                        prefHeight="44"/>

                <TextField
                        fx:id="newPasswordVisibleField"
                        promptText="Enter new password"
                        prefHeight="44"
                        visible="false"
                        managed="false"/>

                <Button
                        fx:id="newPasswordEyeButton"
                        text="👁"
                        onAction="#toggleNewPassword"
                        StackPane.alignment="CENTER_RIGHT"
                        styleClass="eye-button"/>

            </StackPane>

        </VBox>


        <!-- CONFIRM PASSWORD -->

        <VBox spacing="7">

            <Label
                    text="Confirm New Password"
                    styleClass="input-label"/>

            <StackPane>

                <PasswordField
                        fx:id="confirmPasswordField"
                        promptText="Enter new password again"
                        prefHeight="44"/>

                <TextField
                        fx:id="confirmPasswordVisibleField"
                        promptText="Enter new password again"
                        prefHeight="44"
                        visible="false"
                        managed="false"/>

                <Button
                        fx:id="confirmPasswordEyeButton"
                        text="👁"
                        onAction="#toggleConfirmPassword"
                        StackPane.alignment="CENTER_RIGHT"
                        styleClass="eye-button"/>

            </StackPane>

        </VBox>


        <!-- MESSAGE -->

        <Label
                fx:id="messageLabel"
                visible="false"
                managed="false"
                wrapText="true"/>


        <!-- CHANGE PASSWORD BUTTON -->

        <Button
                fx:id="changePasswordButton"
                text="Change Password"
                maxWidth="Infinity"
                prefHeight="45"
                onAction="#handleChangePassword"
                styleClass="button-primary"/>

    </VBox>

</VBox>