<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.aepm.ui.components.NotificationBell?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aepm.ui.employee.EmployeeHomeController"
            stylesheets="@../../css/app.css"
            styleClass="employee-root">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="employee-topbar">

            <VBox spacing="2">
                <Label fx:id="topNameLabel"
                       text="Welcome, Employee"
                       styleClass="employee-topbar-user-name"/>

                <Label text="Adaptive Employee Performance Management System"
                       styleClass="employee-page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <NotificationBell/>

            <VBox alignment="CENTER_RIGHT"
                  spacing="2">

                <Label fx:id="welcomeNameLabel"
                       text="Employee"
                       styleClass="employee-topbar-user-name"/>

                <Label fx:id="topRoleLabel"
                       text="EMPLOYEE"
                       styleClass="employee-topbar-user-position"/>
            </VBox>

        </HBox>
    </top>


    <!-- SIDEBAR -->
    <left>
        <ScrollPane prefWidth="240"
                    minWidth="240"
                    maxWidth="240"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="employee-sidebar-scroll">

            <content>
                <VBox prefWidth="240"
                      spacing="5"
                      styleClass="employee-sidebar">

                    <VBox spacing="2">
                        <Label text="AEPM"
                               styleClass="employee-brand-title"/>

                        <Label text="Adaptive Performance"
                               styleClass="employee-brand-secondary"/>
                    </VBox>

                    <Label text="WORKSPACE"
                           styleClass="employee-sidebar-section"/>

                    <Button text="⌂   Home"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="employee-nav-button-active"/>

                    <Button text="✓   My Tasks"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTasks"
                            styleClass="employee-nav-button"/>

                    <Button text="◷   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendance"
                            styleClass="employee-nav-button"/>

                    <Button text="⌁   My Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpi"
                            styleClass="employee-nav-button"/>

                    <Label text="SUPPORT &amp; GOVERNANCE"
                           styleClass="employee-sidebar-section"/>

                    <Button text="!   Anonymous Report"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReport"
                            styleClass="employee-nav-button"/>

                    <Button text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="employee-nav-button"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>
            </content>

        </ScrollPane>
    </left>


    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="employee-content-scroll">

            <content>
                <VBox spacing="22"
                      styleClass="employee-content">

                    <!-- WELCOME -->
                    <HBox spacing="20"
                          alignment="CENTER_LEFT"
                          styleClass="employee-card">

                        <VBox spacing="7"
                              HBox.hgrow="ALWAYS">

                            <Label text="Welcome back"
                                   styleClass="employee-section-subtitle"/>

                            <Label text="Your Employee Dashboard"
                                   styleClass="employee-page-title"/>

                            <Label text="Stay focused on your priorities, monitor your workload and keep track of your performance."
                                   wrapText="true"
                                   styleClass="employee-page-subtitle"/>

                            <HBox spacing="10">

                                <Button text="View My Tasks"
                                        onAction="#handleTasks"
                                        styleClass="employee-button-primary"/>

                                <Button text="My Performance"
                                        onAction="#handleKpi"
                                        styleClass="employee-button"/>

                            </HBox>
                        </VBox>


                        <VBox spacing="6"
                              minWidth="200"
                              styleClass="employee-kpi-card">

                            <Label text="DEPARTMENT"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="departmentLabel"
                                   text="-"
                                   styleClass="employee-section-title"/>

                            <Label fx:id="employeeIdLabel"
                                   text="-"
                                   styleClass="employee-kpi-note"/>

                        </VBox>

                    </HBox>


                    <!-- DASHBOARD TITLE -->
                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="4"
                              HBox.hgrow="ALWAYS">

                            <Label text="Dashboard Overview"
                                   styleClass="employee-section-title"/>

                            <Label text="Quick summary of your workload and performance."
                                   styleClass="employee-section-subtitle"/>
                        </VBox>

                        <Button text="Refresh"
                                onAction="#handleRefreshDashboard"
                                styleClass="employee-button"/>

                    </HBox>

                    <Label fx:id="dashboardStatusLabel"
                           text=""
                           styleClass="employee-helper-text"/>


                    <!-- MAIN KPI -->
                    <HBox spacing="14">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-kpi-card">

                            <Label text="TOTAL TASKS"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="taskCountLabel"
                                   text="0"
                                   styleClass="employee-kpi-value"/>

                            <Label text="Assigned workload"
                                   styleClass="employee-kpi-note"/>
                        </VBox>


                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-kpi-card">

                            <Label text="IN PROGRESS"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="inProgressCountLabel"
                                   text="0"
                                   styleClass="employee-kpi-value"/>

                            <Label text="Currently active"
                                   styleClass="employee-kpi-note"/>
                        </VBox>


                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-kpi-card">

                            <Label text="COMPLETION"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="completionRateLabel"
                                   text="0%"
                                   styleClass="employee-kpi-value"/>

                            <Label text="Task completion rate"
                                   styleClass="employee-kpi-note"/>
                        </VBox>


                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-kpi-card">

                            <Label text="OVERALL KPI"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="kpiScoreLabel"
                                   text="-"
                                   styleClass="employee-kpi-value"/>

                            <Label fx:id="performanceStatusLabel"
                                   text="-"
                                   styleClass="employee-kpi-note"/>
                        </VBox>

                    </HBox>


                    <!-- SECONDARY -->
                    <HBox spacing="14">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-card">
                            <Label text="Pending Tasks"
                                   styleClass="employee-section-subtitle"/>
                            <Label fx:id="pendingCountLabel"
                                   text="0"
                                   styleClass="employee-section-title"/>
                        </VBox>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-card">
                            <Label text="Completed Tasks"
                                   styleClass="employee-section-subtitle"/>
                            <Label fx:id="completedCountLabel"
                                   text="0"
                                   styleClass="employee-section-title"/>
                        </VBox>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-card">
                            <Label text="Overdue Tasks"
                                   styleClass="employee-section-subtitle"/>
                            <Label fx:id="overdueCountLabel"
                                   text="0"
                                   styleClass="employee-section-title"/>
                        </VBox>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-card">
                            <Label text="Due Soon"
                                   styleClass="employee-section-subtitle"/>
                            <Label fx:id="dueSoonLabel"
                                   text="0"
                                   styleClass="employee-section-title"/>
                        </VBox>

                    </HBox>


                    <!-- CHARTS -->
                    <HBox spacing="14">

                        <VBox spacing="12"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-card">

                            <Label text="Task Status"
                                   styleClass="employee-section-title"/>

                            <BarChart fx:id="taskStatusChart"
                                      prefHeight="280"
                                      legendVisible="false"
                                      animated="false">

                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis/>
                                </yAxis>

                            </BarChart>
                        </VBox>


                        <VBox spacing="12"
                              prefWidth="360"
                              styleClass="employee-card">

                            <Label text="Deadline Escalation"
                                   styleClass="employee-section-title"/>

                            <PieChart fx:id="escalationChart"
                                      prefHeight="230"
                                      labelsVisible="false"
                                      legendVisible="false"/>

                            <HBox alignment="CENTER"
                                  spacing="5">

                                <Label text="Active:"
                                       styleClass="employee-section-subtitle"/>

                                <Label fx:id="donutTotalLabel"
                                       text="0"
                                       styleClass="employee-section-title"/>

                            </HBox>

                            <Label fx:id="escalationCountLabel"
                                   text="0"
                                   visible="false"
                                   managed="false"/>

                        </VBox>
                    </HBox>


                    <!-- REMINDER -->
                    <VBox spacing="8"
                          styleClass="employee-card">

                        <Label text="Reminders"
                               styleClass="employee-section-title"/>

                        <Label fx:id="remindersLabel"
                               text="No reminders."
                               wrapText="true"
                               styleClass="employee-page-subtitle"/>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>