<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.aepm.ui.components.EmployeeWelcomeLabel?>
<?import com.aepm.ui.components.EmployeeRoleLabel?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="root"
            fx:controller="com.aepm.ui.employee.EmployeeAnonymousReportController"
            stylesheets="@../../css/app.css"
            styleClass="employee-root">

    <!-- TOP -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="employee-topbar">

            <VBox spacing="2">

                <EmployeeWelcomeLabel styleClass="employee-topbar-user-name"/>

                <Label text="Adaptive Employee Performance Management System"
                       styleClass="employee-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox alignment="CENTER_RIGHT"
                  spacing="2">

                <Label fx:id="topNameLabel"
                       text="Employee"
                       styleClass="employee-topbar-user-name"/>

                <EmployeeRoleLabel fx:id="topRoleLabel"
                                   styleClass="employee-topbar-user-position"/>

            </VBox>

        </HBox>
    </top>


    <!-- SIDEBAR -->
    <left>
        <ScrollPane prefWidth="240"
                    minWidth="240"
                    maxWidth="240"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="employee-sidebar-scroll">

            <content>
                <VBox prefWidth="240"
                      spacing="5"
                      styleClass="employee-sidebar">

                    <VBox spacing="2">
                        <Label text="AEPM"
                               styleClass="employee-brand-title"/>
                        <Label text="Adaptive Performance"
                               styleClass="employee-brand-secondary"/>
                    </VBox>

                    <Label text="WORKSPACE"
                           styleClass="employee-sidebar-section"/>

                    <Button text="⌂   Home"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="employee-nav-button"/>

                    <Button text="✓   My Tasks"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTasks"
                            styleClass="employee-nav-button"/>

                    <Button text="◷   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendance"
                            styleClass="employee-nav-button"/>

                    <Button text="⌁   My Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpi"
                            styleClass="employee-nav-button"/>

                    <Label text="SUPPORT &amp; GOVERNANCE"
                           styleClass="employee-sidebar-section"/>

                    <Button text="!   Anonymous Report"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReport"
                            styleClass="employee-nav-button-active"/>

                    <Button text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="employee-nav-button"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>
            </content>
        </ScrollPane>
    </left>


    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="employee-content-scroll">

            <content>
                <VBox fx:id="pageContent"
                      spacing="22"
                      styleClass="employee-content">

                    <!-- HEADER -->
                    <VBox spacing="5">

                        <Label text="Anonymous Reporting"
                               styleClass="employee-page-title"/>

                        <Label text="Submit and track workplace concerns safely and confidentially."
                               styleClass="employee-page-subtitle"/>

                    </VBox>


                    <!-- PRIVACY NOTICE -->
                    <VBox spacing="6"
                          style="-fx-background-color:#FFF9E6;
                                 -fx-border-color:#FFDE69;
                                 -fx-border-width:1;
                                 -fx-border-radius:10;
                                 -fx-background-radius:10;
                                 -fx-padding:18;">

                        <Label text="Your privacy is protected"
                               styleClass="employee-section-title"/>

                        <Label text="Your identity is not disclosed to the administrator reviewing this report. Avoid including unnecessary identifying information and keep your secret reference number safely."
                               wrapText="true"
                               styleClass="employee-section-subtitle"/>

                    </VBox>


                    <!-- STATUS -->
                    <HBox spacing="10"
                          alignment="CENTER_LEFT">

                        <ProgressIndicator fx:id="busyIndicator"
                                           prefWidth="24"
                                           prefHeight="24"
                                           visible="false"/>

                        <Label fx:id="messageLabel"
                               wrapText="true"
                               minHeight="22"
                               styleClass="employee-helper-text"/>

                    </HBox>


                    <!-- SUBMIT -->
                    <VBox spacing="16"
                          styleClass="employee-card">

                        <VBox spacing="4">
                            <Label text="Submit Anonymous Report"
                                   styleClass="employee-section-title"/>

                            <Label text="Provide enough information for the administrator to understand and investigate the concern."
                                   wrapText="true"
                                   styleClass="employee-section-subtitle"/>
                        </VBox>


                        <VBox spacing="6">

                            <Label text="Category"
                                   styleClass="employee-field-label"/>

                            <ComboBox fx:id="categoryCombo"
                                      promptText="Select a category"
                                      maxWidth="Infinity"
                                      styleClass="employee-combo-box"/>

                        </VBox>


                        <VBox spacing="6">

                            <Label text="Subject"
                                   styleClass="employee-field-label"/>

                            <TextField fx:id="subjectField"
                                       promptText="Brief subject"
                                       styleClass="employee-input"/>

                        </VBox>


                        <VBox spacing="6">

                            <Label text="Description"
                                   styleClass="employee-field-label"/>

                            <TextArea fx:id="descriptionArea"
                                      wrapText="true"
                                      prefRowCount="6"
                                      promptText="Describe the concern without adding identifying details unnecessarily."
                                      styleClass="employee-text-area"/>

                        </VBox>


                        <VBox spacing="6">

                            <Label text="Optional Evidence"
                                   styleClass="employee-field-label"/>

                            <HBox spacing="10">

                                <TextField fx:id="evidenceField"
                                           promptText="Evidence URL, path or file name"
                                           HBox.hgrow="ALWAYS"
                                           styleClass="employee-input"/>

                                <Button text="Browse Evidence"
                                        onAction="#handleBrowseEvidence"
                                        styleClass="employee-button"/>

                            </HBox>

                            <Label text="Browse records the file name only; it does not upload a file. Avoid paths that reveal unnecessary personal details."
                                   wrapText="true"
                                   styleClass="employee-helper-text"/>

                        </VBox>


                        <HBox spacing="10">

                            <Button fx:id="submitButton"
                                    text="Submit Report"
                                    onAction="#handleSubmit"
                                    styleClass="employee-button-primary"/>

                            <Button fx:id="clearFormButton"
                                    text="Clear Form"
                                    onAction="#handleClearForm"
                                    styleClass="employee-button"/>

                        </HBox>


                        <!-- SECRET REFERENCE -->
                        <VBox spacing="7"
                              style="-fx-background-color:#FBFAF6;
                                     -fx-border-color:#E7E7E2;
                                     -fx-border-radius:8;
                                     -fx-background-radius:8;
                                     -fx-padding:14;">

                            <Label text="Your Secret Reference"
                                   styleClass="employee-field-label"/>

                            <TextField fx:id="referenceDisplay"
                                       editable="false"
                                       styleClass="employee-input"
                                       style="-fx-font-family:monospace;
                                              -fx-font-size:15px;
                                              -fx-font-weight:bold;"/>

                            <Label text="Keep this reference number safely. You will need it to track this report."
                                   wrapText="true"
                                   styleClass="employee-section-subtitle"/>

                            <Button fx:id="copyReferenceButton"
                                    text="Copy Reference"
                                    onAction="#handleCopyReference"
                                    styleClass="employee-button"/>

                        </VBox>

                    </VBox>


                    <!-- TRACK -->
                    <VBox spacing="16"
                          styleClass="employee-card">

                        <VBox spacing="4">

                            <Label text="Track Existing Report"
                                   styleClass="employee-section-title"/>

                            <Label text="Enter your secret reference number to securely view the latest report status."
                                   styleClass="employee-section-subtitle"/>

                        </VBox>


                        <HBox spacing="10">

                            <TextField fx:id="trackingReferenceField"
                                       promptText="Enter secret reference"
                                       HBox.hgrow="ALWAYS"
                                       styleClass="employee-input"/>

                            <Button fx:id="trackButton"
                                    text="Track Report"
                                    onAction="#handleTrack"
                                    styleClass="employee-button-primary"/>

                        </HBox>


                        <GridPane hgap="25"
                                  vgap="14">

                            <columnConstraints>
                                <ColumnConstraints minWidth="170"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>


                            <Label text="Subject"
                                   styleClass="employee-field-label"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="0"/>

                            <Label fx:id="trackedSubject"
                                   text="-"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="1"/>


                            <Label text="Category"
                                   styleClass="employee-field-label"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="0"/>

                            <Label fx:id="trackedCategory"
                                   text="-"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>


                            <Label text="Current Status"
                                   styleClass="employee-field-label"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="0"/>

                            <Label fx:id="trackedStatus"
                                   text="-"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="1"/>


                            <Label text="Submitted (UTC+08)"
                                   styleClass="employee-field-label"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="0"/>

                            <Label fx:id="trackedSubmitted"
                                   text="-"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   GridPane.rowIndex="3"
                                   GridPane.columnIndex="1"/>


                            <Label text="Last Updated (UTC+08)"
                                   styleClass="employee-field-label"
                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="0"/>

                            <Label fx:id="trackedUpdated"
                                   text="-"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="1"/>


                            <Label fx:id="trackedResolutionCaption"
                                   text="Resolution"
                                   styleClass="employee-field-label"
                                   GridPane.rowIndex="5"
                                   GridPane.columnIndex="0"/>

                            <Label fx:id="trackedResolution"
                                   text="-"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   GridPane.rowIndex="5"
                                   GridPane.columnIndex="1"/>

                        </GridPane>


                        <HBox>
                            <Button fx:id="openChatButton"
                                    text="Open Anonymous Chat"
                                    onAction="#handleOpenChat"
                                    styleClass="employee-button"/>
                        </HBox>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>