<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.employee.EmployeeTaskDetailController"

        prefWidth="820"
        prefHeight="700"

        minWidth="760"
        minHeight="600"

        maxHeight="760"

        stylesheets="@../../css/app.css"

        styleClass="employee-root">


    <!-- =====================================================
         FIXED HEADER
         X WILL ALWAYS BE VISIBLE
         ===================================================== -->

    <HBox
            alignment="CENTER_LEFT"
            spacing="8">

        <padding>
            <Insets
                    top="12"
                    right="18"
                    bottom="12"
                    left="18"/>
        </padding>


        <Label
                fx:id="difficultyBadgeLabel"
                text="Medium"
                styleClass="employee-badge,employee-badge-pending"/>


        <Label
                fx:id="statusBadgeLabel"
                text="Pending"
                styleClass="employee-badge,employee-badge-completed"/>


        <Region HBox.hgrow="ALWAYS"/>


        <Button
                text="×"
                onAction="#handleClose"
                styleClass="employee-button-link"/>

    </HBox>


    <!-- =====================================================
         ONLY THIS PART SCROLLS
         ===================================================== -->

    <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            VBox.vgrow="ALWAYS"
            styleClass="employee-content-scroll">

        <content>

            <VBox
                    spacing="16"
                    maxWidth="Infinity">

                <padding>
                    <Insets
                            top="18"
                            right="24"
                            bottom="18"
                            left="24"/>
                </padding>


                <!-- =================================================
                     TASK TITLE
                     ================================================= -->

                <VBox spacing="4">

                    <Label
                            fx:id="taskTitleLabel"
                            text="Task Name"
                            wrapText="true"
                            maxWidth="Infinity"
                            styleClass="employee-page-title"/>


                    <Label
                            fx:id="descriptionLabel"
                            text="-"
                            wrapText="true"
                            maxWidth="Infinity"
                            styleClass="employee-page-subtitle"/>

                </VBox>


                <!-- =================================================
                     TASK DETAILS CARD
                     ================================================= -->

                <VBox
                        spacing="16"
                        maxWidth="Infinity"
                        styleClass="employee-card">


                    <!-- HEADER -->

                    <VBox spacing="3">

                        <Label
                                text="Task Information"
                                styleClass="employee-section-title"/>

                        <Label
                                text="Review the task assignment, deadline and current status."
                                wrapText="true"
                                styleClass="employee-section-subtitle"/>

                    </VBox>


                    <!-- INFORMATION -->

                    <GridPane
                            hgap="28"
                            vgap="15"
                            maxWidth="Infinity">

                        <columnConstraints>

                            <ColumnConstraints
                                    percentWidth="33.33"
                                    hgrow="ALWAYS"/>

                            <ColumnConstraints
                                    percentWidth="33.33"
                                    hgrow="ALWAYS"/>

                            <ColumnConstraints
                                    percentWidth="33.34"
                                    hgrow="ALWAYS"/>

                        </columnConstraints>


                        <!-- CATEGORY -->

                        <VBox
                                spacing="3"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0">

                            <Label
                                    text="Category"
                                    styleClass="employee-helper-text"/>

                            <Label
                                    fx:id="categoryLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="employee-section-title"/>

                        </VBox>


                        <!-- PRIORITY -->

                        <VBox
                                spacing="3"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0">

                            <Label
                                    text="Priority"
                                    styleClass="employee-helper-text"/>

                            <Label
                                    fx:id="priorityLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="employee-section-title"/>

                        </VBox>


                        <!-- ASSIGNED DATE -->

                        <VBox
                                spacing="3"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="0">

                            <Label
                                    text="Assigned Date"
                                    styleClass="employee-helper-text"/>

                            <Label
                                    fx:id="assignedDateLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="employee-section-title"/>

                        </VBox>


                        <!-- DUE DATE -->

                        <VBox
                                spacing="3"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1">

                            <Label
                                    text="Due Date"
                                    styleClass="employee-helper-text"/>

                            <Label
                                    fx:id="dueDateLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="employee-section-title"/>

                        </VBox>


                        <!-- DIFFICULTY -->

                        <VBox
                                spacing="3"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1">

                            <Label
                                    text="Difficulty"
                                    styleClass="employee-helper-text"/>

                            <Label
                                    fx:id="difficultyLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="employee-section-title"/>

                        </VBox>


                        <!-- STATUS -->

                        <VBox
                                spacing="3"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="1">

                            <Label
                                    text="Status"
                                    styleClass="employee-helper-text"/>

                            <Label
                                    fx:id="statusLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="employee-section-title"/>

                        </VBox>

                    </GridPane>


                    <!-- COMPLETION CRITERIA -->

                    <VBox spacing="5">

                        <Label
                                text="Completion Criteria"
                                styleClass="employee-section-title"/>

                        <Label
                                fx:id="criteriaLabel"
                                text="-"
                                wrapText="true"
                                maxWidth="Infinity"
                                styleClass="employee-page-subtitle"/>

                    </VBox>


                    <!-- TASK PROGRESS -->

                    <VBox spacing="8">

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="2">

                                <Label
                                        text="Task Progress"
                                        styleClass="employee-section-title"/>

                                <Label
                                        text="Current completion progress."
                                        styleClass="employee-section-subtitle"/>

                            </VBox>


                            <Region HBox.hgrow="ALWAYS"/>


                            <Label
                                    fx:id="progressValueLabel"
                                    text="0%"
                                    styleClass="employee-kpi-value"/>

                        </HBox>


                        <ProgressBar
                                fx:id="progressBar"
                                progress="0"
                                maxWidth="Infinity"
                                styleClass="employee-progress-bar"/>

                    </VBox>

                </VBox>

                <!-- =================================================
                TASK ATTACHMENT
                ================================================= -->

                <VBox
                        fx:id="attachmentSection"
                        spacing="12"
                        maxWidth="Infinity"
                        visible="false"
                        managed="false"
                        styleClass="employee-task-detail-card">

                <Label
                        text="Required File"
                        styleClass="employee-task-detail-section-title"/>


                <HBox
                        spacing="12"
                        alignment="CENTER_LEFT">

                        <Label
                                text="📎"
                                styleClass="employee-task-detail-field-value"/>

                        <VBox
                                spacing="3"
                                HBox.hgrow="ALWAYS">

                        <Label
                                fx:id="attachmentNameLabel"
                                text="-"
                                styleClass="employee-task-detail-field-value"/>

                        <Label
                                fx:id="attachmentSizeLabel"
                                text=""
                                styleClass="employee-task-detail-field-label"/>

                        </VBox>

                        <Button
                                text="Open File"
                                onAction="#handleOpenAttachment"
                                styleClass="employee-task-detail-primary-button"/>

                </HBox>

                </VBox>
                <!-- =================================================
                     UPDATE PROGRESS / VERIFICATION
                     ================================================= -->

                <VBox
                        fx:id="progressUpdateSection"
                        spacing="14"
                        maxWidth="Infinity"
                        styleClass="employee-card">


                    <VBox spacing="3">

                        <Label
                                text="Submit Progress for Verification"
                                styleClass="employee-section-title"/>

                        <Label
                                text="Enter your requested progress, describe the work completed, and upload supporting evidence."
                                wrapText="true"
                                styleClass="employee-section-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         PERCENTAGE
                         ================================================= -->

                    <VBox spacing="5">

                        <Label
                                text="Requested Progress Percentage"
                                styleClass="employee-field-label"/>

                        <TextField
                                fx:id="progressField"
                                promptText="0 - 100"
                                prefWidth="210"
                                maxWidth="210"
                                styleClass="employee-input"/>

                    </VBox>


                    <!-- =================================================
                         NOTE
                         ================================================= -->

                    <VBox spacing="5">

                        <Label
                                text="Progress Note"
                                styleClass="employee-field-label"/>

                        <TextArea
                                fx:id="progressNoteArea"
                                promptText="Describe the work completed..."
                                prefRowCount="4"
                                prefHeight="100"
                                wrapText="true"
                                maxWidth="Infinity"
                                styleClass="employee-text-area"/>

                    </VBox>


                    <!-- =================================================
                         SUPPORTING EVIDENCE
                         ================================================= -->

                    <VBox
                            spacing="8"
                            maxWidth="Infinity">

                        <Label
                                text="Supporting Evidence"
                                styleClass="employee-field-label"/>

                        <Label
                                text="Upload a screenshot, image, PDF, document, source file, or other supporting evidence."
                                wrapText="true"
                                styleClass="employee-section-subtitle"/>


                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <Button
                                    fx:id="uploadEvidenceButton"
                                    text="Upload Evidence"
                                    onAction="#handleChooseEvidence"
                                    styleClass="employee-button"/>

                            <Label
                                    fx:id="evidenceFileNameLabel"
                                    text="No file selected"
                                    wrapText="true"
                                    maxWidth="420"
                                    styleClass="employee-helper-text"/>

                        </HBox>


                        <HBox
                                fx:id="evidencePreviewBox"
                                spacing="10"
                                alignment="CENTER_LEFT"
                                visible="false"
                                managed="false"
                                style="-fx-background-color: #F8FAFC;
                                       -fx-background-radius: 8;
                                       -fx-border-color: #E2E8F0;
                                       -fx-border-radius: 8;
                                       -fx-padding: 10;">

                            <VBox
                                    spacing="2"
                                    HBox.hgrow="ALWAYS">

                                <Label
                                        fx:id="evidenceNameLabel"
                                        text=""
                                        wrapText="true"
                                        styleClass="employee-section-title"/>

                                <Label
                                        fx:id="evidenceSizeLabel"
                                        text=""
                                        styleClass="employee-helper-text"/>

                            </VBox>


                            <Button
                                    text="Remove"
                                    onAction="#handleRemoveEvidence"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #DC2626;
                                           -fx-cursor: hand;"/>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         VERIFICATION INFO
                         ================================================= -->

                    <VBox
                            spacing="5"
                            maxWidth="Infinity"
                            style="-fx-background-color: #EFF6FF;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #BFDBFE;
                                   -fx-border-radius: 8;
                                   -fx-padding: 12;">

                        <Label
                                text="Progress Verification"
                                style="-fx-font-weight: bold;
                                       -fx-text-fill: #1E40AF;"/>

                        <Label
                                text="Your requested progress will not immediately change the actual task progress. A manager will review your supporting evidence first. If the manager does not respond before the review deadline, the system may perform limited automatic verification."
                                wrapText="true"
                                maxWidth="Infinity"
                                style="-fx-font-size: 12px;
                                       -fx-text-fill: #475569;"/>

                    </VBox>


                    <!-- =================================================
                         SUBMIT BUTTON
                         ================================================= -->

                    <HBox alignment="CENTER_RIGHT">

                        <Button
                                fx:id="updateProgressButton"
                                text="Submit for Verification"
                                onAction="#handleUpdateProgress"
                                styleClass="employee-button-primary"/>

                    </HBox>

                </VBox>





                <!-- =================================================
                     MESSAGE
                     ================================================= -->

                <Label
                        fx:id="messageLabel"
                        visible="false"
                        managed="false"
                        wrapText="true"
                        maxWidth="Infinity"
                        styleClass="employee-helper-text"/>

            </VBox>

        </content>

    </ScrollPane>


    <!-- =====================================================
         FIXED FOOTER
         ALWAYS VISIBLE
         ===================================================== -->

    <HBox
            spacing="10"
            alignment="CENTER_RIGHT">

        <padding>
            <Insets
                    top="12"
                    right="18"
                    bottom="12"
                    left="18"/>
        </padding>


        <Button
                fx:id="acceptButton"
                text="Accept Task"
                onAction="#handleAcceptTask"
                styleClass="employee-button"/>


        <Button
                fx:id="startButton"
                text="Start Task"
                onAction="#handleStartTask"
                styleClass="employee-button"/>


        <Button
                fx:id="completeButton"
                text="Complete Task"
                onAction="#handleCompleteTask"
                styleClass="employee-button-primary"/>

    </HBox>

</VBox>