<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.aepm.ui.components.NotificationBell?>
<?import com.aepm.ui.components.EmployeeWelcomeLabel?>
<?import com.aepm.ui.components.EmployeeRoleLabel?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aepm.ui.employee.EmployeePerformanceController"
            stylesheets="@../../css/app.css"
            styleClass="employee-root">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="employee-topbar">

            <VBox spacing="2">
                <EmployeeWelcomeLabel styleClass="employee-topbar-user-name"/>

                <Label text="Adaptive Employee Performance Management System"
                       styleClass="employee-page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <NotificationBell/>

            <VBox alignment="CENTER_RIGHT"
                  spacing="2">

                <Label fx:id="topNameLabel"
                       text="Employee"
                       styleClass="employee-topbar-user-name"/>

                <EmployeeRoleLabel fx:id="topRoleLabel"
                                   styleClass="employee-topbar-user-position"/>

            </VBox>
        </HBox>
    </top>


    <left>
        <ScrollPane prefWidth="240"
                    minWidth="240"
                    maxWidth="240"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="employee-sidebar-scroll">

            <content>
                <VBox prefWidth="240"
                      spacing="5"
                      styleClass="employee-sidebar">

                    <VBox spacing="2">
                        <Label text="AEPM"
                               styleClass="employee-brand-title"/>
                        <Label text="Adaptive Performance"
                               styleClass="employee-brand-secondary"/>
                    </VBox>

                    <Label text="WORKSPACE"
                           styleClass="employee-sidebar-section"/>

                    <Button text="⌂   Home"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="employee-nav-button"/>

                    <Button text="✓   My Tasks"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTasks"
                            styleClass="employee-nav-button"/>

                    <Button text="◷   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendance"
                            styleClass="employee-nav-button"/>

                    <Button text="⌁   My Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpi"
                            styleClass="employee-nav-button-active"/>

                    <Label text="SUPPORT &amp; GOVERNANCE"
                           styleClass="employee-sidebar-section"/>

                    <Button text="!   Anonymous Report"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReport"
                            styleClass="employee-nav-button"/>

                    <Button text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="employee-nav-button"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>
            </content>
        </ScrollPane>
    </left>


    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="employee-content-scroll">

            <content>
                <VBox spacing="22"
                      styleClass="employee-content">

                    <!-- PAGE HEADER -->
                    <HBox alignment="CENTER_LEFT"
                          spacing="12">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label text="My Performance"
                                   styleClass="employee-page-title"/>

                            <Label text="Review your KPI results, performance history and manager feedback."
                                   wrapText="true"
                                   styleClass="employee-page-subtitle"/>

                        </VBox>

                        <Button text="AI Recommendations"
                                fx:id="aiRecommendationsButton"
                                onAction="#handleAiRecommendations"
                                styleClass="employee-button"/>

                        <Button text="Refresh"
                                onAction="#handleRefresh"
                                styleClass="employee-button-primary"/>

                    </HBox>

                    <Label fx:id="welcomeLabel"
                           visible="false"
                           managed="false"/>

                    <Label fx:id="messageLabel"
                           visible="false"
                           managed="false"
                           wrapText="true"
                           styleClass="employee-helper-text"/>


                    <!-- PERFORMANCE SUMMARY -->
                    <HBox spacing="14">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-kpi-card">

                            <Label text="OVERALL KPI"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="overallKpiLabel"
                                   text="-"
                                   styleClass="employee-kpi-value"/>

                            <Label fx:id="performanceStatusLabel"
                                   text="-"
                                   styleClass="employee-kpi-note"/>

                        </VBox>


                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-kpi-card">

                            <Label text="EVALUATION PERIOD"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="evaluationPeriodLabel"
                                   text="-"
                                   wrapText="true"
                                   styleClass="employee-section-title"/>

                            <Label text="Current performance period"
                                   styleClass="employee-kpi-note"/>

                        </VBox>


                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-kpi-card">

                            <Label text="CALCULATED AT"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="calculatedDateLabel"
                                   text="-"
                                   wrapText="true"
                                   styleClass="employee-section-title"/>

                            <Label text="Latest KPI calculation"
                                   styleClass="employee-kpi-note"/>

                        </VBox>

                    </HBox>


                    <!-- KPI BREAKDOWN -->
                    <VBox spacing="18"
                          styleClass="employee-card">

                        <Label text="KPI Breakdown"
                               styleClass="employee-section-title"/>

                        <HBox spacing="14">

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <HBox>
                                    <Label text="Productivity"
                                           HBox.hgrow="ALWAYS"
                                           styleClass="employee-field-label"/>

                                    <Label fx:id="productivityLabel"
                                           text="-"/>
                                </HBox>

                                <ProgressBar fx:id="productivityProgressBar"
                                             progress="0"
                                             maxWidth="Infinity"
                                             styleClass="employee-progress-bar"/>

                            </VBox>


                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <HBox>
                                    <Label text="Timeliness"
                                           HBox.hgrow="ALWAYS"
                                           styleClass="employee-field-label"/>

                                    <Label fx:id="timelinessLabel"
                                           text="-"/>
                                </HBox>

                                <ProgressBar fx:id="timelinessProgressBar"
                                             progress="0"
                                             maxWidth="Infinity"
                                             styleClass="employee-progress-bar"/>

                            </VBox>

                        </HBox>


                        <HBox spacing="14">

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <HBox>
                                    <Label text="Task Completion"
                                           HBox.hgrow="ALWAYS"
                                           styleClass="employee-field-label"/>

                                    <Label fx:id="completionRateLabel"
                                           text="-"/>
                                </HBox>

                                <ProgressBar fx:id="completionProgressBar"
                                             progress="0"
                                             maxWidth="Infinity"
                                             styleClass="employee-progress-bar"/>

                            </VBox>


                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS">

                                <HBox>
                                    <Label text="Attendance"
                                           HBox.hgrow="ALWAYS"
                                           styleClass="employee-field-label"/>

                                    <Label fx:id="attendanceLabel"
                                           text="-"/>
                                </HBox>

                                <ProgressBar fx:id="attendanceProgressBar"
                                             progress="0"
                                             maxWidth="Infinity"
                                             styleClass="employee-progress-bar"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- HISTORY -->
                    <VBox spacing="14"
                          styleClass="employee-card">

                        <VBox spacing="4">
                            <Label text="Performance History"
                                   styleClass="employee-section-title"/>

                            <Label text="Select a previous evaluation to review historical results."
                                   styleClass="employee-section-subtitle"/>
                        </VBox>

                        <TableView fx:id="historyTable"
                                   prefHeight="290"
                                   minHeight="240"
                                   styleClass="employee-table">

                            <columns>

                                <TableColumn fx:id="periodColumn"
                                             text="Evaluation Period"
                                             prefWidth="200"/>

                                <TableColumn fx:id="productivityColumn"
                                             text="Productivity"
                                             prefWidth="120"/>

                                <TableColumn fx:id="timelinessColumn"
                                             text="Timeliness"
                                             prefWidth="120"/>

                                <TableColumn fx:id="completionColumn"
                                             text="Completion"
                                             prefWidth="120"/>

                                <TableColumn fx:id="attendanceColumn"
                                             text="Attendance"
                                             prefWidth="120"/>

                                <TableColumn fx:id="overallColumn"
                                             text="Overall KPI"
                                             prefWidth="120"/>

                                <TableColumn fx:id="statusColumn"
                                             text="Status"
                                             prefWidth="130"/>

                                <TableColumn fx:id="calculatedColumn"
                                             text="Calculated At"
                                             prefWidth="170"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- FEEDBACK -->
                    <VBox spacing="12"
                          styleClass="employee-card">

                        <VBox spacing="4">

                            <Label text="Manager Feedback"
                                   styleClass="employee-section-title"/>

                            <Label fx:id="feedbackPeriodLabel"
                                   text=""
                                   styleClass="employee-section-subtitle"/>

                        </VBox>

                        <Label fx:id="feedbackLabel"
                               text="No performance feedback is currently available."
                               wrapText="true"
                               styleClass="employee-field-label"/>

                        <Label fx:id="feedbackDateLabel"
                               text=""
                               styleClass="employee-section-subtitle"/>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>