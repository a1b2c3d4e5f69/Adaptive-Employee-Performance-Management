<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import com.aepm.ui.components.NotificationBell?>
<?import com.aepm.ui.components.EmployeeWelcomeLabel?>
<?import com.aepm.ui.components.EmployeeRoleLabel?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aepm.ui.employee.EmployeeAttendanceController"
            stylesheets="@../../css/app.css"
            styleClass="employee-root">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="employee-topbar">

            <VBox spacing="2">
                <EmployeeWelcomeLabel styleClass="employee-topbar-user-name"/>

                <Label text="Adaptive Employee Performance Management System"
                       styleClass="employee-page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <NotificationBell/>

            <VBox alignment="CENTER_RIGHT" spacing="2">

                <Label fx:id="topNameLabel"
                       text="Employee"
                       styleClass="employee-topbar-user-name"/>

                <EmployeeRoleLabel fx:id="topRoleLabel"
                                   styleClass="employee-topbar-user-position"/>

            </VBox>
        </HBox>
    </top>


    <left>
        <ScrollPane prefWidth="240"
                    minWidth="240"
                    maxWidth="240"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="employee-sidebar-scroll">

            <content>
                <VBox prefWidth="240"
                      spacing="5"
                      styleClass="employee-sidebar">

                    <VBox spacing="2">
                        <Label text="AEPM"
                               styleClass="employee-brand-title"/>
                        <Label text="Adaptive Performance"
                               styleClass="employee-brand-secondary"/>
                    </VBox>

                    <Label text="WORKSPACE"
                           styleClass="employee-sidebar-section"/>

                    <Button text="⌂   Home"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="employee-nav-button"/>

                    <Button text="✓   My Tasks"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTasks"
                            styleClass="employee-nav-button"/>

                    <Button text="◷   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendance"
                            styleClass="employee-nav-button-active"/>

                    <Button text="⌁   My Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpi"
                            styleClass="employee-nav-button"/>

                    <Label text="SUPPORT &amp; GOVERNANCE"
                           styleClass="employee-sidebar-section"/>

                    <Button text="!   Anonymous Report"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReport"
                            styleClass="employee-nav-button"/>

                    <Button text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="employee-nav-button"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>
            </content>
        </ScrollPane>
    </left>


    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="employee-content-scroll">

            <content>
                <VBox spacing="22"
                      styleClass="employee-content">

                    <VBox spacing="5">
                        <Label text="My Attendance"
                               styleClass="employee-page-title"/>

                        <Label text="Scan the daily attendance QR code and review your attendance history."
                               styleClass="employee-page-subtitle"/>
                    </VBox>


                    <!-- TODAY -->
                    <HBox spacing="14">

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-kpi-card">

                            <Label text="CHECK IN"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="checkInLabel"
                                   text="--:--"
                                   styleClass="employee-kpi-value"/>

                            <Label text="Today's check-in time"
                                   styleClass="employee-kpi-note"/>

                        </VBox>


                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS"
                              styleClass="employee-kpi-card">

                            <Label text="CHECK OUT"
                                   styleClass="employee-kpi-title"/>

                            <Label fx:id="checkOutLabel"
                                   text="--:--"
                                   styleClass="employee-kpi-value"/>

                            <Label text="Today's check-out time"
                                   styleClass="employee-kpi-note"/>

                        </VBox>

                    </HBox>


                    <!-- QR SCAN -->
                    <VBox spacing="16"
                          alignment="CENTER"
                          styleClass="employee-card">

                        <Label text="Scan Attendance QR Code"
                               styleClass="employee-section-title"/>

                        <Label text="Use your camera or upload the QR image displayed by the administrator."
                               styleClass="employee-section-subtitle"/>

                        <StackPane prefWidth="420"
                                   prefHeight="260"
                                   minWidth="420"
                                   maxWidth="420"
                                   style="-fx-background-color:#FBFAF6;
                                          -fx-border-color:#E7E7E2;
                                          -fx-border-radius:10;
                                          -fx-background-radius:10;">

                            <ImageView fx:id="cameraPreview"
                                       fitWidth="400"
                                       fitHeight="240"
                                       preserveRatio="true"/>

                            <Label fx:id="cameraPlaceholder"
                                   text="Camera is not started"
                                   styleClass="employee-section-subtitle"/>

                        </StackPane>


                        <Rectangle fx:id="qrScanLine"
                                   width="380"
                                   height="3"
                                   arcWidth="3"
                                   arcHeight="3"
                                   fill="#FFC700"
                                   mouseTransparent="true"
                                   visible="false"/>


                        <HBox spacing="10"
                              alignment="CENTER">

                            <Button fx:id="startCameraButton"
                                    text="Start Camera"
                                    onAction="#handleStartCamera"
                                    styleClass="employee-button-primary"/>

                            <Button fx:id="uploadQrButton"
                                    text="Upload QR Image"
                                    onAction="#handleUploadQrImage"
                                    styleClass="employee-button"/>

                            <Button fx:id="stopCameraButton"
                                    text="Stop Camera"
                                    disable="true"
                                    onAction="#handleStopCamera"
                                    styleClass="employee-button"/>

                        </HBox>


                        <Label fx:id="scanStatusLabel"
                               text="Ready to scan QR Code."
                               wrapText="true"
                               styleClass="employee-section-subtitle"/>


                        <Button fx:id="lateCheckOutButton"
                                text="Check Out After 10 PM"
                                disable="true"
                                onAction="#handleLateCheckOut"
                                styleClass="employee-button"/>

                    </VBox>


                    <!-- HISTORY -->
                    <VBox spacing="14"
                          styleClass="employee-card">

                        <HBox alignment="CENTER_LEFT">

                            <VBox spacing="3"
                                  HBox.hgrow="ALWAYS">

                                <Label text="Attendance History"
                                       styleClass="employee-section-title"/>

                                <Label text="Review your previous attendance and overtime records."
                                       styleClass="employee-section-subtitle"/>

                            </VBox>

                            <Button text="Refresh"
                                    onAction="#handleRefreshHistory"
                                    styleClass="employee-button"/>

                        </HBox>


                        <TableView fx:id="attendanceTable"
                                   prefHeight="300"
                                   styleClass="employee-table">

                            <columns>

                                <TableColumn fx:id="dateColumn"
                                             text="Date"/>

                                <TableColumn fx:id="checkInColumn"
                                             text="Check In"/>

                                <TableColumn fx:id="checkOutColumn"
                                             text="Check Out"/>

                                <TableColumn fx:id="statusColumn"
                                             text="Status"/>

                                <TableColumn fx:id="overtimeColumn"
                                             text="Overtime"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>