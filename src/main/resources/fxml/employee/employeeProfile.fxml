<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.image.ImageView?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.shape.Circle?>

<?import com.aepm.ui.components.NotificationBell?>
<?import com.aepm.ui.components.EmployeeWelcomeLabel?>
<?import com.aepm.ui.components.EmployeeRoleLabel?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.employee.EmployeeProfileController"
        stylesheets="@../../css/app.css"
        styleClass="employee-root">

    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="employee-topbar">

            <VBox spacing="2">

                <EmployeeWelcomeLabel
                        styleClass="employee-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="employee-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <NotificationBell/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Employee"
                        styleClass="employee-topbar-user-name"/>

                <EmployeeRoleLabel
                        fx:id="topRoleLabel"
                        styleClass="employee-topbar-user-position"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="employee-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="employee-sidebar">

                    <!-- BRAND -->
                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="employee-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="employee-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->
                    <Label
                            text="WORKSPACE"
                            styleClass="employee-sidebar-section"/>

                    <Button
                            text="⌂   Dashboard"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="employee-nav-button"/>

                    <Button
                            text="✓   My Tasks"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTasks"
                            styleClass="employee-nav-button"/>

                    <Button
                            text="◷   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendance"
                            styleClass="employee-nav-button"/>

                    <Button
                            text="⌁   My Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpi"
                            styleClass="employee-nav-button"/>


                    <!-- SUPPORT -->
                    <Label
                            text="SUPPORT &amp; GOVERNANCE"
                            styleClass="employee-sidebar-section"/>

                    <Button
                            text="!   Anonymous Report"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReport"
                            styleClass="employee-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="employee-nav-button-active"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="employee-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        styleClass="employee-content">

                    <!-- PAGE HEADER -->
                    <VBox spacing="5">

                        <Label
                                text="My Profile"
                                styleClass="employee-page-title"/>

                        <Label
                                text="View and update your personal and employment information."
                                styleClass="employee-page-subtitle"/>

                    </VBox>


                    <!-- =====================================================
                         PROFILE HEADER CARD
                         ===================================================== -->

                    <HBox
                            spacing="24"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            styleClass="employee-profile-header-card">

                        <!-- AVATAR -->
                        <StackPane
                                prefWidth="104"
                                prefHeight="104"
                                minWidth="104"
                                minHeight="104"
                                maxWidth="104"
                                maxHeight="104">

                            <!-- FALLBACK BACKGROUND -->
                            <Circle
                                    radius="46"
                                    styleClass="employee-profile-avatar-bg"/>


                            <!-- INITIAL -->
                            <Label
                                    fx:id="profileInitialLabel"
                                    text="E"
                                    styleClass="employee-profile-avatar-initial"/>


                            <!-- REAL PROFILE IMAGE -->
                            <ImageView
                                    fx:id="profileImageView"
                                    fitWidth="92"
                                    fitHeight="92"
                                    preserveRatio="false"
                                    smooth="true"
                                    visible="false">

                                <clip>

                                    <Circle
                                            centerX="46"
                                            centerY="46"
                                            radius="46"/>

                                </clip>

                            </ImageView>


                            <!-- EDIT BUTTON -->
                            <Button
                                    fx:id="editImageButton"
                                    text="✎"
                                    onAction="#handleChangeProfileImage"
                                    StackPane.alignment="BOTTOM_RIGHT"
                                    styleClass="employee-profile-edit-button"/>

                        </StackPane>


                        <!-- PROFILE MAIN INFO -->
                        <VBox
                                spacing="6"
                                alignment="CENTER_LEFT"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    fx:id="fullNameLabel"
                                    text="Employee"
                                    styleClass="employee-profile-name"/>


                            <HBox
                                    spacing="8"
                                    alignment="CENTER_LEFT">

                                <Label
                                        text="Employee"
                                        styleClass="employee-profile-role"/>

                                <Label
                                        text="•"
                                        styleClass="employee-profile-meta"/>

                                <Label
                                        fx:id="departmentHeaderLabel"
                                        text="-"
                                        styleClass="employee-profile-meta"/>

                                <Label
                                        text="•"
                                        styleClass="employee-profile-meta"/>

                                <Label
                                        fx:id="employeeHeaderIdLabel"
                                        text="-"
                                        styleClass="employee-profile-meta"/>

                            </HBox>


                            <Label
                                    text="Keep your profile information accurate and up to date."
                                    wrapText="true"
                                    styleClass="employee-profile-description"/>

                        </VBox>


                        <!-- ACCOUNT STATUS -->
                        <VBox
                                spacing="5"
                                alignment="CENTER_LEFT"
                                styleClass="employee-profile-status-box">

                            <Label
                                    text="ACCOUNT STATUS"
                                    styleClass="employee-kpi-title"/>

                            <Label
                                    fx:id="headerAccountStatusLabel"
                                    text="-"
                                    styleClass="employee-profile-status-active"/>

                            <Label
                                    text="Employee account"
                                    styleClass="employee-kpi-note"/>

                        </VBox>

                    </HBox>


                    <!-- =====================================================
                         PERSONAL INFORMATION
                         ===================================================== -->

                    <VBox
                            spacing="18"
                            styleClass="employee-card">

                        <VBox spacing="4">

                            <Label
                                    text="Personal Information"
                                    styleClass="employee-section-title"/>

                            <Label
                                    text="Review your account details and update your contact number when needed."
                                    styleClass="employee-section-subtitle"/>

                        </VBox>


                        <GridPane
                                hgap="36"
                                vgap="20">

                            <columnConstraints>

                                <ColumnConstraints
                                        minWidth="130"/>

                                <ColumnConstraints
                                        prefWidth="280"
                                        hgrow="ALWAYS"/>

                                <ColumnConstraints
                                        minWidth="130"/>

                                <ColumnConstraints
                                        prefWidth="280"
                                        hgrow="ALWAYS"/>

                            </columnConstraints>


                            <!-- STAFF ID -->

                            <Label
                                    text="Staff ID"
                                    styleClass="employee-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="employeeIdLabel"
                                    text="-"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <!-- USERNAME -->

                            <Label
                                    text="Username"
                                    styleClass="employee-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="usernameLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <!-- EMAIL -->

                            <Label
                                    text="Email"
                                    styleClass="employee-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="emailLabel"
                                    text="-"
                                    wrapText="true"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <!-- DEPARTMENT -->

                            <Label
                                    text="Department"
                                    styleClass="employee-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="departmentLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <!-- ROLE -->

                            <Label
                                    text="Role"
                                    styleClass="employee-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="roleLabel"
                                    text="Employee"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <!-- ACCOUNT STATUS -->

                            <Label
                                    text="Account Status"
                                    styleClass="employee-field-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="accountStatusLabel"
                                    text="-"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>


                            <!-- CONTACT NUMBER -->

                            <Label
                                    text="Contact Number"
                                    styleClass="employee-field-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"/>

                            <TextField
                                    fx:id="contactNumberField"
                                    promptText="Enter contact number"
                                    prefWidth="260"
                                    maxWidth="320"
                                    styleClass="employee-input"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>

                        </GridPane>


                        <!-- MESSAGE -->
                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="employee-helper-text"/>


                        <!-- ACTIONS -->
                        <HBox
                                spacing="10"
                                alignment="CENTER_LEFT">

                            <Button
                                    fx:id="saveButton"
                                    text="Save Changes"
                                    onAction="#handleSave"
                                    styleClass="employee-button-primary"/>

                            <Button
                                    text="Change Password"
                                    onAction="#handleChangePassword"
                                    styleClass="employee-button"/>

                        </HBox>

                    </VBox>


                    <!-- Existing controller may still reference this -->
                    <Label
                            fx:id="welcomeLabel"
                            visible="false"
                            managed="false"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>