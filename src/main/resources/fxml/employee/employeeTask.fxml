<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.aepm.ui.components.EmployeeWelcomeLabel?>
<?import com.aepm.ui.components.EmployeeRoleLabel?>
<?import com.aepm.ui.components.NotificationBell?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aepm.ui.employee.EmployeeTaskController"
            styleClass="main-layout">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="topbar">
            <padding>
                <Insets top="16" right="28" bottom="16" left="28"/>
            </padding>
            <VBox spacing="2">
                <EmployeeWelcomeLabel styleClass="topbar-title"/>
                <Label text="Adaptive Employee Performance Management System"
                       styleClass="topbar-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <NotificationBell/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="topNameLabel" text="Employee"
                       styleClass="topbar-user-name"/>
                <EmployeeRoleLabel fx:id="topRoleLabel"
                                   styleClass="topbar-user-role"/>
            </VBox>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="245" minWidth="245" maxWidth="245"
              spacing="8" styleClass="modern-sidebar">
            <padding>
                <Insets top="28" right="18" bottom="20" left="18"/>
            </padding>
            <Label text="MENU" styleClass="modern-sidebar-section"/>
            <Button text="⌂   Home" alignment="CENTER_LEFT"
                    maxWidth="Infinity" onAction="#handleHome"
                    styleClass="modern-nav-button"/>
            <Button text="○   My Profile" alignment="CENTER_LEFT"
                    maxWidth="Infinity" onAction="#handleProfile"
                    styleClass="modern-nav-button"/>
            <Button text="✓   My Tasks" alignment="CENTER_LEFT"
                    maxWidth="Infinity" onAction="#handleTasks"
                    styleClass="modern-nav-button-active"/>
            <Button text="▥   Performance" alignment="CENTER_LEFT"
                    maxWidth="Infinity" onAction="#handleKpi"
                    styleClass="modern-nav-button"/>
            <Button text="▦   My Attendance" alignment="CENTER_LEFT"
                    maxWidth="Infinity" onAction="#handleAttendance"
                    styleClass="modern-nav-button"/>
            <Button text="▤   Reports" alignment="CENTER_LEFT"
                    maxWidth="Infinity" onAction="#handleReports"
                    styleClass="modern-nav-button"/>
            <Button text="!   Anonymous Report" alignment="CENTER_LEFT"
                    maxWidth="Infinity" onAction="#handleAnonymousReport"
                    styleClass="modern-nav-button"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="↪   Logout" alignment="CENTER_LEFT"
                    maxWidth="Infinity" onAction="#handleLogout"
                    styleClass="modern-logout-button"/>
        </VBox>
    </left>

    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="modern-content-scroll">

            <content>

                <VBox
                        spacing="24"
                        maxWidth="Infinity"
                        styleClass="modern-content">

                    <padding>
                        <Insets
                                top="30"
                                right="32"
                                bottom="40"
                                left="32"/>
                    </padding>


                    <!-- PAGE HEADER -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="20"
                            maxWidth="Infinity">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="My Tasks"
                                    styleClass="modern-page-title"/>

                            <Label
                                    text="View and manage tasks assigned to you."
                                    styleClass="modern-page-subtitle"/>

                        </VBox>

                        <Button
                                text="↻  Refresh"
                                onAction="#handleRefresh"
                                styleClass="modern-primary-button"/>

                    </HBox>


                    <!-- =================================================
                         TASK LIST
                         ================================================= -->

                    <VBox
                            spacing="18"
                            maxWidth="Infinity"
                            styleClass="modern-card">

                        <padding>
                            <Insets
                                    top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>
                        </padding>


                        <VBox spacing="4">

                            <Label
                                    text="Assigned Tasks"
                                    styleClass="modern-section-title"/>

                            <Label
                                    text="Select a task to view its details and available actions."
                                    styleClass="modern-page-subtitle"/>

                        </VBox>


                        <!-- FILTER -->

                        <HBox
                                spacing="14"
                                alignment="CENTER_LEFT"
                                maxWidth="Infinity">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search by task name..."
                                    prefWidth="360"/>

                            <DatePicker
                                    fx:id="dueDateFilterPicker"
                                    promptText="Filter by due date"
                                    prefWidth="230"/>

                            <Button
                                    text="Clear"
                                    onAction="#handleClearFilter"
                                    styleClass="app-button"/>

                        </HBox>


                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                maxWidth="Infinity"
                                styleClass="modern-message"/>


                        <!-- TASK TABLE -->

                        <TableView
                                fx:id="taskTable"
                                prefHeight="420"
                                minHeight="380"
                                maxWidth="Infinity"
                                styleClass="clean-task-table">

                            <columns>

                                <TableColumn
                                        fx:id="titleColumn"
                                        text="Task"
                                        prefWidth="230"/>

                                <TableColumn
                                        fx:id="categoryColumn"
                                        text="Category"
                                        prefWidth="145"/>

                                <TableColumn
                                        fx:id="priorityColumn"
                                        text="Priority"
                                        prefWidth="115"/>

                                <TableColumn
                                        fx:id="difficultyColumn"
                                        text="Difficulty"
                                        prefWidth="125"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="145"/>

                                <TableColumn
                                        fx:id="progressColumn"
                                        text="Progress"
                                        prefWidth="110"/>

                                <TableColumn
                                        fx:id="dueDateColumn"
                                        text="Due Date"
                                        prefWidth="190"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <Region prefHeight="10"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>