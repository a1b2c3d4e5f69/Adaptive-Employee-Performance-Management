<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.aepm.ui.components.EmployeeWelcomeLabel?>
<?import com.aepm.ui.components.EmployeeRoleLabel?>
<?import com.aepm.ui.components.NotificationBell?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.employee.EmployeeTaskController"
        stylesheets="@../../css/app.css"
        styleClass="employee-root">

    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="employee-topbar">

            <VBox spacing="2">

                <EmployeeWelcomeLabel
                        styleClass="employee-topbar-user-name"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="employee-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <NotificationBell/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Employee"
                        styleClass="employee-topbar-user-name"/>

                <EmployeeRoleLabel
                        fx:id="topRoleLabel"
                        styleClass="employee-topbar-user-position"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <ScrollPane
                prefWidth="240"
                minWidth="240"
                maxWidth="240"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="employee-sidebar-scroll">

            <content>

                <VBox
                        prefWidth="240"
                        spacing="5"
                        styleClass="employee-sidebar">

                    <!-- BRAND -->
                    <VBox spacing="2">

                        <Label
                                text="AEPM"
                                styleClass="employee-brand-title"/>

                        <Label
                                text="Adaptive Performance"
                                styleClass="employee-brand-secondary"/>

                    </VBox>


                    <!-- WORKSPACE -->
                    <Label
                            text="WORKSPACE"
                            styleClass="employee-sidebar-section"/>

                    <Button
                            text="⌂   Home"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleHome"
                            styleClass="employee-nav-button"/>

                    <Button
                            text="✓   My Tasks"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleTasks"
                            styleClass="employee-nav-button-active"/>

                    <Button
                            text="◷   Attendance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAttendance"
                            styleClass="employee-nav-button"/>

                    <Button
                            text="⌁   My Performance"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleKpi"
                            styleClass="employee-nav-button"/>

                    <!-- SUPPORT -->
                    <Label
                            text="SUPPORT &amp; GOVERNANCE"
                            styleClass="employee-sidebar-section"/>

                    <Button
                            text="!   Anonymous Report"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleAnonymousReport"
                            styleClass="employee-nav-button"/>

                    <Button
                            text="○   My Profile"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleProfile"
                            styleClass="employee-nav-button"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button
                            text="↪   Logout"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#handleLogout"
                            styleClass="logout-button"/>

                </VBox>

            </content>

        </ScrollPane>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="employee-content-scroll">

            <content>

                <VBox
                        spacing="22"
                        maxWidth="Infinity"
                        styleClass="employee-content">

                    <!-- PAGE HEADER -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="16">

                        <VBox
                                spacing="5"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="My Tasks"
                                    styleClass="employee-page-title"/>

                            <Label
                                    text="Manage assigned work and organize your personal daily priorities."
                                    styleClass="employee-page-subtitle"/>

                        </VBox>

                        <Button
                                text="Refresh"
                                onAction="#handleRefresh"
                                styleClass="employee-button"/>

                    </HBox>


                    <!-- =====================================================
                         TASK TYPE SWITCH
                         ===================================================== -->

                    <HBox
                            spacing="8"
                            alignment="CENTER_LEFT">

                        <Button
                                text="Assigned Tasks"
                                styleClass="employee-button-primary"/>

                        <Button
                                text="My Daily Tasks"
                                onAction="#handleDailyTasks"
                                styleClass="employee-button"/>

                    </HBox>


                    <!-- =====================================================
                         ASSIGNED TASK CARD
                         ===================================================== -->

                    <VBox
                            spacing="18"
                            maxWidth="Infinity"
                            styleClass="employee-card">

                        <VBox spacing="4">

                            <Label
                                    text="Assigned Tasks"
                                    styleClass="employee-section-title"/>

                            <Label
                                    text="Tasks assigned by your manager. Select a task to view its details and available actions."
                                    styleClass="employee-section-subtitle"/>

                        </VBox>


                        <!-- FILTER -->

                        <HBox
                                spacing="12"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search tasks..."
                                    prefWidth="340"
                                    styleClass="employee-input"/>

                            <DatePicker
                                    fx:id="dueDateFilterPicker"
                                    promptText="Due date"
                                    prefWidth="190"
                                    styleClass="employee-date-picker"/>

                            <Button
                                    text="Clear Filters"
                                    onAction="#handleClearFilter"
                                    styleClass="employee-button"/>

                        </HBox>


                        <!-- MESSAGE -->

                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                maxWidth="Infinity"
                                styleClass="employee-helper-text"/>


                        <!-- TABLE -->

                        <TableView
                                fx:id="taskTable"
                                prefHeight="520"
                                minHeight="430"
                                maxWidth="Infinity"
                                styleClass="employee-table">

                            <columns>

                                <TableColumn
                                        fx:id="titleColumn"
                                        text="Task"
                                        prefWidth="250"/>

                                <TableColumn
                                        fx:id="categoryColumn"
                                        text="Category"
                                        prefWidth="140"/>

                                <TableColumn
                                        fx:id="priorityColumn"
                                        text="Priority"
                                        prefWidth="110"/>

                                <TableColumn
                                        fx:id="difficultyColumn"
                                        text="Difficulty"
                                        prefWidth="120"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="140"/>

                                <TableColumn
                                        fx:id="progressColumn"
                                        text="Progress"
                                        prefWidth="110"/>

                                <TableColumn
                                        fx:id="dueDateColumn"
                                        text="Due Date"
                                        prefWidth="180"/>

                            </columns>

                            <placeholder>

                                <VBox
                                        alignment="CENTER"
                                        spacing="6">

                                    <Label
                                            text="No assigned tasks"
                                            styleClass="employee-empty-title"/>

                                    <Label
                                            text="Tasks assigned by your manager will appear here."
                                            styleClass="employee-empty-description"/>

                                </VBox>

                            </placeholder>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>