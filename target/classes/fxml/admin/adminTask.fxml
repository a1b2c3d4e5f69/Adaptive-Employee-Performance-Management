<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminTaskController"
        styleClass="main-layout">


    <!-- TOP BAR -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>


            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- SIDEBAR -->

    <left>
        
        <ScrollPane
        prefWidth="294"
        minWidth="294"
        maxWidth="294"
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        style="-fx-background-color: white; -fx-background: white;">

                <VBox
                        prefWidth="240"
                        spacing="10"
                        styleClass="sidebar">

                <padding>
                        <Insets
                                top="30"
                                right="18"
                                bottom="20"
                                left="18"/>
                </padding>


                <VBox spacing="3">

                        <Label
                                text="AEPM"
                                styleClass="sidebar-logo"/>

                        <Label
                                text="Administrator Portal"
                                styleClass="sidebar-subtitle"/>

                </VBox>


                <Region prefHeight="18"/>


                <Label
                        text="MENU"
                        styleClass="sidebar-section-title"/>


                <Button
                        text="⌂   Home"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleHome"
                        styleClass="sidebar-button"/>

                <Button
                        text="●   My Profile"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleProfile"
                        styleClass="sidebar-button"/>

                <Button
                        text="♟   User Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleUserManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="✓   Task Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleTaskManagement"
                        styleClass="sidebar-button-active"/>
                <Button
                        text="◷   Escalation Rules"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleEscalationRules"
                        styleClass="sidebar-button"/>

                <Button
                        text="★   KPI Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleKpiManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="⚙   System Configuration"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleSystemConfiguration"
                        styleClass="sidebar-button"/>
                <Button
                    text="✉   Notification/Announcements"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleAnnouncements"
                    styleClass="sidebar-button"/>                        
                <Button
                        text="✦   AI Recommendation"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAIConfiguration"
                        styleClass="sidebar-button"/>

                <Button
                        text="▦   Attendance Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAttendanceManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="≡   Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleReports"
                        styleClass="sidebar-button"/>

                <Button
                        text="!   Anonymous Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAnonymousReports"
                        styleClass="sidebar-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button
                        text="↪   Logout"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleLogout"
                        styleClass="logout-button"/>
                </VBox>
        </ScrollPane>
    </left>


    <!-- CONTENT -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="content-scroll-pane">

            <content>

                <VBox
                        spacing="22"
                        styleClass="home-content">

                    <padding>
                        <Insets
                                top="32"
                                right="35"
                                bottom="40"
                                left="35"/>
                    </padding>


                    <!-- PAGE HEADER -->

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="4">

                            <Label
                                    text="Task Management"
                                    styleClass="content-title"/>

                            <Label
                                    text="Monitor tasks across the organisation."
                                    styleClass="content-description"/>

                        </VBox>


                        <Region HBox.hgrow="ALWAYS"/>


                        <HBox spacing="12">
                        
                        <Button
                            text="Manage Categories"
                            onAction="#handleManageCategories"
                            styleClass="app-button"/>

                        <Button
                            text="Progressive Rules"
                            onAction="#handleProgressiveRules"
                            styleClass="app-button"/>

                        <Button
                            text="Refresh"
                            onAction="#handleRefresh"
                            styleClass="app-button"/>

                    </HBox>

                    </HBox>


                    <!-- ALL TASKS -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">

                        <Label
                                text="All Tasks"
                                styleClass="section-title"/>


                        <!-- SEARCH -->

                        <HBox
                                spacing="12"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search task name..."
                                    prefWidth="280"/>


                            <DatePicker
                                    fx:id="dueDateFilterPicker"
                                    promptText="Due date"
                                    prefWidth="175"/>


                            <Button
                                    text="Clear Filters"
                                    onAction="#handleClearFilters"
                                    styleClass="app-button"/>

                        </HBox>


                        <!-- FILTERS -->

                        <HBox
                                spacing="12"
                                alignment="CENTER_LEFT">

                            <ComboBox
                                    fx:id="employeeFilterComboBox"
                                    promptText="All Employees"
                                    prefWidth="205"/>


                            <ComboBox
                                    fx:id="managerFilterComboBox"
                                    promptText="All Managers"
                                    prefWidth="205"/>


                            <ComboBox
                                    fx:id="categoryFilterComboBox"
                                    promptText="All Categories"
                                    prefWidth="170"/>


                            <ComboBox
                                    fx:id="statusFilterComboBox"
                                    promptText="All Status"
                                    prefWidth="160"/>

                        </HBox>


                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="content-description"/>


                        <!-- TABLE -->

                        <TableView
                                fx:id="taskTable"
                                prefHeight="360"
                                minHeight="320">

                            <columns>

                                <TableColumn
                                        fx:id="titleColumn"
                                        text="Task"
                                        prefWidth="140"/>


                                <TableColumn
                                        fx:id="categoryColumn"
                                        text="Category"
                                        prefWidth="100"/>


                                <TableColumn
                                        fx:id="employeeColumn"
                                        text="Employee"
                                        prefWidth="145"/>


                                <TableColumn
                                        fx:id="managerColumn"
                                        text="Manager"
                                        prefWidth="145"/>


                                <TableColumn
                                        fx:id="priorityColumn"
                                        text="Priority"
                                        prefWidth="75"/>


                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="100"/>


                                <TableColumn
                                        fx:id="progressColumn"
                                        text="Progress"
                                        prefWidth="80"/>


                                <TableColumn
                                        fx:id="dueDateColumn"
                                        text="Due Date"
                                        prefWidth="145"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- SELECTED TASK DETAILS -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">

                        <Label
                                text="Task Details"
                                styleClass="section-title"/>


                        <GridPane
                                hgap="30"
                                vgap="14">


                            <Label
                                    text="Task"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="selectedTaskLabel"
                                    text="No task selected"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Category"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="selectedCategoryLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Employee"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="selectedEmployeeLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Manager"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="selectedManagerLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Priority"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="selectedPriorityLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Difficulty"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="selectedDifficultyLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Status"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"/>

                            <Label
                                    fx:id="selectedStatusLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>


                            <Label
                                    text="Progress"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="3"/>

                            <Label
                                    fx:id="selectedProgressLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="3"/>


                            <Label
                                    text="Assigned Date"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="4"/>

                            <Label
                                    fx:id="selectedAssignedDateLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="4"/>


                            <Label
                                    text="Due Date"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="4"/>

                            <Label
                                    fx:id="selectedDueDateLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="4"/>

                        </GridPane>


                        <VBox spacing="6">

                            <Label
                                    text="Description"
                                    styleClass="input-label"/>

                            <Label
                                    fx:id="selectedDescriptionLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="task-detail-description"/>

                        </VBox>


                        <VBox spacing="6">

                            <Label
                                    text="Completion Criteria"
                                    styleClass="input-label"/>

                            <Label
                                    fx:id="selectedCriteriaLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="task-detail-description"/>

                        </VBox>

                    </VBox>


                    <!-- PROGRESS HISTORY -->

                    <VBox
                            spacing="14"
                            styleClass="section-card">

                        <Label
                                text="Progress History"
                                styleClass="section-title"/>


                        <Label
                                fx:id="historyMessageLabel"
                                text="Select a task to view progress history."
                                styleClass="content-description"/>


                        <TableView
                                fx:id="historyTable"
                                prefHeight="220">

                            <columns>

                                <TableColumn
                                        fx:id="historyProgressColumn"
                                        text="Progress"
                                        prefWidth="100"/>


                                <TableColumn
                                        fx:id="historyNoteColumn"
                                        text="Progress Note"
                                        prefWidth="520"/>


                                <TableColumn
                                        fx:id="historyDateColumn"
                                        text="Updated At"
                                        prefWidth="190"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <Region prefHeight="15"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>