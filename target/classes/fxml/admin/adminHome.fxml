<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>
<?import com.aepm.ui.components.NotificationBell?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminHomeController"
        styleClass="main-layout">


    <!-- TOP BAR -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>


            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>


        <Region HBox.hgrow="ALWAYS"/>

                <!-- Notification Bell -->
                <NotificationBell/>

            <VBox
                alignment="CENTER_RIGHT"
                spacing="2">    

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- SIDEBAR -->

    <left>
        <ScrollPane
        prefWidth="294"
        minWidth="294"
        maxWidth="294"
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        style="-fx-background-color: white; -fx-background: white;">
                <VBox
                        prefWidth="240"
                        spacing="10"
                        styleClass="sidebar">

                <padding>
                        <Insets
                                top="30"
                                right="18"
                                bottom="20"
                                left="18"/>
                </padding>


                <VBox spacing="3">

                        <Label
                                text="AEPM"
                                styleClass="sidebar-logo"/>

                        <Label
                                text="Administrator Portal"
                                styleClass="sidebar-subtitle"/>

                </VBox>


                <Region prefHeight="18"/>


                <Label
                        text="MENU"
                        styleClass="sidebar-section-title"/>


                <Button
                        text="⌂   Home"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleHome"
                        styleClass="sidebar-button-active"/>

                <Button
                        text="●   My Profile"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleProfile"
                        styleClass="sidebar-button"/>

                <Button
                        text="♟   User Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleUserManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="✓   Task Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleTaskManagement"
                        styleClass="sidebar-button"/>
                <Button
                        text="◷   Escalation Rules"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleEscalationRules"
                        styleClass="sidebar-button"/>

                <Button
                        text="★   KPI Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleKpiManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="⚙   System Configuration"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleSystemConfiguration"
                        styleClass="sidebar-button"/>

                <Button
                        text="▦   Attendance Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAttendanceManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="≡   Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleReports"
                        styleClass="sidebar-button"/>

                <Button
                        text="!   Anonymous Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAnonymousReports"
                        styleClass="sidebar-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button
                        text="↪   Logout"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleLogout"
                        styleClass="logout-button"/>

                </VBox>
        </ScrollPane>

    </left>


    <!-- CONTENT -->

    <center>

        <VBox
                spacing="24"
                styleClass="home-content">

            <padding>
                <Insets
                        top="32"
                        right="35"
                        bottom="35"
                        left="35"/>
            </padding>


            <VBox spacing="4">

                <Label
                        text="Administrator Home"
                        styleClass="content-title"/>

                <Label
                        text="Manage users and system functions from here."
                        styleClass="content-description"/>

            </VBox>


            <HBox spacing="22">


                <!-- IAM -->

                <VBox
                        spacing="10"
                        styleClass="dashboard-card"
                        HBox.hgrow="ALWAYS">

                    <Label
                            text="IAM"
                            styleClass="card-label"/>

                    <Label
                            text="User Management"
                            styleClass="card-title"/>

                    <Label
                            text="Manage employee and manager accounts."
                            styleClass="content-description"/>

                    <Button
                            text="Manage Users"
                            onAction="#handleUserManagement"
                            styleClass="app-button"/>

                </VBox>


                <!-- TASK -->

                <VBox
                        spacing="10"
                        styleClass="dashboard-card"
                        HBox.hgrow="ALWAYS">

                    <Label
                            text="TASK"
                            styleClass="card-label"/>

                    <Label
                            text="Task Management"
                            styleClass="card-title"/>

                    <Label
                            text="Monitor tasks across the organisation."
                            styleClass="content-description"/>

                    <Button
                            text="View Tasks"
                            onAction="#handleTaskManagement"
                            styleClass="app-button"/>

                </VBox>


                <!-- KPI -->

                <VBox
                        spacing="10"
                        styleClass="dashboard-card"
                        HBox.hgrow="ALWAYS">

                    <Label
                            text="KPI"
                            styleClass="card-label"/>

                    <Label
                            text="Performance KPI"
                            styleClass="card-title"/>

                    <Label
                            text="KPI configuration will be added later."
                            styleClass="content-description"/>

                </VBox>

            </HBox>

        </VBox>

    </center>

</BorderPane>