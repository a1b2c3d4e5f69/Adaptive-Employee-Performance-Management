<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminTaskDependencyController"
        styleClass="main-layout">

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <left>
        
        <ScrollPane
        prefWidth="294"
        minWidth="294"
        maxWidth="294"
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        style="-fx-background-color: white; -fx-background: white;">


                <VBox
                        prefWidth="240"
                        spacing="10"
                        styleClass="sidebar">

                <padding>
                        <Insets
                                top="30"
                                right="18"
                                bottom="20"
                                left="18"/>
                </padding>

                <VBox spacing="3">

                        <Label
                                text="AEPM"
                                styleClass="sidebar-logo"/>

                        <Label
                                text="Administrator Portal"
                                styleClass="sidebar-subtitle"/>

                </VBox>

                <Region prefHeight="18"/>

                <Label
                        text="MENU"
                        styleClass="sidebar-section-title"/>

                <Button
                        text="⌂   Home"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleHome"
                        styleClass="sidebar-button"/>

                <Button
                        text="●   My Profile"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleProfile"
                        styleClass="sidebar-button"/>

                <Button
                        text="♟   User Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleUserManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="✓   Task Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleTaskManagement"
                        styleClass="sidebar-button-active"/>
                <Button
                        text="◷   Escalation Rules"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleEscalationRules"
                        styleClass="sidebar-button"/>

                <Button
                        text="★   KPI Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleKpiManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="⚙   System Configuration"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleSystemConfiguration"
                        styleClass="sidebar-button"/>

                <Button
                        text="▦   Attendance Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAttendanceManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="≡   Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleReports"
                        styleClass="sidebar-button"/>

                <Button
                        text="!   Anonymous Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAnonymousReports"
                        styleClass="sidebar-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button
                        text="↪   Logout"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleLogout"
                        styleClass="logout-button"/>

                </VBox>
        </ScrollPane>
    </left>


    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="content-scroll-pane">

            <content>

                <VBox
                        spacing="22"
                        styleClass="home-content">

                    <padding>
                        <Insets
                                top="32"
                                right="35"
                                bottom="40"
                                left="35"/>
                    </padding>


                    <!-- HEADER -->

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="4">

                            <Label
                                    text="Progressive Task Rules"
                                    styleClass="content-title"/>

                            <Label
                                    text="Configure task dependencies and progressive task unlocking."
                                    styleClass="content-description"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button
                                text="Back"
                                onAction="#handleBack"
                                styleClass="app-button"/>

                    </HBox>


                    <!-- RULE LIST -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                    text="Dependency Rules"
                                    styleClass="section-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button
                                    text="New Rule"
                                    onAction="#handleNewRule"
                                    styleClass="app-button"/>

                        </HBox>


                        <HBox
                                spacing="12"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search task rules..."
                                    prefWidth="340"/>

                            <Button
                                    text="Refresh"
                                    onAction="#handleRefresh"
                                    styleClass="app-button"/>

                        </HBox>


                        <TableView
                                fx:id="dependencyTable"
                                prefHeight="320"
                                minHeight="280">

                            <columns>

                                <TableColumn
                                        fx:id="prerequisiteColumn"
                                        text="Prerequisite Task"
                                        prefWidth="320"/>

                                <TableColumn
                                        fx:id="nextTaskColumn"
                                        text="Next Task"
                                        prefWidth="320"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="130"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- RULE DETAILS -->

                    <VBox
                            spacing="18"
                            styleClass="section-card">

                        <Label
                                text="Rule Details"
                                styleClass="section-title"/>


                        <GridPane
                                hgap="30"
                                vgap="18">

                            <Label
                                    text="Prerequisite Task"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <ComboBox
                                    fx:id="prerequisiteComboBox"
                                    prefWidth="350"
                                    promptText="Select prerequisite task"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Next Task"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <ComboBox
                                    fx:id="nextTaskComboBox"
                                    prefWidth="350"
                                    promptText="Select next task"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>

                        </GridPane>


                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"/>


                        <HBox spacing="12">

                            <Button
                                    fx:id="createButton"
                                    text="Create Rule"
                                    onAction="#handleCreateRule"
                                    styleClass="app-button"/>

                            <Button
                                    fx:id="statusButton"
                                    text="Deactivate"
                                    onAction="#handleToggleStatus"
                                    styleClass="app-button"/>

                            <Button
                                    fx:id="deleteButton"
                                    text="Delete Rule"
                                    onAction="#handleDeleteRule"
                                    styleClass="app-button"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>