<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.admin.AdminTaskCategoryController"
        styleClass="main-layout">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>


            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Administrator"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Administrator"
                        styleClass="topbar-user-name"/>

                <Label
                        text="ADMINISTRATOR"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>
        
        <ScrollPane
        prefWidth="294"
        minWidth="294"
        maxWidth="294"
        fitToWidth="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        style="-fx-background-color: white; -fx-background: white;">

                <VBox
                        prefWidth="240"
                        spacing="10"
                        styleClass="sidebar">

                <padding>
                        <Insets
                                top="30"
                                right="18"
                                bottom="20"
                                left="18"/>
                </padding>


                <VBox spacing="3">

                        <Label
                                text="AEPM"
                                styleClass="sidebar-logo"/>

                        <Label
                                text="Administrator Portal"
                                styleClass="sidebar-subtitle"/>

                </VBox>


                <Region prefHeight="18"/>


                <Label
                        text="MENU"
                        styleClass="sidebar-section-title"/>


                <Button
                        text="⌂   Home"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleHome"
                        styleClass="sidebar-button"/>

                <Button
                        text="●   My Profile"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleProfile"
                        styleClass="sidebar-button"/>

                <Button
                        text="♟   User Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleUserManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="✓   Task Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleTaskManagement"
                        styleClass="sidebar-button-active"/>
                <Button
                        text="◷   Escalation Rules"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleEscalationRules"
                        styleClass="sidebar-button"/>

                <Button
                        text="★   KPI Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleKpiManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="⚙   System Configuration"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleSystemConfiguration"
                        styleClass="sidebar-button"/>

                <Button
                        text="✦   AI Recommendation"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAIConfiguration"
                        styleClass="sidebar-button"/>

                <Button
                        text="▦   Attendance Management"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAttendanceManagement"
                        styleClass="sidebar-button"/>

                <Button
                        text="≡   Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleReports"
                        styleClass="sidebar-button"/>

                <Button
                        text="!   Anonymous Reports"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleAnonymousReports"
                        styleClass="sidebar-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button
                        text="↪   Logout"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#handleLogout"
                        styleClass="logout-button"/>

                </VBox>
        </ScrollPane>
    </left>


    <!-- =====================================================
         CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="content-scroll-pane">

            <content>

                <VBox
                        spacing="22"
                        styleClass="home-content">

                    <padding>
                        <Insets
                                top="32"
                                right="35"
                                bottom="40"
                                left="35"/>
                    </padding>


                    <!-- HEADER -->

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="4">

                            <Label
                                    text="Task Category Management"
                                    styleClass="content-title"/>

                            <Label
                                    text="Create and manage task categories used by managers."
                                    styleClass="content-description"/>

                        </VBox>


                        <Region HBox.hgrow="ALWAYS"/>


                        <Button
                                text="Back"
                                onAction="#handleBack"
                                styleClass="app-button"/>

                    </HBox>


                    <!-- CATEGORY LIST -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                    text="Category List"
                                    styleClass="section-title"/>


                            <Region HBox.hgrow="ALWAYS"/>


                            <Button
                                    text="New Category"
                                    onAction="#handleNewCategory"
                                    styleClass="app-button"/>

                        </HBox>


                        <HBox
                                spacing="12"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search categories..."
                                    prefWidth="320"/>


                            <Button
                                    text="Refresh"
                                    onAction="#loadCategories"
                                    styleClass="app-button"/>

                        </HBox>


                        <TableView
                                fx:id="categoryTable"
                                prefHeight="300"
                                minHeight="260">

                            <columns>

                                <TableColumn
                                        fx:id="idColumn"
                                        text="ID"
                                        prefWidth="70"/>


                                <TableColumn
                                        fx:id="nameColumn"
                                        text="Category Name"
                                        prefWidth="200"/>


                                <TableColumn
                                        fx:id="descriptionColumn"
                                        text="Description"
                                        prefWidth="450"/>


                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="130"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- CATEGORY DETAILS -->

                    <VBox
                            spacing="18"
                            styleClass="section-card">

                        <Label
                                text="Category Details"
                                styleClass="section-title"/>


                        <GridPane
                                hgap="28"
                                vgap="18">


                            <Label
                                    text="Category Name"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>


                            <TextField
                                    fx:id="categoryNameField"
                                    promptText="Enter category name"
                                    prefWidth="320"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Status"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>


                            <ComboBox
                                    fx:id="statusComboBox"
                                    prefWidth="200"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>

                        </GridPane>


                        <VBox spacing="7">

                            <Label
                                    text="Description"
                                    styleClass="input-label"/>


                            <TextArea
                                    fx:id="descriptionArea"
                                    promptText="Enter category description..."
                                    prefRowCount="4"
                                    wrapText="true"/>

                        </VBox>


                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"/>


                        <!-- ALL BUTTONS SAME GLOBAL STYLE -->

                        <HBox spacing="12">

                            <Button
                                    fx:id="createButton"
                                    text="Create Category"
                                    onAction="#handleCreateCategory"
                                    styleClass="app-button"/>


                            <Button
                                    fx:id="saveButton"
                                    text="Save Changes"
                                    onAction="#handleSaveChanges"
                                    styleClass="app-button"/>


                            <Button
                                    fx:id="statusButton"
                                    text="Deactivate"
                                    onAction="#handleToggleStatus"
                                    styleClass="app-button"/>


                            <Button
                                    fx:id="deleteButton"
                                    text="Delete Category"
                                    onAction="#handleDeleteCategory"
                                    styleClass="app-button"/>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>