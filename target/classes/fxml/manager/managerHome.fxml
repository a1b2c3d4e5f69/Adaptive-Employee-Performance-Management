<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.aepm.ui.components.NotificationBell?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerHomeController"
        styleClass="main-layout">


    <!-- =====================================================
         TOP BAR
         EXACT SAME STYLE AS EMPLOYEE
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>


            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Manager"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>
            <NotificationBell fx:id="notificationBell"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="topbar-user-name"/>

                <Label
                        text="MANAGER"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         EXACT SAME STYLE AS EMPLOYEE
         ===================================================== -->

    <left>

        <VBox
                prefWidth="240"
                spacing="10"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="30"
                        right="18"
                        bottom="20"
                        left="18"/>
            </padding>


            <!-- LOGO -->

            <VBox spacing="3">

                <Label
                        text="AEPM"
                        styleClass="sidebar-logo"/>

                <Label
                        text="Manager Portal"
                        styleClass="sidebar-subtitle"/>

            </VBox>


            <Region prefHeight="18"/>


            <!-- MENU TITLE -->

            <Label
                    text="MENU"
                    styleClass="sidebar-section-title"/>


            <!-- HOME ACTIVE -->

            <Button
                    text="⌂   Home"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleHome"
                    styleClass="sidebar-button-active"/>


            <!-- PROFILE -->

            <Button
                    text="●   My Profile"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleProfile"
                    styleClass="sidebar-button"/>


            <!-- TASK -->

            <Button
                    text="✓   Task Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleTaskManagement"
                    styleClass="sidebar-button"/>


            <!-- PERFORMANCE -->

            <Button
                    text="★   Performance"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handlePerformance"
                    styleClass="sidebar-button"/>


            <!-- REPORTS -->

            <Button
                    text="≡   Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleReports"
                    styleClass="sidebar-button"/>


            <!-- DASHBOARD -->

            <Button
                    text="▣   Dashboard"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleDashboard"
                    styleClass="sidebar-button"/>


            <Region VBox.vgrow="ALWAYS"/>


            <!-- LOGOUT -->

            <Button
                    text="↪   Logout"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <!-- =====================================================
         HOME CONTENT
         ===================================================== -->

    <center>

        <VBox
                spacing="24"
                styleClass="home-content">

            <padding>
                <Insets
                        top="32"
                        right="35"
                        bottom="35"
                        left="35"/>
            </padding>


            <!-- TITLE -->

            <VBox spacing="4">

                <Label
                        text="Home"
                        styleClass="content-title"/>

                <Label
                        text="Welcome to the Adaptive Employee Performance Management System."
                        styleClass="content-description"/>

            </VBox>


            <!-- INFORMATION CARDS -->

            <HBox spacing="18">


                <!-- ACCOUNT -->

                <VBox
                        spacing="9"
                        HBox.hgrow="ALWAYS"
                        styleClass="info-card">

                    <Label
                            text="Manager"
                            styleClass="card-label"/>

                    <Label
                            text="Your Account"
                            styleClass="card-title"/>

                    <Label
                            text="View and manage your manager information."
                            styleClass="card-description"/>

                </VBox>


                <!-- DEPARTMENT -->

                <VBox
                        spacing="9"
                        HBox.hgrow="ALWAYS"
                        styleClass="info-card">

                    <Label
                            text="Department"
                            styleClass="card-label"/>

                    <Label
                            fx:id="departmentLabel"
                            text="-"
                            styleClass="card-value"/>

                    <Label
                            text="Your assigned department."
                            styleClass="card-description"/>

                </VBox>


                <!-- ROLE -->

                <VBox
                        spacing="9"
                        HBox.hgrow="ALWAYS"
                        styleClass="info-card">

                    <Label
                            text="Role"
                            styleClass="card-label"/>

                    <Label
                            fx:id="roleLabel"
                            text="Manager"
                            styleClass="card-value"/>

                    <Label
                            text="Manager system access."
                            styleClass="card-description"/>

                </VBox>

            </HBox>


            <!-- QUICK ACCESS -->

            <VBox
                    spacing="16"
                    styleClass="section-card">

                <Label
                        text="Quick Access"
                        styleClass="section-title"/>


                <HBox spacing="12">

                    <Button
                            text="My Profile"
                            onAction="#handleProfile"
                            styleClass="quick-button"/>

                    <Button
                            text="Task Management"
                            onAction="#handleTaskManagement"
                            styleClass="quick-button"/>

                    <Button
                            text="Performance"
                            onAction="#handlePerformance"
                            styleClass="quick-button"/>

                    <Button
                            text="Reports"
                            onAction="#handleReports"
                            styleClass="quick-button"/>

                </HBox>

            </VBox>


            <!-- DASHBOARD -->

            <VBox
                    spacing="8"
                    styleClass="dashboard-placeholder">

                <Label
                        text="Dashboard"
                        styleClass="section-title"/>

                <Label
                        text="Dashboard information will be integrated here later."
                        styleClass="content-description"/>

            </VBox>

        </VBox>

    </center>

</BorderPane>