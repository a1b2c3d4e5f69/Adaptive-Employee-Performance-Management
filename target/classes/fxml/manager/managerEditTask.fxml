<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerEditTaskController"
        styleClass="main-layout">


    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Manager"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="topbar-user-name"/>

                <Label
                        text="MANAGER"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <left>

        <VBox
                prefWidth="240"
                spacing="10"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="30"
                        right="18"
                        bottom="20"
                        left="18"/>
            </padding>

            <VBox spacing="3">

                <Label
                        text="AEPM"
                        styleClass="sidebar-logo"/>

                <Label
                        text="Manager Portal"
                        styleClass="sidebar-subtitle"/>

            </VBox>

            <Region prefHeight="18"/>

            <Label
                    text="MENU"
                    styleClass="sidebar-section-title"/>

            <Button
                    text="⌂   Home"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleHome"
                    styleClass="sidebar-button"/>

            <Button
                    text="●   My Profile"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleProfile"
                    styleClass="sidebar-button"/>

            <Button
                    text="✓   Task Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleTaskManagement"
                    styleClass="sidebar-button-active"/>

            <Button
                    text="★   Performance"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handlePerformance"
                    styleClass="sidebar-button"/>

            <Button
                    text="≡   Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleReports"
                    styleClass="sidebar-button"/>

            <Button
                    text="▣   Dashboard"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleDashboard"
                    styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button
                    text="↪   Logout"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <center>

        <VBox
                spacing="22"
                styleClass="home-content">

            <padding>
                <Insets
                        top="32"
                        right="35"
                        bottom="35"
                        left="35"/>
            </padding>


            <HBox alignment="CENTER_LEFT">

                <VBox spacing="4">

                    <Label
                            text="Edit Task"
                            styleClass="content-title"/>

                    <Label
                            text="Update the selected task information."
                            styleClass="content-description"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="← Back"
                        onAction="#handleBack"
                        styleClass="secondary-button"/>

            </HBox>


            <VBox
                    spacing="22"
                    styleClass="section-card">

                <Label
                        text="Task Information"
                        styleClass="section-title"/>


               <GridPane
        hgap="28"
        vgap="18">

    <Label
            text="Task Title"
            styleClass="input-label"
            GridPane.columnIndex="0"
            GridPane.rowIndex="0"/>

    <TextField
            fx:id="titleField"
            prefWidth="320"
            GridPane.columnIndex="1"
            GridPane.rowIndex="0"/>


    <Label
            text="Category"
            styleClass="input-label"
            GridPane.columnIndex="2"
            GridPane.rowIndex="0"/>

    <ComboBox
            fx:id="categoryComboBox"
            prefWidth="300"
            promptText="Select category"
            GridPane.columnIndex="3"
            GridPane.rowIndex="0"/>


    <Label
            text="Priority"
            styleClass="input-label"
            GridPane.columnIndex="0"
            GridPane.rowIndex="1"/>

    <ComboBox
            fx:id="priorityComboBox"
            prefWidth="320"
            GridPane.columnIndex="1"
            GridPane.rowIndex="1"/>


    <Label
            text="Difficulty"
            styleClass="input-label"
            GridPane.columnIndex="2"
            GridPane.rowIndex="1"/>

    <ComboBox
            fx:id="difficultyComboBox"
            prefWidth="300"
            GridPane.columnIndex="3"
            GridPane.rowIndex="1"/>


    <Label
            text="Due Date"
            styleClass="input-label"
            GridPane.columnIndex="0"
            GridPane.rowIndex="2"/>

    <DatePicker
            fx:id="dueDatePicker"
            prefWidth="320"
            GridPane.columnIndex="1"
            GridPane.rowIndex="2"/>

</GridPane>


                <VBox spacing="7">

                    <Label
                            text="Description"
                            styleClass="input-label"/>

                    <TextArea
                            fx:id="descriptionArea"
                            prefRowCount="4"
                            wrapText="true"/>

                </VBox>


                <VBox spacing="7">

                    <Label
                            text="Completion Criteria"
                            styleClass="input-label"/>

                    <TextArea
                            fx:id="completionCriteriaArea"
                            prefRowCount="3"
                            wrapText="true"/>

                </VBox>


                <Label
                        fx:id="messageLabel"
                        visible="false"
                        managed="false"
                        wrapText="true"/>


                <HBox
                        alignment="CENTER_RIGHT"
                        spacing="12">

                    <Button
                            text="Cancel"
                            onAction="#handleBack"
                            styleClass="secondary-button"/>

                    <Button
                            fx:id="saveButton"
                            text="Save Changes"
                            onAction="#handleSave"
                            styleClass="button-primary"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>