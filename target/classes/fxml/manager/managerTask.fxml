<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.manager.ManagerTaskController"
        styleClass="main-layout">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>

                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>

            </padding>


            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Manager"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Manager"
                        styleClass="topbar-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="MANAGER"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <VBox
                prefWidth="240"
                spacing="10"
                styleClass="sidebar">

            <padding>

                <Insets
                        top="30"
                        right="18"
                        bottom="20"
                        left="18"/>

            </padding>


            <VBox spacing="3">

                <Label
                        text="AEPM"
                        styleClass="sidebar-logo"/>

                <Label
                        text="Manager Portal"
                        styleClass="sidebar-subtitle"/>

            </VBox>


            <Region prefHeight="18"/>


            <Label
                    text="MENU"
                    styleClass="sidebar-section-title"/>


            <Button
                    text="⌂   Home"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleHome"
                    styleClass="sidebar-button"/>


            <Button
                    text="●   My Profile"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleProfile"
                    styleClass="sidebar-button"/>


            <Button
                    text="✓   Task Management"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleTaskManagement"
                    styleClass="sidebar-button-active"/>

            <Button
                    text="◷   Deadline Escalation"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleDeadlineEscalation"
                    styleClass="sidebar-button"/>

            <Button
                    text="★   Performance"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handlePerformance"
                    styleClass="sidebar-button"/>


            <Button
                    text="≡   Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleReports"
                    styleClass="sidebar-button"/>


            <Button
                    text="▣   Dashboard"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleDashboard"
                    styleClass="sidebar-button"/>


            <Region VBox.vgrow="ALWAYS"/>


            <Button
                    text="↪   Logout"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <!-- =====================================================
         CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="content-scroll-pane">

            <content>

                <VBox
                        spacing="22"
                        styleClass="home-content">

                    <padding>

                        <Insets
                                top="32"
                                right="35"
                                bottom="40"
                                left="35"/>

                    </padding>


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="4">

                            <Label
                                    text="Task Management"
                                    styleClass="content-title"/>

                            <Label
                                    text="Create, assign and monitor employee tasks."
                                    styleClass="content-description"/>

                        </VBox>


                        <Region HBox.hgrow="ALWAYS"/>


                        <HBox spacing="10">

                            <Button
                                    text="Refresh"
                                    onAction="#handleRefresh"
                                    styleClass="app-button"/>


                            <Button
                                    text="+ Create Task"
                                    onAction="#handleCreateTask"
                                    styleClass="app-button"/>

                        </HBox>

                    </HBox>


                    <!-- =================================================
                         ALL TASKS
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">

                        <Label
                                text="All Tasks"
                                styleClass="section-title"/>


                        <!-- =============================================
                             SEARCH
                             ============================================= -->

                        <HBox
                                spacing="12"
                                alignment="CENTER_LEFT">

                            <TextField
                                    fx:id="searchField"
                                    promptText="Search task name..."
                                    prefWidth="280"/>


                            <DatePicker
                                    fx:id="dueDateFilterPicker"
                                    promptText="Due date"
                                    prefWidth="175"/>


                            <Button
                                    text="Clear Filters"
                                    onAction="#handleClearFilters"
                                    styleClass="app-button"/>

                        </HBox>


                        <!-- =============================================
                             FILTERS
                             ============================================= -->

                        <HBox
                                spacing="12"
                                alignment="CENTER_LEFT">

                            <ComboBox
                                    fx:id="employeeFilterComboBox"
                                    promptText="All Employees"
                                    prefWidth="220"/>


                            <ComboBox
                                    fx:id="categoryFilterComboBox"
                                    promptText="All Categories"
                                    prefWidth="180"/>


                            <ComboBox
                                    fx:id="statusFilterComboBox"
                                    promptText="All Status"
                                    prefWidth="170"/>

                        </HBox>


                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="content-description"/>


                        <!-- =============================================
                             TASK TABLE
                             ============================================= -->

                        <TableView
                                fx:id="taskTable"
                                prefHeight="350"
                                minHeight="300">

                            <columns>

                                <TableColumn
                                        fx:id="titleColumn"
                                        text="Task"
                                        prefWidth="150"/>


                                <TableColumn
                                        fx:id="categoryColumn"
                                        text="Category"
                                        prefWidth="115"/>


                                <TableColumn
                                        fx:id="employeeColumn"
                                        text="Employee"
                                        prefWidth="155"/>


                                <TableColumn
                                        fx:id="priorityColumn"
                                        text="Priority"
                                        prefWidth="80"/>


                                <TableColumn
                                        fx:id="difficultyColumn"
                                        text="Difficulty"
                                        prefWidth="90"/>


                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="105"/>


                                <TableColumn
                                        fx:id="progressColumn"
                                        text="Progress"
                                        prefWidth="80"/>


                                <TableColumn
                                        fx:id="dueDateColumn"
                                        text="Due Date"
                                        prefWidth="145"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- =================================================
                         SELECTED TASK
                         ================================================= -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                    text="Selected Task"
                                    styleClass="section-title"/>


                            <Region HBox.hgrow="ALWAYS"/>


                            <HBox spacing="10">

                                <Button
                                        text="Edit Task"
                                        onAction="#handleEditTask"
                                        styleClass="app-button"/>


                                <Button
                                        text="Cancel Task"
                                        onAction="#handleCancelTask"
                                        styleClass="app-button"/>

                            </HBox>

                        </HBox>


                        <GridPane
                                hgap="30"
                                vgap="14">

                            <!-- ROW 1 -->

                            <Label
                                    text="Task"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    fx:id="selectedTaskLabel"
                                    text="No task selected"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Category"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    fx:id="selectedCategoryLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <!-- ROW 2 -->

                            <Label
                                    text="Employee"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    fx:id="selectedEmployeeLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Status"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    fx:id="selectedStatusLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <!-- ROW 3 -->

                            <Label
                                    text="Progress"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    fx:id="selectedProgressLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>

                        </GridPane>

                    </VBox>


                    <!-- =================================================
                         PROGRESS HISTORY
                         ================================================= -->

                    <VBox
                            spacing="14"
                            styleClass="section-card">

                        <Label
                                text="Progress History"
                                styleClass="section-title"/>


                        <Label
                                fx:id="historyMessageLabel"
                                text="Select a task to view progress history."
                                styleClass="content-description"/>


                        <TableView
                                fx:id="historyTable"
                                prefHeight="220"
                                minHeight="180">

                            <columns>

                                <TableColumn
                                        fx:id="historyProgressColumn"
                                        text="Progress"
                                        prefWidth="100"/>


                                <TableColumn
                                        fx:id="historyNoteColumn"
                                        text="Progress Note"
                                        prefWidth="500"/>


                                <TableColumn
                                        fx:id="historyDateColumn"
                                        text="Updated At"
                                        prefWidth="190"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <Region prefHeight="15"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>