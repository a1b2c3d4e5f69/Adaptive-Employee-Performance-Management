<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.employee.EmployeeTaskController"
        styleClass="main-layout">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Employee"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Employee"
                        styleClass="topbar-user-name"/>

                <Label
                        text="EMPLOYEE"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <VBox
                prefWidth="240"
                spacing="10"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="30"
                        right="18"
                        bottom="20"
                        left="18"/>
            </padding>

            <VBox spacing="3">

                <Label
                        text="AEPM"
                        styleClass="sidebar-logo"/>

                <Label
                        text="Employee Portal"
                        styleClass="sidebar-subtitle"/>

            </VBox>

            <Region prefHeight="18"/>

            <Label
                    text="MENU"
                    styleClass="sidebar-section-title"/>

            <Button
                    text="⌂   Home"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleHome"
                    styleClass="sidebar-button"/>

            <Button
                    text="●   My Profile"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleProfile"
                    styleClass="sidebar-button"/>

            <Button
                    text="✓   My Tasks"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleTasks"
                    styleClass="sidebar-button-active"/>

            <Button
                    text="★   Performance KPI"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleKpi"
                    styleClass="sidebar-button"/>

            <Button
                    text="≡   Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleReports"
                    styleClass="sidebar-button"/>

            <Button
                    text="!   Anonymous Report"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleAnonymousReport"
                    styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button
                    text="↪   Logout"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <!-- =====================================================
         SCROLLABLE CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="content-scroll-pane">


            <content>

                <VBox
                        spacing="22"
                        styleClass="home-content">

                    <padding>
                        <Insets
                                top="32"
                                right="35"
                                bottom="40"
                                left="35"/>
                    </padding>


                    <!-- =========================================
                         PAGE HEADER
                         ========================================= -->

                    <HBox alignment="CENTER_LEFT">

                        <VBox spacing="4">

                            <Label
                                    text="My Tasks"
                                    styleClass="content-title"/>

                            <Label
                                    text="View and update tasks assigned to you."
                                    styleClass="content-description"/>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button
                                text="Refresh"
                                onAction="#handleRefresh"
                                styleClass="secondary-button"/>

                    </HBox>


                    <!-- =========================================
                         ASSIGNED TASKS
                         ========================================= -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">


                        <Label
                                text="Assigned Tasks"
                                styleClass="section-title"/>


                        <!-- SEARCH & FILTER -->

                        <HBox
                                spacing="12"
                                alignment="CENTER_LEFT">


                            <TextField
                                    fx:id="searchField"
                                    promptText="Search by task name..."
                                    prefWidth="300"/>


                            <DatePicker
                                    fx:id="dueDateFilterPicker"
                                    promptText="Filter by due date"
                                    prefWidth="190"/>


                            <Button
                                    text="Clear"
                                    onAction="#handleClearFilter"
                                    styleClass="secondary-button"/>


                            <Region HBox.hgrow="ALWAYS"/>

                        </HBox>


                        <Label
                                fx:id="messageLabel"
                                visible="false"
                                managed="false"
                                wrapText="true"
                                styleClass="content-description"/>


                        <!-- BIGGER TABLE -->

                        <TableView
                                fx:id="taskTable"
                                prefHeight="340"
                                minHeight="300">

                            <columns>

                                <TableColumn
                                        fx:id="titleColumn"
                                        text="Task"
                                        prefWidth="175"/>

                                <TableColumn
                                        fx:id="categoryColumn"
                                        text="Category"
                                        prefWidth="110"/>

                                <TableColumn
                                        fx:id="priorityColumn"
                                        text="Priority"
                                        prefWidth="85"/>

                                <TableColumn
                                        fx:id="difficultyColumn"
                                        text="Difficulty"
                                        prefWidth="95"/>

                                <TableColumn
                                        fx:id="statusColumn"
                                        text="Status"
                                        prefWidth="110"/>

                                <TableColumn
                                        fx:id="progressColumn"
                                        text="Progress"
                                        prefWidth="85"/>

                                <TableColumn
                                        fx:id="dueDateColumn"
                                        text="Due Date"
                                        prefWidth="155"/>

                            </columns>

                        </TableView>

                    </VBox>


                    <!-- =========================================
                         TASK DETAILS
                         ========================================= -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">

                        <Label
                                text="Task Details"
                                styleClass="section-title"/>


                        <GridPane
                                hgap="28"
                                vgap="14">

                            <Label
                                    text="Task"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="selectedTaskLabel"
                                    text="No task selected"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Category"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="0"/>

                            <Label
                                    fx:id="selectedCategoryLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="0"/>


                            <Label
                                    text="Priority"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="selectedPriorityLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Difficulty"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="1"/>

                            <Label
                                    fx:id="selectedDifficultyLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="1"/>


                            <Label
                                    text="Status"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="selectedStatusLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Progress"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="2"/>

                            <Label
                                    fx:id="selectedProgressLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>


                            <Label
                                    text="Assigned Date"
                                    styleClass="input-label"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"/>

                            <Label
                                    fx:id="selectedAssignedDateLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>


                            <Label
                                    text="Due Date"
                                    styleClass="input-label"
                                    GridPane.columnIndex="2"
                                    GridPane.rowIndex="3"/>

                            <Label
                                    fx:id="selectedDueDateLabel"
                                    text="-"
                                    styleClass="task-detail-value"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="3"/>

                        </GridPane>


                        <VBox spacing="6">

                            <Label
                                    text="Description"
                                    styleClass="input-label"/>

                            <Label
                                    fx:id="selectedDescriptionLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="content-description"/>

                        </VBox>


                        <VBox spacing="6">

                            <Label
                                    text="Completion Criteria"
                                    styleClass="input-label"/>

                            <Label
                                    fx:id="selectedCriteriaLabel"
                                    text="-"
                                    wrapText="true"
                                    styleClass="content-description"/>

                        </VBox>

                    </VBox>


                    <!-- =========================================
                         UPDATE PROGRESS
                         ========================================= -->

                    <VBox
                            spacing="16"
                            styleClass="section-card">

                        <Label
                                text="Update Progress"
                                styleClass="section-title"/>


                        <HBox
                                spacing="20"
                                alignment="CENTER_LEFT">

                            <Label
                                    text="New Progress (%)"
                                    styleClass="input-label"/>

                            <TextField
                                    fx:id="progressField"
                                    promptText="0 - 100"
                                    prefWidth="160"/>

                        </HBox>


                        <VBox spacing="7">

                            <Label
                                    text="Progress Note"
                                    styleClass="input-label"/>

                            <TextArea
                                    fx:id="progressNoteArea"
                                    promptText="Describe what you have completed or updated..."
                                    prefRowCount="3"
                                    wrapText="true"/>

                        </VBox>


                        <HBox spacing="10">

                            <Button
                                    fx:id="acceptButton"
                                    text="Accept Task"
                                    onAction="#handleAcceptTask"
                                    styleClass="quick-button task-action-button"/>

                            <Button
                                    fx:id="startButton"
                                    text="Start Task"
                                    onAction="#handleStartTask"
                                    styleClass="quick-button task-action-button"/>

                            <Button
                                    fx:id="updateProgressButton"
                                    text="Update Progress"
                                    onAction="#handleUpdateProgress"
                                    styleClass="button-primary task-action-button"/>

                            <Button
                                    fx:id="completeButton"
                                    text="Complete Task"
                                    onAction="#handleCompleteTask"
                                    styleClass="button-primary task-action-button"/>

                        </HBox>

                    </VBox>


                    <Region prefHeight="15"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>