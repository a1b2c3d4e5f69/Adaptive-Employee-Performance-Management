<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.employee.EmployeeTaskController"
        styleClass="main-layout">


    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="topbar">

            <padding>
                <Insets
                        top="16"
                        right="28"
                        bottom="16"
                        left="28"/>
            </padding>

            <VBox spacing="2">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome, Employee"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="topNameLabel"
                        text="Employee"
                        styleClass="topbar-user-name"/>

                <Label
                        text="EMPLOYEE"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <left>

        <VBox
                prefWidth="240"
                spacing="10"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="30"
                        right="18"
                        bottom="20"
                        left="18"/>
            </padding>

            <VBox spacing="3">

                <Label
                        text="AEPM"
                        styleClass="sidebar-logo"/>

                <Label
                        text="Employee Portal"
                        styleClass="sidebar-subtitle"/>

            </VBox>

            <Region prefHeight="18"/>

            <Label
                    text="MENU"
                    styleClass="sidebar-section-title"/>

            <Button
                    text="⌂   Home"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleHome"
                    styleClass="sidebar-button"/>

            <Button
                    text="●   My Profile"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleProfile"
                    styleClass="sidebar-button"/>

            <Button
                    text="✓   My Tasks"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleTasks"
                    styleClass="sidebar-button-active"/>

            <Button
                    text="★   Performance KPI"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleKpi"
                    styleClass="sidebar-button"/>

            <Button
                    text="≡   Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleReports"
                    styleClass="sidebar-button"/>

            <Button
                    text="!   Anonymous Report"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleAnonymousReport"
                    styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button
                    text="↪   Logout"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <center>

        <VBox
                spacing="22"
                styleClass="home-content">

            <padding>
                <Insets
                        top="32"
                        right="35"
                        bottom="35"
                        left="35"/>
            </padding>


            <!-- HEADER -->

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="4">

                    <Label
                            text="My Tasks"
                            styleClass="content-title"/>

                    <Label
                            text="View and update tasks assigned to you."
                            styleClass="content-description"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="Refresh"
                        onAction="#handleRefresh"
                        styleClass="secondary-button"/>

            </HBox>


            <!-- ASSIGNED TASKS -->

            <VBox
                    spacing="15"
                    styleClass="section-card">

                <Label
                        text="Assigned Tasks"
                        styleClass="section-title"/>

                <Label
                        fx:id="messageLabel"
                        visible="false"
                        managed="false"
                        wrapText="true"
                        styleClass="content-description"/>

                <TableView
                        fx:id="taskTable"
                        prefHeight="270">

                    <columns>

                        <TableColumn
                                fx:id="titleColumn"
                                text="Task"
                                prefWidth="190"/>

                        <TableColumn
                                fx:id="categoryColumn"
                                text="Category"
                                prefWidth="120"/>

                        <TableColumn
                                fx:id="priorityColumn"
                                text="Priority"
                                prefWidth="90"/>

                        <TableColumn
                                fx:id="difficultyColumn"
                                text="Difficulty"
                                prefWidth="100"/>

                        <TableColumn
                                fx:id="statusColumn"
                                text="Status"
                                prefWidth="120"/>

                        <TableColumn
                                fx:id="progressColumn"
                                text="Progress"
                                prefWidth="90"/>

                        <TableColumn
                                fx:id="dueDateColumn"
                                text="Due Date"
                                prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>


            <!-- SELECTED TASK -->

            <VBox
                    spacing="16"
                    styleClass="section-card">

                <Label
                        text="Selected Task"
                        styleClass="section-title"/>


                <GridPane
                        hgap="25"
                        vgap="14">

                    <Label
                            text="Task"
                            styleClass="input-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <Label
                            fx:id="selectedTaskLabel"
                            text="No task selected"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>


                    <Label
                            text="Category"
                            styleClass="input-label"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0"/>

                    <Label
                            fx:id="selectedCategoryLabel"
                            text="-"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0"/>


                    <Label
                            text="Status"
                            styleClass="input-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <Label
                            fx:id="selectedStatusLabel"
                            text="-"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>


                    <Label
                            text="Current Progress"
                            styleClass="input-label"
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="1"/>

                    <Label
                            fx:id="selectedProgressLabel"
                            text="-"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"/>


                    <Label
                            text="New Progress (%)"
                            styleClass="input-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                    <TextField
                            fx:id="progressField"
                            promptText="0 - 100"
                            prefWidth="160"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>

                </GridPane>


                <VBox spacing="7">

                    <Label
                            text="Progress Note"
                            styleClass="input-label"/>

                    <TextArea
                            fx:id="progressNoteArea"
                            promptText="Describe what you have completed or updated..."
                            prefRowCount="2"
                            wrapText="true"/>

                </VBox>


                <HBox spacing="10">

                    <Button
                            fx:id="acceptButton"
                            text="Accept Task"
                            onAction="#handleAcceptTask"
                            styleClass="quick-button"/>

                    <Button
                            fx:id="startButton"
                            text="Start Task"
                            onAction="#handleStartTask"
                            styleClass="quick-button"/>

                    <Button
                            fx:id="updateProgressButton"
                            text="Update Progress"
                            onAction="#handleUpdateProgress"
                            styleClass="button-primary"/>

                    <Button
                            fx:id="completeButton"
                            text="Complete Task"
                            onAction="#handleCompleteTask"
                            styleClass="button-primary"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>