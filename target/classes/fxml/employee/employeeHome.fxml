<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import com.aepm.ui.components.NotificationBell?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.employee.EmployeeHomeController"
        styleClass="main-layout">


    <!-- =====================================================
         TOP BAR
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="16"
                styleClass="modern-topbar">

            <padding>

                <Insets
                        top="14"
                        right="30"
                        bottom="14"
                        left="30"/>

            </padding>


            <Label
                    text="AEPM"
                    styleClass="modern-brand"/>


            <Region
                    prefWidth="1"
                    minWidth="1"
                    maxWidth="1"
                    prefHeight="28"
                    styleClass="topbar-divider"/>


            <Label
                    text="Adaptive Employee Performance Management System"
                    styleClass="modern-system-name"/>


            <Region HBox.hgrow="ALWAYS"/>
            <NotificationBell fx:id="notificationBell"/>


            <VBox
                    spacing="2"
                    alignment="CENTER_RIGHT">

                <Label
                        fx:id="topNameLabel"
                        text="Employee"
                        styleClass="modern-user-name"/>

                <Label
                        fx:id="topRoleLabel"
                        text="EMPLOYEE"
                        styleClass="modern-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <VBox
                prefWidth="245"
                minWidth="245"
                maxWidth="245"
                spacing="8"
                styleClass="modern-sidebar">

            <padding>

                <Insets
                        top="28"
                        right="18"
                        bottom="20"
                        left="18"/>

            </padding>


            <Label
                    text="MENU"
                    styleClass="modern-sidebar-section"/>


            <Button
                    text="⌂   Home"
                    alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#handleHome"
                    styleClass="modern-nav-button-active"/>


            <Button
                    text="○   My Profile"
                    alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#handleProfile"
                    styleClass="modern-nav-button"/>


            <Button
                    text="✓   My Tasks"
                    alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#handleTasks"
                    styleClass="modern-nav-button"/>


            <Button
                    text="▥   Performance"
                    alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#handleKpi"
                    styleClass="modern-nav-button"/>

            <Button
                    text="▦   My Attendance"
                    alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#handleAttendance"
                    styleClass="modern-nav-button"/>

            <Button
                    text="▤   Reports"
                    alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#handleReports"
                    styleClass="modern-nav-button"/>


            <Button
                    text="!   Anonymous Report"
                    alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#handleAnonymousReport"
                    styleClass="modern-nav-button"/>


            <Region VBox.vgrow="ALWAYS"/>


            <Button
                    text="↪   Logout"
                    alignment="CENTER_LEFT"
                    maxWidth="Infinity"
                    onAction="#handleLogout"
                    styleClass="modern-logout-button"/>

        </VBox>

    </left>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                pannable="true"
                styleClass="modern-content-scroll">

            <content>

                <VBox
                        spacing="24"
                        maxWidth="Infinity"
                        styleClass="modern-content">

                    <padding>

                        <Insets
                                top="30"
                                right="32"
                                bottom="40"
                                left="32"/>

                    </padding>


                    <!-- =================================================
                         PAGE HEADER
                         ================================================= -->

                    <VBox spacing="5">

                        <Label
                                text="Employee Home"
                                styleClass="modern-page-title"/>

                        <Label
                                text="Access your assigned tasks, performance results, and employee services."
                                wrapText="true"
                                styleClass="modern-page-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         WELCOME CARD
                         ================================================= -->

                    <HBox
                            spacing="30"
                            alignment="CENTER_LEFT"
                            maxWidth="Infinity"
                            styleClass="employee-welcome-card">

                        <padding>

                            <Insets
                                    top="26"
                                    right="30"
                                    bottom="26"
                                    left="30"/>

                        </padding>


                        <VBox
                                spacing="8"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="Welcome back,"
                                    styleClass="employee-welcome-small"/>


                            <Label
                                    fx:id="welcomeNameLabel"
                                    text="Employee"
                                    styleClass="employee-welcome-name"/>


                            <Label
                                    text="Stay on top of your assigned work and monitor your performance progress."
                                    wrapText="true"
                                    styleClass="employee-welcome-description"/>


                            <HBox
                                    spacing="12"
                                    alignment="CENTER_LEFT">

                                <Button
                                        text="View My Tasks  →"
                                        onAction="#handleTasks"
                                        styleClass="modern-primary-button"/>


                                <Button
                                        text="View Performance"
                                        onAction="#handleKpi"
                                        styleClass="modern-secondary-button"/>

                            </HBox>

                        </VBox>


                        <VBox
                                spacing="12"
                                prefWidth="260"
                                styleClass="employee-info-panel">

                            <HBox
                                    spacing="18"
                                    alignment="CENTER_LEFT">

                                <VBox
                                        spacing="4"
                                        HBox.hgrow="ALWAYS">

                                    <Label
                                            text="Employee ID"
                                            styleClass="modern-card-label"/>

                                    <Label
                                            fx:id="employeeIdLabel"
                                            text="-"
                                            styleClass="employee-info-value"/>

                                </VBox>


                                <VBox
                                        spacing="4"
                                        HBox.hgrow="ALWAYS">

                                    <Label
                                            text="Department"
                                            styleClass="modern-card-label"/>

                                    <Label
                                            fx:id="departmentLabel"
                                            text="-"
                                            styleClass="employee-info-value"/>

                                </VBox>

                            </HBox>

                        </VBox>

                    </HBox>


                    <!-- =================================================
                         PRIMARY MODULES
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity">

                        <VBox spacing="4">

                            <Label
                                    text="Your Workspace"
                                    styleClass="modern-section-title"/>

                            <Label
                                    text="Continue with the areas you use most."
                                    styleClass="modern-page-subtitle"/>

                        </VBox>


                        <HBox
                                spacing="18"
                                maxWidth="Infinity">


                            <!-- TASKS -->

                            <VBox
                                    spacing="12"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="home-feature-card">

                                <Label
                                        text="✓"
                                        styleClass="home-feature-icon"/>


                                <Label
                                        text="My Tasks"
                                        styleClass="home-feature-title"/>


                                <Label
                                        text="View assigned tasks, accept work, update progress, and complete tasks."
                                        wrapText="true"
                                        maxWidth="Infinity"
                                        styleClass="home-feature-description"/>


                                <Region VBox.vgrow="ALWAYS"/>


                                <Button
                                        text="Open My Tasks  →"
                                        onAction="#handleTasks"
                                        styleClass="home-link-button"/>

                            </VBox>


                            <!-- PERFORMANCE -->

                            <VBox
                                    spacing="12"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="home-feature-card">

                                <Label
                                        text="▥"
                                        styleClass="home-feature-icon"/>


                                <Label
                                        text="Performance"
                                        styleClass="home-feature-title"/>


                                <Label
                                        text="Review your KPI score, performance breakdown, history, and feedback."
                                        wrapText="true"
                                        maxWidth="Infinity"
                                        styleClass="home-feature-description"/>


                                <Region VBox.vgrow="ALWAYS"/>


                                <Button
                                        text="View Performance  →"
                                        onAction="#handleKpi"
                                        styleClass="home-link-button"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         QUICK ACCESS
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="modern-card">

                        <padding>

                            <Insets
                                    top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>

                        </padding>


                        <VBox spacing="4">

                            <Label
                                    text="Quick Access"
                                    styleClass="modern-section-title"/>

                            <Label
                                    text="Other employee services."
                                    styleClass="modern-page-subtitle"/>

                        </VBox>


                        <HBox
                                spacing="16"
                                maxWidth="Infinity">


                            <Button
                                    text="○  My Profile"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    onAction="#handleProfile"
                                    styleClass="quick-access-button"/>


                            <Button
                                    text="▤  Reports"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    onAction="#handleReports"
                                    styleClass="quick-access-button"/>


                            <Button
                                    text="!  Anonymous Report"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    onAction="#handleAnonymousReport"
                                    styleClass="quick-access-button"/>

                        </HBox>

                    </VBox>


                    <!-- =================================================
                         WORKFLOW
                         ================================================= -->

                    <VBox
                            spacing="16"
                            maxWidth="Infinity"
                            styleClass="modern-card">

                        <padding>

                            <Insets
                                    top="22"
                                    right="22"
                                    bottom="22"
                                    left="22"/>

                        </padding>


                        <VBox spacing="4">

                            <Label
                                    text="Employee Performance Flow"
                                    styleClass="modern-section-title"/>

                            <Label
                                    text="Your normal workflow in AEPM."
                                    styleClass="modern-page-subtitle"/>

                        </VBox>


                        <HBox
                                spacing="14"
                                alignment="CENTER_LEFT"
                                maxWidth="Infinity">


                            <VBox
                                    spacing="5"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="workflow-step">

                                <Label
                                        text="1"
                                        styleClass="workflow-number"/>

                                <Label
                                        text="Manage Tasks"
                                        styleClass="workflow-title"/>

                                <Label
                                        text="Accept and complete assigned work."
                                        wrapText="true"
                                        styleClass="workflow-description"/>

                            </VBox>


                            <Label
                                    text="→"
                                    styleClass="workflow-arrow"/>


                            <VBox
                                    spacing="5"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="workflow-step">

                                <Label
                                        text="2"
                                        styleClass="workflow-number"/>

                                <Label
                                        text="KPI Calculation"
                                        styleClass="workflow-title"/>

                                <Label
                                        text="Task data contributes to your KPI result."
                                        wrapText="true"
                                        styleClass="workflow-description"/>

                            </VBox>


                            <Label
                                    text="→"
                                    styleClass="workflow-arrow"/>


                            <VBox
                                    spacing="5"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="Infinity"
                                    styleClass="workflow-step">

                                <Label
                                        text="3"
                                        styleClass="workflow-number"/>

                                <Label
                                        text="Review Performance"
                                        styleClass="workflow-title"/>

                                <Label
                                        text="View KPI history and manager feedback."
                                        wrapText="true"
                                        styleClass="workflow-description"/>

                            </VBox>

                        </HBox>

                    </VBox>


                    <Region prefHeight="10"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>