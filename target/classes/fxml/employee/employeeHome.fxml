<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.employee.EmployeeHomeController"
        styleClass="main-layout">


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <left>

        <VBox
                prefWidth="240"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="28"
                        right="18"
                        bottom="24"
                        left="18"/>
            </padding>


            <!-- AEPM Logo -->

            <VBox spacing="3">

                <Label
                        text="AEPM"
                        styleClass="sidebar-logo"/>

                <Label
                        text="Employee Portal"
                        styleClass="sidebar-subtitle"/>

            </VBox>


            <Region prefHeight="28"/>


            <!-- Navigation -->

            <Label
                    text="MENU"
                    styleClass="sidebar-section-title"/>


            <Button
                    text="⌂   Home"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleHome"
                    styleClass="sidebar-button"/>


            <Button
                    text="●   My Profile"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleProfile"
                    styleClass="sidebar-button"/>


            <Button
                    text="✓   My Tasks"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleTasks"
                    styleClass="sidebar-button"/>


            <Button
                    text="★   Performance KPI"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleKpi"
                    styleClass="sidebar-button"/>


            <Button
                    text="▤   Reports"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleReports"
                    styleClass="sidebar-button"/>


            <Button
                    text="!   Anonymous Report"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleAnonymousReport"
                    styleClass="sidebar-button"/>


            <!-- Push logout to bottom -->

            <Region VBox.vgrow="ALWAYS"/>


            <Separator/>


            <Region prefHeight="10"/>


            <Button
                    text="↪   Logout"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleLogout"
                    styleClass="logout-button"/>

        </VBox>

    </left>


    <!-- =====================================================
         TOP HEADER
         ===================================================== -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                prefHeight="75"
                spacing="15"
                styleClass="topbar">

            <padding>
                <Insets
                        top="15"
                        right="30"
                        bottom="15"
                        left="30"/>
            </padding>


            <VBox spacing="3">

                <Label
                        fx:id="welcomeLabel"
                        text="Welcome"
                        styleClass="topbar-title"/>

                <Label
                        text="Adaptive Employee Performance Management System"
                        styleClass="topbar-subtitle"/>

            </VBox>


            <Region HBox.hgrow="ALWAYS"/>


            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="2">

                <Label
                        fx:id="nameLabel"
                        text="-"
                        styleClass="topbar-user-name"/>

                <Label
                        fx:id="roleLabel"
                        text="-"
                        styleClass="topbar-user-role"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <center>

        <VBox
                spacing="24"
                styleClass="home-content">

            <padding>
                <Insets
                        top="32"
                        right="35"
                        bottom="35"
                        left="35"/>
            </padding>


            <!-- Page Heading -->

            <VBox spacing="5">

                <Label
                        fx:id="contentTitleLabel"
                        text="Home"
                        styleClass="content-title"/>

                <Label
                        fx:id="contentMessageLabel"
                        text="Welcome to the Adaptive Employee Performance Management System."
                        styleClass="content-description"/>

            </VBox>


            <!-- User Information Cards -->

            <HBox spacing="18">


                <!-- Name Card -->

                <VBox
                        spacing="8"
                        HBox.hgrow="ALWAYS"
                        styleClass="info-card">

                    <Label
                            text="Employee"
                            styleClass="card-label"/>

                    <Label
                            text="Your Account"
                            styleClass="card-title"/>

                    <Label
                            text="View and manage your employee information."
                            wrapText="true"
                            styleClass="card-description"/>

                </VBox>


                <!-- Department -->

                <VBox
                        spacing="8"
                        HBox.hgrow="ALWAYS"
                        styleClass="info-card">

                    <Label
                            text="Department"
                            styleClass="card-label"/>

                    <Label
                            fx:id="departmentLabel"
                            text="-"
                            styleClass="card-value"/>

                    <Label
                            text="Your assigned department."
                            styleClass="card-description"/>

                </VBox>


                <!-- Role -->

                <VBox
                        spacing="8"
                        HBox.hgrow="ALWAYS"
                        styleClass="info-card">

                    <Label
                            text="Role"
                            styleClass="card-label"/>

                    <Label
                            text="Employee"
                            styleClass="card-value"/>

                    <Label
                            text="Standard employee access."
                            styleClass="card-description"/>

                </VBox>

            </HBox>


            <!-- Quick Access -->

            <VBox
                    spacing="14"
                    styleClass="section-card">

                <Label
                        text="Quick Access"
                        styleClass="section-title"/>


                <HBox spacing="12">

                    <Button
                            text="My Profile"
                            onAction="#handleProfile"
                            styleClass="quick-button"/>

                    <Button
                            text="My Tasks"
                            onAction="#handleTasks"
                            styleClass="quick-button"/>

                    <Button
                            text="View KPI"
                            onAction="#handleKpi"
                            styleClass="quick-button"/>

                    <Button
                            text="Reports"
                            onAction="#handleReports"
                            styleClass="quick-button"/>

                </HBox>

            </VBox>


            <!-- Dashboard Placeholder -->

            <VBox
                    spacing="8"
                    styleClass="dashboard-placeholder">

                <Label
                        text="Dashboard"
                        styleClass="section-title"/>

                <Label
                        text="Dashboard information will be integrated here later."
                        styleClass="content-description"/>

            </VBox>

        </VBox>

    </center>

</BorderPane>