<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<VBox
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.aepm.ui.employee.EmployeeProfileController"
        spacing="24"
        styleClass="profile-page">

    <padding>
        <Insets
                top="30"
                right="40"
                bottom="40"
                left="40"/>
    </padding>


    <!-- HEADER -->

    <HBox
            alignment="CENTER_LEFT"
            spacing="15">

        <VBox spacing="5">

            <Label
                    text="My Profile"
                    styleClass="content-title"/>

            <Label
                    text="View and manage your personal information."
                    styleClass="content-description"/>

        </VBox>


        <Region HBox.hgrow="ALWAYS"/>


        <Button
                text="Back"
                onAction="#handleBack"
                styleClass="secondary-button"/>

    </HBox>


    <!-- PROFILE CARD -->

    <VBox
            spacing="20"
            styleClass="profile-card">


        <Label
                text="Personal Information"
                styleClass="section-title"/>


        <Separator/>


        <GridPane
                hgap="30"
                vgap="18">


            <!-- FULL NAME -->

            <Label
                    text="Full Name"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"
                    styleClass="profile-field-label"/>

            <Label
                    fx:id="fullNameLabel"
                    text="-"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0"
                    styleClass="profile-field-value"/>


            <!-- EMPLOYEE ID -->

            <Label
                    text="Employee ID"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"
                    styleClass="profile-field-label"/>

            <Label
                    fx:id="employeeIdLabel"
                    text="-"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1"
                    styleClass="profile-field-value"/>


            <!-- USERNAME -->

            <Label
                    text="Username"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="2"
                    styleClass="profile-field-label"/>

            <Label
                    fx:id="usernameLabel"
                    text="-"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="2"
                    styleClass="profile-field-value"/>


            <!-- EMAIL -->

            <Label
                    text="Email"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="3"
                    styleClass="profile-field-label"/>

            <Label
                    fx:id="emailLabel"
                    text="-"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="3"
                    styleClass="profile-field-value"/>


            <!-- CONTACT NUMBER -->

            <Label
                    text="Contact Number"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="4"
                    styleClass="profile-field-label"/>

            <TextField
                    fx:id="contactNumberField"
                    promptText="Enter contact number"
                    prefWidth="260"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="4"/>


            <!-- DEPARTMENT -->

            <Label
                    text="Department"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="5"
                    styleClass="profile-field-label"/>

            <Label
                    fx:id="departmentLabel"
                    text="-"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="5"
                    styleClass="profile-field-value"/>


            <!-- ROLE -->

            <Label
                    text="Role"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="6"
                    styleClass="profile-field-label"/>

            <Label
                    fx:id="roleLabel"
                    text="-"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="6"
                    styleClass="profile-field-value"/>


            <!-- STATUS -->

            <Label
                    text="Account Status"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="7"
                    styleClass="profile-field-label"/>

            <Label
                    fx:id="accountStatusLabel"
                    text="-"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="7"
                    styleClass="profile-field-value"/>

        </GridPane>


        <Label
                fx:id="messageLabel"
                visible="false"
                managed="false"
                wrapText="true"/>


        <HBox spacing="12">

            <Button
                    fx:id="saveButton"
                    text="Save Changes"
                    onAction="#handleSave"
                    styleClass="button-primary"/>

            <Button
                    text="Change Password"
                    onAction="#handleChangePassword"
                    styleClass="secondary-button"/>

        </HBox>

    </VBox>

</VBox>